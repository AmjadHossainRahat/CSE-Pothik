---
interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
---

<span class="brand-lockup">
  <svg
    class="brand-mark"
    viewBox="0 0 40 40"
    aria-hidden="true"
    focusable="false"
  >
    <path
      d="M29.5 6.8a16.25 16.25 0 1 0 6.3 18"
      fill="none"
      stroke="currentColor"
      stroke-width="3.5"
      stroke-linecap="round"></path>
    <path d="m34 6-9.5 20-4.2-6.3L14 15.5Z" fill="currentColor"></path>
    <path
      d="m19.7 20.3-6.2 6.2"
      stroke="currentColor"
      stroke-width="2.5"
      stroke-linecap="round"></path>
  </svg>
  <span class:list={["brand-name", { "visually-compact": compact }]}
    ><strong>CSE</strong> Compass</span
  >
</span>

<style>
  .brand-lockup {
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    color: var(--color-text);
  }
  .brand-mark {
    width: 2rem;
    height: 2rem;
    flex: none;
    color: var(--color-primary);
  }
  .brand-name {
    font-size: 1.05rem;
    font-weight: 550;
    letter-spacing: -0.035em;
    white-space: nowrap;
  }
  .brand-name strong {
    font-weight: 800;
  }
  @media (max-width: 23rem) {
    .visually-compact {
      position: absolute;
      width: 1px;
      height: 1px;
      overflow: hidden;
      clip: rect(0 0 0 0);
    }
  }
</style>
