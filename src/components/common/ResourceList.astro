---
import { resourceById } from "@/data/resources";
import { t } from "@/lib/i18n";
import type { Locale } from "@/types/content";

interface Props {
  locale: Locale;
  resourceIds: string[];
  compact?: boolean;
  alternatives?: boolean;
  directory?: boolean;
}
const {
  locale,
  resourceIds,
  compact = false,
  alternatives = false,
  directory = false,
} = Astro.props;
const list = resourceIds
  .map((id) => resourceById.get(id))
  .filter((item) => item !== undefined);
---

<div class="resource-list">
  {
    alternatives && (
      <p class="muted">
        {locale === "en"
          ? "Platform alternatives: use the reference for your chosen stack. These are not consecutive learning levels; you do not need all of them."
          : "Platform-এর বিকল্প: বাছা stack-এর reference ব্যবহার করো। এগুলো পরপর শেখার level নয়; সবগুলো দরকার নেই।"}
      </p>
    )
  }
  {
    list.map((resource, index) => (
      <article class="resource" id={`resource-${resource.id}`}>
        <div class="resource__meta">
          <span class="tag">
            {directory
              ? resource.type
              : alternatives
                ? locale === "en"
                  ? "Platform option"
                  : "Platform-এর বিকল্প"
                : index === 0
                  ? locale === "en"
                    ? "Learn"
                    : "শেখো"
                  : index === 1
                    ? locale === "en"
                      ? "Practice"
                      : "Practice"
                    : locale === "en"
                      ? "Go deeper · optional"
                      : "আরও গভীরে · optional"}
          </span>
          <span>{resource.provider}</span>
          <span>·</span>
          {!directory && <span>{resource.type}</span>}
          {!directory && <span>·</span>}
          <span>{locale === "en" ? "Free" : "বিনামূল্যে"}</span>
        </div>
        <h3>
          <a
            href={resource.url}
            target="_blank"
            rel="noopener noreferrer"
            aria-describedby="external-link-description"
            data-track-event="learning_resource_clicked"
            data-track-param-resource-id={resource.id}
            data-track-param-provider={resource.provider}
          >
            {resource.title} <span aria-hidden="true">↗</span>
          </a>
        </h3>
        {!compact && <p>{t(resource.whyRecommended, locale)}</p>}
        <p class="muted">
          <strong>{locale === "en" ? "Do this much:" : "এতটুকু করো:"}</strong>{" "}
          {t(resource.recommendedScope, locale)}
        </p>
        {!compact && (
          <p class="reviewed">
            {locale === "en" ? "Last reviewed" : "শেষবার যাচাই"}:{" "}
            <time datetime={resource.lastReviewed}>
              {resource.lastReviewed}
            </time>
          </p>
        )}
      </article>
    ))
  }
</div>

<style>
  h3 {
    margin-bottom: 0.35rem;
    font-size: 1.12rem;
    letter-spacing: -0.015em;
  }
  p {
    margin-bottom: 0.35rem;
  }
  .reviewed {
    color: var(--color-text-muted);
    font-size: 0.78rem;
  }
</style>
