---
import Logo from "@/components/common/Logo.astro";
import { localePath, siteConfig, withBase } from "@/config/site";
import { collaborators, inspirations } from "@/data/credits";
import type { Locale } from "@/types/content";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const bn = locale === "bn";
---

<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-intro">
      <Logo />
      <p>
        {
          bn
            ? "CSE-তে কোন দিকে এগোবে—সেটা বুঝতে practical mentor."
            : siteConfig.description
        }
      </p>
      <p class="muted">
        {
          bn
            ? "Free educational resource. কোনো account, progress tracker বা career promise নেই।"
            : "A free educational resource. No accounts, progress tracking or career promises."
        }
      </p>
    </div>
    <nav aria-label={bn ? "প্রজেক্ট ও নীতিমালা" : "Project and policy"}>
      <h2>{bn ? "প্রজেক্ট ও নীতিমালা" : "Project & policy"}</h2>
      <ul class="utility-links">
        <li>
          <a href={withBase(localePath(locale, "/about/#why-this-exists"))}
            >{bn ? "CSE Compass কেন?" : "Why CSE Compass?"}</a
          >
        </li>
        <li>
          <a
            href={withBase(localePath(locale, "/guidance/final-year-project/"))}
            >{bn ? "Final-year project guide" : "Final-year project guide"}</a
          >
        </li>
        <li>
          <a href={withBase(localePath(locale, "/privacy/"))}
            >{bn ? "Privacy ও analytics" : "Privacy & analytics"}</a
          >
        </li>
        <li>
          <a
            href={siteConfig.repository}
            target="_blank"
            rel="noopener noreferrer"
            aria-describedby="external-link-description"
            >GitHub <span aria-hidden="true">↗</span></a
          >
        </li>
      </ul>
    </nav>
  </div>
  <section
    class="container footer-credits"
    aria-labelledby="footer-credits-title"
  >
    <div class="credits-heading">
      <h2 id="footer-credits-title">
        {bn ? "অনুপ্রেরণা ও সহযোগিতা" : "Inspiration & collaboration"}
      </h2>
      <a href={withBase(localePath(locale, "/about/#credits"))}>
        {bn ? "বিস্তারিত কৃতজ্ঞতা" : "Full credits"}
        <span aria-hidden="true">→</span>
      </a>
    </div>
    <div class="credits-grid">
      <div>
        <p>{bn ? "যাদের কাজ থেকে অনুপ্রেরণা" : "Inspired by"}</p>
        <ul class="inspiration-links" role="list">
          {
            inspirations.map((source) => (
              <li>
                <a
                  href={source.url}
                  target="_blank"
                  rel="noopener noreferrer"
                  aria-describedby="external-link-description"
                >
                  {source.name} <span aria-hidden="true">↗</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
      <ul class="collaborators" role="list">
        {
          collaborators.map((person) => (
            <li>
              <strong>
                {person.url ? (
                  <a
                    class="credit-person-link"
                    href={person.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-describedby="external-link-description"
                  >
                    {person.name} <span aria-hidden="true">↗</span>
                  </a>
                ) : (
                  person.name
                )}
              </strong>{" "}
              — {person.role[locale]}
            </li>
          ))
        }
      </ul>
    </div>
  </section>
  <div class="container footer-base">
    <p>© {new Date().getFullYear()} CSE Compass · MIT License</p>
    <p>
      {
        bn
          ? "ভালো direction মানে final destination নয়—এখনকার meaningful next step।"
          : "A direction is not a lifetime contract. It is a meaningful next step."
      }
    </p>
  </div>
</footer>

<style>
  .site-footer {
    padding-block: 4rem 2rem;
    border-top: 1px solid var(--color-border);
    background: var(--color-surface);
  }
  .footer-grid {
    display: grid;
    gap: 2.5rem;
  }
  .footer-intro {
    max-width: 29rem;
  }
  .site-footer h2 {
    margin-bottom: 0.8rem;
    font-size: 0.84rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .site-footer ul {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .site-footer li {
    margin: 0;
  }
  .site-footer a {
    display: inline-flex;
    min-height: 2.6rem;
    align-items: center;
    color: var(--color-text);
  }
  .footer-base {
    display: grid;
    gap: 0.3rem;
    margin-top: 3rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
    color: var(--color-text-muted);
    font-size: 0.88rem;
  }
  .footer-base p {
    margin: 0;
  }
  .footer-credits {
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
    font-size: 0.95rem;
  }
  .credits-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    margin-bottom: 1rem;
  }
  .credits-heading h2,
  .footer-credits p {
    margin: 0;
  }
  .credits-grid {
    display: grid;
    gap: 1rem;
  }
  .inspiration-links {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.5rem;
  }
  .footer-credits a {
    gap: 0.35rem;
    min-height: 2.75rem;
  }
  .collaborators li + li {
    margin-top: 0.4rem;
  }
  .collaborators .credit-person-link {
    min-height: 2.75rem;
    gap: 0.25rem;
  }
  @media (min-width: 48rem) {
    .credits-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 2rem;
    }
    .footer-grid {
      grid-template-columns: minmax(20rem, 1.4fr) minmax(16rem, 0.8fr);
      align-items: start;
    }
    .footer-base {
      grid-template-columns: 1fr 1fr;
    }
    .footer-base p:last-child {
      text-align: end;
    }
  }
</style>
