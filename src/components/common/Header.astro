---
import Logo from "@/components/common/Logo.astro";
import { localePath, stripLocale, ui, withBase } from "@/config/site";
import { isNavigationItemActive, navigationGroups } from "@/data/navigation";
import { t } from "@/lib/i18n";
import type { Locale } from "@/types/content";

interface Props {
  locale: Locale;
  pathname: string;
}
const { locale, pathname } = Astro.props;
const copy = ui[locale];
const currentPath = stripLocale(pathname);
---

<header class="site-header">
  <div class="header-inner container">
    <div class="header-nav">
      <a
        class="brand"
        href={withBase(localePath(locale, "/"))}
        aria-label={`CSE Compass — ${locale === "en" ? "Home" : "হোম"}`}
      >
        <Logo compact />
      </a>

      <details class="nav-details" open>
        <summary aria-label={copy.menu} title={copy.menu}>
          <span aria-hidden="true" class="menu-icon">☰</span>
        </summary>
        <nav
          aria-label={locale === "en" ? "Primary navigation" : "মূল নেভিগেশন"}
        >
          <div class="nav-groups">
            {
              navigationGroups.map((group) => (
                <section
                  class="nav-group"
                  aria-labelledby={`nav-group-${group.id}`}
                >
                  <h2 id={`nav-group-${group.id}`}>{t(group.label, locale)}</h2>
                  <ul>
                    {group.items.map((item) => {
                      const active = isNavigationItemActive(currentPath, item);
                      return (
                        <li>
                          <a
                            class:list={[
                              "nav-link",
                              { "nav-link--emphasis": item.emphasis },
                            ]}
                            href={withBase(localePath(locale, item.path))}
                            aria-current={active ? "page" : undefined}
                            data-nav-item={item.id}
                          >
                            <span>{t(item.label, locale)}</span>
                            <span class="nav-arrow" aria-hidden="true">
                              →
                            </span>
                          </a>
                        </li>
                      );
                    })}
                  </ul>
                </section>
              ))
            }
          </div>
        </nav>
      </details>
    </div>
  </div>
</header>

<noscript>
  <style>
    @media (max-width: 67.999rem) {
      .site-header {
        position: relative;
        z-index: 10;
      }

      .breadcrumb-bar {
        top: 0;
        z-index: 20;
      }

      html {
        scroll-behavior: auto;
        scroll-padding-top: 4.5rem;
      }

      .nav-details[open] nav {
        position: static;
        max-height: none;
        border: 0;
        box-shadow: none;
      }
    }
  </style>
</noscript>

<script>
  const navigation = document.querySelector<HTMLDetailsElement>(".nav-details");
  const desktopNavigation = window.matchMedia("(min-width: 68rem)");
  const syncNavigation = () => {
    if (navigation) navigation.open = desktopNavigation.matches;
  };
  syncNavigation();
  desktopNavigation.addEventListener("change", syncNavigation);
  navigation?.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && !desktopNavigation.matches) {
      navigation.open = false;
      navigation.querySelector("summary")?.focus();
    }
  });
</script>

<style>
  .site-header {
    position: sticky;
    z-index: 20;
    top: 0;
    border-bottom: 1px solid var(--color-border);
    background: color-mix(in srgb, var(--color-bg) 94%, transparent);
    backdrop-filter: blur(12px);
  }
  .header-inner {
    display: flex;
    min-height: var(--mobile-header-height);
    align-items: center;
    gap: 0.65rem;
  }
  .header-nav {
    display: contents;
  }
  .brand {
    margin-inline-end: auto;
    text-decoration: none;
  }
  .nav-details {
    order: 3;
  }
  .nav-details summary {
    display: inline-flex;
    width: 2.75rem;
    min-height: 2.75rem;
    align-items: center;
    justify-content: center;
    padding: 0.5rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-sm);
    cursor: pointer;
    font-weight: 750;
    list-style: none;
  }
  .nav-details summary::-webkit-details-marker {
    display: none;
  }
  .menu-icon {
    font-size: 1.05rem;
    line-height: 1;
  }
  .nav-details nav {
    position: absolute;
    inset-block-start: calc(100% + 1px);
    inset-inline: 0;
    max-height: calc(100dvh - var(--mobile-header-height));
    overflow-y: auto;
    padding: 1.1rem max(1rem, calc((100vw - var(--container)) / 2));
    border-bottom: 1px solid var(--color-border);
    background: var(--color-surface-raised);
    box-shadow: var(--shadow-md);
  }
  .nav-groups {
    display: grid;
    gap: 1.25rem;
  }
  .nav-group h2 {
    margin: 0 0 0.35rem;
    color: var(--color-text-muted);
    font-size: 0.72rem;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }
  body[data-locale="bn"] .nav-group h2 {
    letter-spacing: 0.035em;
  }
  .nav-group ul {
    display: grid;
    gap: 0.1rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .nav-group li {
    margin: 0;
  }
  .nav-link {
    display: flex;
    min-height: 2.75rem;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    padding: 0.45rem 0.65rem;
    border-inline-start: 3px solid transparent;
    color: var(--color-text);
    font-weight: 680;
    line-height: 1.35;
    text-decoration: none;
  }
  .nav-link:hover {
    background: var(--color-code);
  }
  .nav-link[aria-current="page"] {
    border-inline-start-color: var(--color-primary);
    background: var(--color-code);
    color: var(--color-primary-strong);
  }
  .nav-link--emphasis {
    color: var(--color-warm);
  }
  .nav-arrow {
    color: var(--color-border-strong);
  }
  .nav-link:hover .nav-arrow,
  .nav-link[aria-current="page"] .nav-arrow {
    color: currentColor;
  }
  @media (min-width: 36rem) {
    .nav-groups {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 68rem) {
    .site-header {
      position: static;
      border-bottom: 0;
      background: transparent;
      backdrop-filter: none;
    }
    .header-inner {
      display: contents;
    }
    .header-nav {
      position: fixed;
      z-index: 20;
      inset-block: 0;
      inset-inline-start: 0;
      display: flex;
      width: var(--sidebar-width);
      overflow-y: auto;
      border-inline-end: 1px solid var(--color-border);
      background: var(--color-surface);
      padding: 1.4rem 1.15rem;
      flex-direction: column;
      align-items: stretch;
      gap: 1.2rem;
    }
    .brand {
      margin: 0;
      padding-inline: 0.35rem;
    }
    .nav-details {
      display: block;
      width: 100%;
      flex: 1;
      order: 2;
    }
    .nav-details summary {
      display: none;
    }
    .nav-details nav {
      position: static;
      max-height: none;
      overflow: visible;
      padding: 0;
      border: 0;
      background: transparent;
      box-shadow: none;
    }
    .nav-groups {
      grid-template-columns: 1fr;
      gap: 1.05rem;
    }
    .nav-link {
      min-height: 2.35rem;
      padding-block: 0.3rem;
      font-size: 0.9rem;
    }
  }
</style>
