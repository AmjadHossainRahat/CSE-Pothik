---
import Breadcrumbs from "@/components/common/Breadcrumbs.astro";
import ResourceList from "@/components/common/ResourceList.astro";
import GoalLinks from "@/components/goals/GoalLinks.astro";
import {
  aiCareerPath,
  careerPath,
  experimentPath,
  localePath,
  roadmapPath,
  withBase,
} from "@/config/site";
import { careerById, careerFamilies } from "@/data/careers";
import { t } from "@/lib/i18n";
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { Career, Locale } from "@/types/content";

interface Props {
  career: Career;
  locale: Locale;
}
const { career, locale } = Astro.props;
const bn = locale === "bn";
const family = careerFamilies.find((item) => item.id === career.familyId)!;
const supportsFirstSoftwareRole = [
  "backend-engineering",
  "frontend-engineering",
  "mobile-app-development",
  "software-quality-assurance",
].includes(career.id);
const dimensions = [
  [bn ? "কোডিং" : "Coding", career.dimensions.coding],
  [bn ? "গণিত" : "Mathematics", career.dimensions.mathematics],
  [bn ? "সিস্টেমের গভীরতা" : "Systems depth", career.dimensions.systems],
  [bn ? "অনুসন্ধান" : "Investigation", career.dimensions.investigation],
  [bn ? "সৃজনশীলতা" : "Creativity / design", career.dimensions.creativity],
  [bn ? "যোগাযোগ" : "Communication", career.dimensions.communication],
  [
    bn ? "Production-এর দায়িত্ব" : "Production responsibility",
    career.dimensions.production,
  ],
] as const;
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: `${t(career.title, locale)} ${bn ? "ক্যারিয়ার গাইড ও রোডম্যাপ" : "Roadmap & Career Guide"}`,
    description: t(career.shortDescription, locale),
    inLanguage: locale,
    isAccessibleForFree: true,
    author: { "@type": "Organization", name: "CSE-Pothik" },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: bn ? "ক্যারিয়ার" : "Careers",
        item: new URL(withBase(localePath(locale, "/careers/")), Astro.site)
          .href,
      },
      {
        "@type": "ListItem",
        position: 2,
        name: t(career.title, locale),
        item: Astro.url.href,
      },
    ],
  },
];
---

<BaseLayout
  locale={locale}
  title={`${t(career.title, locale)} ${bn ? "রোডম্যাপ ও ক্যারিয়ার গাইড" : "Roadmap & Career Guide"}`}
  description={t(career.shortDescription, locale)}
  structuredData={structuredData}
  contentView={{ type: "career", careerId: career.id }}
>
  <Breadcrumbs
    locale={locale}
    items={[
      { label: bn ? "ক্যারিয়ার" : "Careers", path: "/careers/" },
      { label: t(career.title, locale) },
    ]}
  />
  <header class="page-hero container career-hero">
    <div>
      <p class="eyebrow">
        {t(family.title, locale)} · {bn ? "ক্যারিয়ার গাইড" : "Career guide"}
      </p>
      <h1>{t(career.title, locale)}</h1>
      <p class="lede">{t(career.shortDescription, locale)}</p>
      <div class="button-row">
        <a
          class="button"
          href={withBase(experimentPath(locale, career.slug))}
          data-track-event="career_experiment_started"
          data-track-param-career-id={career.id}
          >{bn ? "কাজটা করে দেখি" : "Try this career"}</a
        >
        <a
          class="button button--secondary"
          href={withBase(roadmapPath(locale, career.slug))}
          data-track-event="next_step_clicked"
          data-track-param-destination={`roadmap/${career.id}`}
          >{bn ? "রোডম্যাপ দেখি" : "See the roadmap"}</a
        >
      </div>
    </div>
    <aside class="callout">
      <p class="callout__label">{bn ? "2 AM test" : "The 2 AM test"}</p><p>
        {
          career.id === "backend-engineering"
            ? bn
              ? "রাত ২টা ১৩। Production ২০ গুণ ধীর, নতুন কিছু deploy-ও হয়নি, customer অভিযোগ করছে। খুঁজে দেখতে ভয় লাগছে, বিরক্তি আসছে—নাকি ভেতরে একটু কৌতূহলও হচ্ছে?"
              : "It is 2:13 AM. Production is 20× slower, nothing was deployed and customers are complaining. Does investigating feel terrifying, annoying—or weirdly exciting?"
            : bn
              ? "কাজের যে অংশটা একদমই glamorous নয়, সেটিও কি অন্তত খুঁজে দেখার মতো interesting লাগে? শুধু মজার task দিয়ে career fit মাপা যায় না।"
              : "Is the unglamorous part still interesting enough to investigate? Career fit is not measured by exciting tasks alone."
        }
      </p>
    </aside>
  </header>

  <section class="section section--tinted" aria-labelledby="snapshot-title">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">
            {bn ? "এক নজরে ক্যারিয়ার" : "Career snapshot"}
          </p><h2 id="snapshot-title">
            {
              bn
                ? "কাজের চাপ কেমন"
                : "A work-pressure profile, not a personality score"
            }
          </h2>
        </div><p class="lede">
          {
            bn
              ? "তিনটি dot মানে ‘ভালো’ নয়। শুধু বোঝায়—এই ক্যারিয়ারে ওই ধরনের কাজ বেশি আসে।"
              : "Three dots never means ‘better.’ It only means this dimension appears more often in the work."
          }
        </p>
      </div><div class="metric-grid">
        {
          dimensions.map(([label, value]) => (
            <div class="metric">
              <>
                <strong>{label}</strong>
                <div
                  class="metric__dots"
                  role="img"
                  aria-label={`${bn ? "৩-এর মধ্যে" : "out of 3"} ${value}`}
                >
                  {[1, 2, 3].map((dot) => (
                    <span
                      class:list={[
                        "metric__dot",
                        { "metric__dot--on": dot <= value },
                      ]}
                    />
                  ))}
                </div>
              </>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container editorial-grid">
      <div>
        <p class="eyebrow">
          {bn ? "আসল কাজ" : "What would I actually do?"}
        </p><h2>
          {
            bn
              ? "একটি সত্যিকারের সপ্তাহে যা করতে হতে পারে"
              : "The work behind the title"
          }
        </h2><ul class="rule-list">
          {career.actualWork.map((item) => <li>{t(item, locale)}</li>)}
        </ul>
      </div><div class="callout callout--warm">
        <p class="callout__label">{bn ? "বাস্তব কথাটা" : "Reality check"}</p><p>
          {
            bn
              ? "Tutorial শেষ করা আর production-এর ফলাফলের দায় নেওয়া এক দক্ষতা নয়। এই page-এর কাজ hype তোলা নয়—দুটোর মাঝের ফাঁকটা দেখানো।"
              : "Finishing a tutorial and owning production consequences are different skills. The point is to see the gap, not hide it with hype."
          }
        </p>
      </div>
    </div>
  </section>

  <section class="section section--tinted">
    <div class="container fit-grid">
      <div>
        <p class="eyebrow">
          {bn ? "ভালো লাগতে পারে যদি" : "You might enjoy this if…"}
        </p><h2>{bn ? "কৌতূহলের ছোট ইঙ্গিত" : "Signals worth noticing"}</h2><ul>
          {career.enjoyIf.map((item) => <li>{t(item, locale)}</li>)}
        </ul>
      </div><div>
        <p class="eyebrow">
          {bn ? "কঠিন লাগতে পারে যদি" : "You might dislike this if…"}
        </p><h2>
          {bn ? "যে অংশটি অস্বস্তিকর হতে পারে" : "The uncomfortable part"}
        </h2><ul>
          {career.dislikeIf.map((item) => <li>{t(item, locale)}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">
            {bn ? "বাস্তবসম্মত একটি দিন" : "A realistic day"}
          </p><h2>
            {
              bn
                ? "প্রতিদিন এমন হবে না, তবে চাপের স্বাদটা এমন হতে পারে"
                : "No day is identical, but the pressure may feel like this"
            }
          </h2>
        </div><p class="lede">
          {
            bn
              ? "এই timeline কোনো সাজানো career fantasy নয়; সাধারণ কয়েকটি কাজের সম্ভাব্য মিশ্রণ।"
              : "This is a plausible mix of recurring tasks, not a scripted career fantasy."
          }
        </p>
      </div><ol class="dayline">
        {
          career.realisticDay.map((segment) => (
            <li>
              <>
                <time>{segment.time}</time>
                <p>{t(segment.activity, locale)}</p>
              </>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section section--tinted">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">
            {bn ? "কীভাবে শিখবে" : "What should I learn?"}
          </p><h2>
            {
              bn
                ? "Checklist নয়—ধাপে ধাপে এগোনোর পথ"
                : "A layered sequence, not a technology dump"
            }
          </h2>
        </div><a
          class="button button--secondary"
          href={withBase(roadmapPath(locale, career.slug))}
          >{bn ? "বিস্তারিত রোডম্যাপ" : "Open the detailed roadmap"}</a
        >
      </div><div class="learn-grid">
        {
          [
            [bn ? "ভিত্তি" : "Foundation", career.foundation],
            [bn ? "মূল দক্ষতা" : "Core", career.core],
            [bn ? "হাতে-কলমে কাজ" : "Practical", career.practical],
            [bn ? "পরে" : "Later", career.later],
          ].map(([label, items], index) => (
            <article>
              <>
                <span>0{index + 1}</span>
                <h3>{label}</h3>
                <ul>
                  {(items as Career["foundation"]).map((item) => (
                    <li>{t(item, locale)}</li>
                  ))}
                </ul>
              </>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container editorial-grid">
      <div>
        <p class="eyebrow">
          {bn ? "যেগুলো এখনই না শিখলেও চলবে" : "What not to learn yet"}
        </p><h2>
          {
            bn
              ? "এখনই নয়—কারণ কোনটার পর কোনটা শিখছ, সেটি জরুরি"
              : "Not yet—because sequence matters"
          }
        </h2><ul class="not-yet">
          {
            career.notYet.map((item) => (
              <li>
                <span aria-hidden="true">×</span>
                {t(item, locale)}
              </li>
            ))
          }
        </ul>
      </div><div class="callout callout--amber">
        <p class="callout__label">
          {bn ? "ভবিষ্যতের আপনি বলছেন" : "Future You says"}
        </p><p>
          {
            career.id === "backend-engineering"
              ? bn
                ? "এখনও প্রথম API-টাই deploy করেননি। Kubernetes-কে একটু অপেক্ষা করতে বললে সে রাগ করবে না।"
                : "You have not deployed your first API yet. Kubernetes can wait."
              : bn
                ? "‘পরে’ মানে অপ্রয়োজনীয় নয়। ভিত তৈরি হওয়ার আগে শিখলে শুধু context-টাই থাকবে না।"
                : "‘Later’ does not mean useless. It means you will learn it faster once you have a real problem for it."
          }
        </p>
      </div>
    </div>
  </section>

  <section class="section section--tinted">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">
            {bn ? "AI ও এই ক্যারিয়ার" : "AI & this career"}
          </p><h2>
            {bn ? "কাজ কতটা automate হতে পারে" : "Task Automation Exposure"}
          </h2>
        </div><p class="lede">
          {
            bn
              ? "এটি replacement-এর শতকরা হিসাব নয়। AI-এর ক্ষমতা বদলাবে; তাই কাজ, বিচারবোধ আর দায়িত্ব—তিনটাকে আলাদা করে দেখুন।"
              : "This is not a replacement probability. Capabilities will change, so separate tasks, judgment and responsibility."
          }
        </p>
      </div><div class="exposure">
        {
          career.aiExposure.map((item) => (
            <article class="exposure__item" data-level={item.exposure}>
              <>
                <span class="tag">{item.exposure}</span>
                <h3>{t(item.task, locale)}</h3>
                <p>{t(item.explanation, locale)}</p>
                <p>
                  <strong>{bn ? "আপনার করণীয়:" : "Student response:"}</strong>{" "}
                  {t(item.studentResponse, locale)}
                </p>
              </>
            </article>
          ))
        }
      </div><a
        class="text-link"
        href={withBase(aiCareerPath(locale, career.slug))}
        data-track-event="ai_guidance_viewed"
        data-track-param-career-id={career.id}
        >{
          bn
            ? "এই ক্যারিয়ারে AI ব্যবহারের গাইড →"
            : "Open the career-specific AI practice guide →"
        }</a
      >
    </div>
  </section>

  <section class="section">
    <div class="container editorial-grid">
      <div>
        <p class="eyebrow">
          {bn ? "বাছাই করা শেখার রিসোর্স" : "Curated learning resources"}
        </p><h2>
          {
            career.id === "mobile-app-development"
              ? bn
                ? "শুরুতে একটি platform-ই যথেষ্ট"
                : "Start with one platform"
              : "Learn → Practice → Go deeper"
          }
        </h2><p class="lede">
          {
            bn
              ? "কতগুলো resource জমিয়েছেন, সেটি progress নয়। দরকারি অংশটুকু শেষ করে কিছু বানান।"
              : "Resource count is not progress. Finish the recommended scope and build something."
          }
        </p>
      </div><ResourceList
        locale={locale}
        resourceIds={career.id === "mobile-app-development"
          ? career.resourceIds
          : career.resourceIds.slice(0, 3)}
        alternatives={career.id === "mobile-app-development"}
      />
    </div>
  </section>

  <section class="section section--tinted">
    <div class="container">
      <p class="eyebrow">{bn ? "এবার কী করবেন" : "Next choices"}</p><h2>
        {
          bn
            ? "এবার নিজের জন্য কোন evidence বানাবে?"
            : "What evidence will you gather next?"
        }
      </h2><div class="next-actions">
        <a class="button" href={withBase(experimentPath(locale, career.slug))}
          >{bn ? "কাজটা করে দেখি" : "Try this career"}</a
        ><a
          class="button button--secondary"
          href={withBase(localePath(locale, "/compare/"))}
          >{
            bn
              ? "অন্য ক্যারিয়ারের সঙ্গে মিলিয়ে দেখি"
              : "Compare with another path"
          }</a
        ><a
          class="button button--secondary"
          href={withBase(roadmapPath(locale, career.slug))}
          >{bn ? "রোডম্যাপ" : "See the roadmap"}</a
        >
      </div>
      {
        supportsFirstSoftwareRole && (
          <p>
            <a
              href={withBase(
                localePath(locale, "/guidance/first-software-role/"),
              )}
              data-track-event="next_step_clicked"
              data-track-param-destination="first-software-role"
            >
              {bn
                ? "Final semester থেকে internship বা junior role-এর পরিকল্পনা"
                : "Turn this direction into an internship or junior-role plan"}{" "}
              →
            </a>
          </p>
        )
      }
      <h3 class="related-title">
        {bn ? "কাছাকাছি আরও কিছু পথ" : "Nearby directions"}
      </h3><div class="related-links">
        {
          career.relatedCareerIds.map((id) => {
            const related = careerById.get(id)!;
            return (
              <a href={withBase(careerPath(locale, related.slug))}>
                {t(related.title, locale)} <span aria-hidden="true">→</span>
              </a>
            );
          })
        }<a href={withBase(localePath(locale, "/careers/"))}
          >{
            bn
              ? "এটি আমার মতো লাগছে না—অন্য বিভাগ দেখি"
              : "This does not sound like me"
          }
          <span aria-hidden="true">→</span></a
        >
      </div>
    </div>
  </section>
  <GoalLinks careerId={career.id} locale={locale} />
</BaseLayout>

<style>
  .career-hero {
    display: grid;
    gap: 2.5rem;
  }
  .fit-grid,
  .learn-grid {
    display: grid;
    gap: 2rem;
  }
  .fit-grid > div {
    padding-top: 1rem;
    border-top: 3px solid var(--color-primary);
  }
  .fit-grid > div:last-child {
    border-color: var(--color-warm);
  }
  .dayline {
    display: grid;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-border-strong);
    list-style: none;
  }
  .dayline li {
    display: grid;
    grid-template-columns: 5rem 1fr;
    gap: 1rem;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--color-border);
  }
  .dayline time {
    color: var(--color-warm);
    font-weight: 800;
  }
  .dayline p {
    margin: 0;
  }
  .learn-grid article {
    padding-top: 1rem;
    border-top: 2px solid var(--color-primary);
  }
  .learn-grid article > span {
    color: var(--color-warm);
    font-size: 0.75rem;
    font-weight: 800;
  }
  .not-yet {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .not-yet li {
    display: grid;
    grid-template-columns: 1.4rem 1fr;
    gap: 0.7rem;
    padding: 0.8rem 0;
    border-bottom: 1px solid var(--color-border);
  }
  .not-yet span {
    color: var(--color-warm);
    font-weight: 900;
  }
  .related-title {
    margin-top: 3rem;
  }
  .related-links {
    display: grid;
    border-top: 1px solid var(--color-border);
  }
  .related-links a {
    display: flex;
    min-height: 3.4rem;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text);
    font-weight: 700;
  }
  @media (min-width: 48rem) {
    .career-hero {
      grid-template-columns: minmax(0, 1.2fr) minmax(18rem, 0.7fr);
      align-items: end;
    }
    .fit-grid {
      grid-template-columns: 1fr 1fr;
    }
    .learn-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
