---
import Breadcrumbs from "@/components/common/Breadcrumbs.astro";
import ResourceList from "@/components/common/ResourceList.astro";
import GoalLinks from "@/components/goals/GoalLinks.astro";
import {
  aiCareerPath,
  careerPath,
  experimentPath,
  localePath,
  roadmapPath,
  withBase,
} from "@/config/site";
import { careerById, careerFamilies } from "@/data/careers";
import { t } from "@/lib/i18n";
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { Career, Locale } from "@/types/content";

interface Props {
  career: Career;
  locale: Locale;
}
const { career, locale } = Astro.props;
const bn = locale === "bn";
const family = careerFamilies.find((item) => item.id === career.familyId)!;
const dimensions = [
  [bn ? "Coding" : "Coding", career.dimensions.coding],
  [bn ? "Math" : "Mathematics", career.dimensions.mathematics],
  [bn ? "Systems depth" : "Systems depth", career.dimensions.systems],
  [bn ? "Investigation" : "Investigation", career.dimensions.investigation],
  [bn ? "Creativity" : "Creativity / design", career.dimensions.creativity],
  [bn ? "Communication" : "Communication", career.dimensions.communication],
  [
    bn ? "Production ownership" : "Production responsibility",
    career.dimensions.production,
  ],
] as const;
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: `${t(career.title, locale)} ${bn ? "Career Guide ও Roadmap" : "Roadmap & Career Guide"}`,
    description: t(career.shortDescription, locale),
    inLanguage: locale,
    isAccessibleForFree: true,
    author: { "@type": "Organization", name: "CSE Compass" },
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: bn ? "Career" : "Careers",
        item: new URL(withBase(localePath(locale, "/careers/")), Astro.site)
          .href,
      },
      {
        "@type": "ListItem",
        position: 2,
        name: t(career.title, locale),
        item: Astro.url.href,
      },
    ],
  },
];
---

<BaseLayout
  locale={locale}
  title={`${t(career.title, locale)} ${bn ? "Roadmap ও Career Guide" : "Roadmap & Career Guide"}`}
  description={t(career.shortDescription, locale)}
  structuredData={structuredData}
  contentView={{ type: "career", careerId: career.id }}
>
  <Breadcrumbs
    locale={locale}
    items={[
      { label: bn ? "Career" : "Careers", path: "/careers/" },
      { label: t(career.title, locale) },
    ]}
  />
  <header class="page-hero container career-hero">
    <div>
      <p class="eyebrow">
        {t(family.title, locale)} · {bn ? "Career guide" : "Career guide"}
      </p>
      <h1>{t(career.title, locale)}</h1>
      <p class="lede">{t(career.shortDescription, locale)}</p>
      <div class="button-row">
        <a
          class="button"
          href={withBase(experimentPath(locale, career.slug))}
          data-track-event="career_experiment_started"
          data-track-param-career-id={career.id}
          >{bn ? "এই career try করি" : "Try this career"}</a
        >
        <a
          class="button button--secondary"
          href={withBase(roadmapPath(locale, career.slug))}
          data-track-event="next_step_clicked"
          data-track-param-destination={`roadmap/${career.id}`}
          >{bn ? "Roadmap দেখি" : "See the roadmap"}</a
        >
      </div>
    </div>
    <aside class="callout">
      <p class="callout__label">{bn ? "2 AM test" : "The 2 AM test"}</p><p>
        {
          career.id === "backend-engineering"
            ? bn
              ? "রাত ২:১৩। Production ২০× slow, কিছু deploy হয়নি, customer complain করছে। Investigate করতে ভয়, বিরক্তি—নাকি অদ্ভুত curiosity?"
              : "It is 2:13 AM. Production is 20× slower, nothing was deployed and customers are complaining. Does investigating feel terrifying, annoying—or weirdly exciting?"
            : bn
              ? "যে অংশটা glamorous নয়, সেটাও কি অন্তত investigate করার মতো interesting? Career fit exciting task দিয়ে একা মাপা যায় না।"
              : "Is the unglamorous part still interesting enough to investigate? Career fit is not measured by exciting tasks alone."
        }
      </p>
    </aside>
  </header>

  <section class="section section--tinted" aria-labelledby="snapshot-title">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">{bn ? "Career snapshot" : "Career snapshot"}</p><h2
            id="snapshot-title"
          >
            {
              bn
                ? "কাজের pressure profile"
                : "A work-pressure profile, not a personality score"
            }
          </h2>
        </div><p class="lede">
          {
            bn
              ? "তিন dot মানে ‘better’ নয়। এই career-এ ওই dimension বেশি ঘনঘন আসে—শুধু সেটাই।"
              : "Three dots never means ‘better.’ It only means this dimension appears more often in the work."
          }
        </p>
      </div><div class="metric-grid">
        {
          dimensions.map(([label, value]) => (
            <div class="metric">
              <>
                <strong>{label}</strong>
                <div
                  class="metric__dots"
                  role="img"
                  aria-label={`${value} ${bn ? "out of" : "out of"} 3`}
                >
                  {[1, 2, 3].map((dot) => (
                    <span
                      class:list={[
                        "metric__dot",
                        { "metric__dot--on": dot <= value },
                      ]}
                    />
                  ))}
                </div>
              </>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container editorial-grid">
      <div>
        <p class="eyebrow">
          {bn ? "Real work" : "What would I actually do?"}
        </p><h2>
          {bn ? "একটা real সপ্তাহে যা করতে পারো" : "The work behind the title"}
        </h2><ul class="rule-list">
          {career.actualWork.map((item) => <li>{t(item, locale)}</li>)}
        </ul>
      </div><div class="callout callout--warm">
        <p class="callout__label">{bn ? "Reality check" : "Reality check"}</p><p
        >
          {
            bn
              ? "Tutorial শেষ করা আর production consequence own করা আলাদা skill। Career page-এর goal hype নয়—দুটোর gap দেখানো।"
              : "Finishing a tutorial and owning production consequences are different skills. The point is to see the gap, not hide it with hype."
          }
        </p>
      </div>
    </div>
  </section>

  <section class="section section--tinted">
    <div class="container fit-grid">
      <div>
        <p class="eyebrow">
          {bn ? "ভালো লাগতে পারে যদি" : "You might enjoy this if…"}
        </p><h2>{bn ? "Curiosity-এর signal" : "Signals worth noticing"}</h2><ul>
          {career.enjoyIf.map((item) => <li>{t(item, locale)}</li>)}
        </ul>
      </div><div>
        <p class="eyebrow">
          {bn ? "কঠিন লাগতে পারে যদি" : "You might dislike this if…"}
        </p><h2>{bn ? "Uncomfortable part" : "The uncomfortable part"}</h2><ul>
          {career.dislikeIf.map((item) => <li>{t(item, locale)}</li>)}
        </ul>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">
            {bn ? "একটা realistic day" : "A realistic day"}
          </p><h2>
            {
              bn
                ? "প্রতিদিন এক না, কিন্তু pressure-এর taste এমন হতে পারে"
                : "No day is identical, but the pressure may feel like this"
            }
          </h2>
        </div><p class="lede">
          {
            bn
              ? "এই timeline scripted career fantasy নয়; typical task-এর plausible mix।"
              : "This is a plausible mix of recurring tasks, not a scripted career fantasy."
          }
        </p>
      </div><ol class="dayline">
        {
          career.realisticDay.map((segment) => (
            <li>
              <>
                <time>{segment.time}</time>
                <p>{t(segment.activity, locale)}</p>
              </>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <section class="section section--tinted">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">
            {bn ? "Learning direction" : "What should I learn?"}
          </p><h2>
            {
              bn
                ? "Checklist নয়—layered sequence"
                : "A layered sequence, not a technology dump"
            }
          </h2>
        </div><a
          class="button button--secondary"
          href={withBase(roadmapPath(locale, career.slug))}
          >{bn ? "Detailed roadmap" : "Open the detailed roadmap"}</a
        >
      </div><div class="learn-grid">
        {
          [
            [bn ? "Foundation" : "Foundation", career.foundation],
            [bn ? "Core" : "Core", career.core],
            [bn ? "Practical" : "Practical", career.practical],
            [bn ? "পরে" : "Later", career.later],
          ].map(([label, items], index) => (
            <article>
              <>
                <span>0{index + 1}</span>
                <h3>{label}</h3>
                <ul>
                  {(items as Career["foundation"]).map((item) => (
                    <li>{t(item, locale)}</li>
                  ))}
                </ul>
              </>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section">
    <div class="container editorial-grid">
      <div>
        <p class="eyebrow">
          {bn ? "What not to learn yet" : "What not to learn yet"}
        </p><h2>
          {
            bn
              ? "এখনই নয়—কারণ sequence matters"
              : "Not yet—because sequence matters"
          }
        </h2><ul class="not-yet">
          {
            career.notYet.map((item) => (
              <li>
                <span aria-hidden="true">×</span>
                {t(item, locale)}
              </li>
            ))
          }
        </ul>
      </div><div class="callout callout--amber">
        <p class="callout__label">
          {bn ? "Future You says" : "Future You says"}
        </p><p>
          {
            career.id === "backend-engineering"
              ? bn
                ? "এখনও প্রথম API-টাই deploy করোনি। Kubernetes একটু অপেক্ষা করতেই পারে।"
                : "You have not deployed your first API yet. Kubernetes can wait."
              : bn
                ? "‘পরে’ মানে useless নয়। Foundation ছাড়া এখন শিখলে context থাকবে না।"
                : "‘Later’ does not mean useless. It means you will learn it faster once you have a real problem for it."
          }
        </p>
      </div>
    </div>
  </section>

  <section class="section section--tinted">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">{bn ? "AI ও এই career" : "AI & this career"}</p><h2
          >
            {bn ? "Task Automation Exposure" : "Task Automation Exposure"}
          </h2>
        </div><p class="lede">
          {
            bn
              ? "এটা replacement probability নয়। AI capability বদলাবে; তাই task, judgment আর responsibility আলাদা করে দেখো।"
              : "This is not a replacement probability. Capabilities will change, so separate tasks, judgment and responsibility."
          }
        </p>
      </div><div class="exposure">
        {
          career.aiExposure.map((item) => (
            <article class="exposure__item" data-level={item.exposure}>
              <>
                <span class="tag">{item.exposure}</span>
                <h3>{t(item.task, locale)}</h3>
                <p>{t(item.explanation, locale)}</p>
                <p>
                  <strong>
                    {bn ? "Student response:" : "Student response:"}
                  </strong>{" "}
                  {t(item.studentResponse, locale)}
                </p>
              </>
            </article>
          ))
        }
      </div><a
        class="text-link"
        href={withBase(aiCareerPath(locale, career.slug))}
        data-track-event="ai_guidance_viewed"
        data-track-param-career-id={career.id}
        >{
          bn
            ? "এই career-এর AI practice guide →"
            : "Open the career-specific AI practice guide →"
        }</a
      >
    </div>
  </section>

  <section class="section">
    <div class="container editorial-grid">
      <div>
        <p class="eyebrow">
          {bn ? "Curated learning" : "Curated learning resources"}
        </p><h2>
          {
            career.id === "mobile-app-development"
              ? bn
                ? "একটি platform দিয়ে শুরু"
                : "Start with one platform"
              : "Learn → Practice → Go deeper"
          }
        </h2><p class="lede">
          {
            bn
              ? "Resource count দিয়ে progress হয় না। Recommended scope শেষ করে কিছু build করো।"
              : "Resource count is not progress. Finish the recommended scope and build something."
          }
        </p>
      </div><ResourceList
        locale={locale}
        resourceIds={career.id === "mobile-app-development"
          ? career.resourceIds
          : career.resourceIds.slice(0, 3)}
        alternatives={career.id === "mobile-app-development"}
      />
    </div>
  </section>

  <section class="section section--tinted">
    <div class="container">
      <p class="eyebrow">{bn ? "Next choices" : "Next choices"}</p><h2>
        {bn ? "এখন কোন evidence নেবে?" : "What evidence will you gather next?"}
      </h2><div class="next-actions">
        <a class="button" href={withBase(experimentPath(locale, career.slug))}
          >{bn ? "Career experiment" : "Try this career"}</a
        ><a
          class="button button--secondary"
          href={withBase(localePath(locale, "/compare/"))}
          >{
            bn ? "অন্য career-এর সঙ্গে compare" : "Compare with another path"
          }</a
        ><a
          class="button button--secondary"
          href={withBase(roadmapPath(locale, career.slug))}
          >{bn ? "Roadmap" : "See the roadmap"}</a
        >
      </div><h3 class="related-title">
        {bn ? "Nearby directions" : "Nearby directions"}
      </h3><div class="related-links">
        {
          career.relatedCareerIds.map((id) => {
            const related = careerById.get(id)!;
            return (
              <a href={withBase(careerPath(locale, related.slug))}>
                {t(related.title, locale)} <span aria-hidden="true">→</span>
              </a>
            );
          })
        }<a href={withBase(localePath(locale, "/careers/"))}
          >{
            bn
              ? "এটা আমার মতো না—অন্য family দেখি"
              : "This does not sound like me"
          }
          <span aria-hidden="true">→</span></a
        >
      </div>
    </div>
  </section>
  <GoalLinks careerId={career.id} locale={locale} />
</BaseLayout>

<style>
  .career-hero {
    display: grid;
    gap: 2.5rem;
  }
  .fit-grid,
  .learn-grid {
    display: grid;
    gap: 2rem;
  }
  .fit-grid > div {
    padding-top: 1rem;
    border-top: 3px solid var(--color-primary);
  }
  .fit-grid > div:last-child {
    border-color: var(--color-warm);
  }
  .dayline {
    display: grid;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--color-border-strong);
    list-style: none;
  }
  .dayline li {
    display: grid;
    grid-template-columns: 5rem 1fr;
    gap: 1rem;
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--color-border);
  }
  .dayline time {
    color: var(--color-warm);
    font-weight: 800;
  }
  .dayline p {
    margin: 0;
  }
  .learn-grid article {
    padding-top: 1rem;
    border-top: 2px solid var(--color-primary);
  }
  .learn-grid article > span {
    color: var(--color-warm);
    font-size: 0.75rem;
    font-weight: 800;
  }
  .not-yet {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .not-yet li {
    display: grid;
    grid-template-columns: 1.4rem 1fr;
    gap: 0.7rem;
    padding: 0.8rem 0;
    border-bottom: 1px solid var(--color-border);
  }
  .not-yet span {
    color: var(--color-warm);
    font-weight: 900;
  }
  .related-title {
    margin-top: 3rem;
  }
  .related-links {
    display: grid;
    border-top: 1px solid var(--color-border);
  }
  .related-links a {
    display: flex;
    min-height: 3.4rem;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--color-border);
    color: var(--color-text);
    font-weight: 700;
  }
  @media (min-width: 48rem) {
    .career-hero {
      grid-template-columns: minmax(0, 1.2fr) minmax(18rem, 0.7fr);
      align-items: end;
    }
    .fit-grid {
      grid-template-columns: 1fr 1fr;
    }
    .learn-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
</style>
