---
import Breadcrumbs from "@/components/common/Breadcrumbs.astro";
import { withBase } from "@/config/site";
import { lostChoices } from "@/data/situations";
import { t } from "@/lib/i18n";
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { Locale } from "@/types/content";
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const bn = locale === "bn";
---

<BaseLayout
  locale={locale}
  title={bn
    ? "আমি দিশেহারা — CSE Next Step"
    : "I’m Lost — Find Your Next CSE Step"}
  description={bn
    ? "আজ কোথায় আটকে আছেন, সেটুকু বলুন। কোনো তথ্য জমা না রেখেই CSE-Pothik আপনাকে কাজে লাগে এমন পরের ধাপটি দেখাবে।"
    : "Choose where you are stuck today and follow a deterministic, private CSE guidance path to a useful next step."}
>
  <Breadcrumbs
    locale={locale}
    items={[{ label: bn ? "আমি দিশেহারা" : "I’m Lost" }]}
  />
  <header class="page-hero page-hero--compact lost-hero container">
    <p class="eyebrow">
      {
        bn
          ? "Account নেই · Score নেই · লজ্জারও কিছু নেই"
          : "No account · No score · No shame"
      }
    </p><h1>
      {
        bn
          ? "মাথা গুলিয়ে গেছে? আজকের সমস্যাটা বেছে নিন।"
          : "Confused? Choose today’s problem."
      }
    </h1><p class="lede">
      {
        bn
          ? "এটি personality test বা AI-এর ভবিষ্যদ্বাণী নয়। কোথায় আটকে আছেন বললে প্রাসঙ্গিক একটি পথ দেখাবে; আপনার উত্তর কোথাও জমা হবে না।"
          : "This is not a personality test or AI prediction. Tell the site where you are stuck and it will reveal a relevant route. No answer is saved."
      }
    </p>
  </header>
  <section class="section section--tinted">
    <div class="container lost-shell">
      <div>
        <h2>
          {bn ? "কোনটা এখন সবচেয়ে কাছের?" : "Which feels closest right now?"}
        </h2><div
          class="choice-grid"
          role="group"
          aria-label={bn ? "এখনকার সমস্যা" : "Current problem"}
        >
          {
            lostChoices.map((choice) => (
              <a
                class="choice"
                href={withBase(choice.destination[locale])}
                data-lost-choice={choice.id}
                data-title={t(choice.prompt, locale)}
                data-response={t(choice.response, locale)}
                data-destination={withBase(choice.destination[locale])}
                aria-controls="lost-result"
                aria-expanded="false"
              >
                {t(choice.prompt, locale)}
              </a>
            ))
          }
        </div>
      </div><div
        class="reveal-panel"
        id="lost-result"
        data-lost-result
        hidden
        tabindex="-1"
      >
        <p class="eyebrow">
          {bn ? "এখন আপনার কাজে লাগবে" : "Your next meaningful step"}
        </p><h2 data-result-title>
          {bn ? "একটি অবস্থা বেছে নিন" : "Choose one situation"}
        </h2><p data-result-copy></p><a class="button" data-result-link href="#"
          >{bn ? "এই পথে এগোই" : "Take this route"}</a
        ><button class="reset" type="button" data-lost-reset
          >{bn ? "অন্য উত্তর বেছে নিই" : "Choose another answer"}</button
        >
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container editorial-grid">
      <div>
        <p class="eyebrow">
          {bn ? "মনে হচ্ছে অনেক পিছিয়ে গেছেন?" : "If you feel behind"}
        </p><h2>
          {
            bn
              ? "তিন বছরের ঘাটতি তিন সপ্তাহে মিটবে না।"
              : "You cannot recover three years in three weeks."
          }
        </h2>
      </div><div>
        <p class="lede">
          {
            bn
              ? "কিন্তু পরের তিন মাস নষ্ট হওয়া আজই থামাতে পারেন। ছোট লক্ষ্য, প্রতিদিনের foundation, একটি project আর নিয়মিত feedback—শুনতে একটু boring, কিন্তু কাজের পরিকল্পনা সাধারণত এমনই হয়।"
              : "But you can stop losing the next three months. A narrow target, daily foundations, one project and feedback—the boring plan is the useful one."
          }
        </p><a
          class="text-link"
          href={withBase(
            lostChoices.find((choice) => choice.id === "behind")!.destination[
              locale
            ],
          )}>{bn ? "ঘুরে দাঁড়ানোর পথ দেখুন →" : "Open the recovery route →"}</a
        >
      </div>
    </div>
  </section>
  <script>
    import { trackImLostUsed } from "@/lib/analytics";
    const choices = [
      ...document.querySelectorAll<HTMLAnchorElement>("[data-lost-choice]"),
    ];
    const panel = document.querySelector<HTMLElement>("[data-lost-result]");
    const copy = panel?.querySelector<HTMLElement>("[data-result-copy]");
    const link = panel?.querySelector<HTMLAnchorElement>("[data-result-link]");
    choices.forEach((choice) =>
      choice.addEventListener("click", (event) => {
        event.preventDefault();
        choices.forEach((item) =>
          item.setAttribute("aria-expanded", String(item === choice)),
        );
        const title = panel?.querySelector<HTMLElement>("[data-result-title]");
        if (title) title.textContent = choice.dataset.title ?? "";
        if (copy) copy.textContent = choice.dataset.response ?? "";
        if (link) link.href = choice.dataset.destination ?? "#";
        if (panel) {
          panel.hidden = false;
          panel.focus();
        }
        const url = new URL(window.location.href);
        url.hash = choice.dataset.lostChoice ?? "";
        history.replaceState({}, "", url);
        trackImLostUsed(choice.dataset.lostChoice ?? "unknown");
      }),
    );
    document
      .querySelector<HTMLButtonElement>("[data-lost-reset]")
      ?.addEventListener("click", () => {
        if (panel) panel.hidden = true;
        choices.forEach((item) => item.setAttribute("aria-expanded", "false"));
        const url = new URL(window.location.href);
        url.hash = "";
        history.replaceState({}, "", url);
        choices[0]?.focus();
      });
    const initial = window.location.hash.slice(1);
    if (initial)
      choices.find((item) => item.dataset.lostChoice === initial)?.click();
  </script>
</BaseLayout>
<style>
  .lost-shell {
    display: grid;
    gap: 2rem;
  }
  .reveal-panel {
    align-self: start;
  }
  .reset {
    display: block;
    min-height: 2.75rem;
    margin-top: 1rem;
    border: 0;
    background: transparent;
    color: var(--color-primary-strong);
    font-weight: 700;
    text-decoration: underline;
    cursor: pointer;
  }
  .choice {
    display: block;
    color: var(--color-text);
    font-weight: 700;
    text-decoration: none;
  }
  @media (min-width: 56rem) {
    .lost-shell {
      grid-template-columns: minmax(0, 1.2fr) minmax(20rem, 0.8fr);
    }
    .lost-shell:has(.reveal-panel[hidden]) {
      grid-template-columns: 1fr;
    }
    .lost-shell:has(.reveal-panel[hidden]) .choice-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .choice-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
