---
import Breadcrumbs from "@/components/common/Breadcrumbs.astro";
import DirectoryJumpNav from "@/components/common/DirectoryJumpNav.astro";
import IndustryVoices from "@/components/common/IndustryVoices.astro";
import ResourceList from "@/components/common/ResourceList.astro";
import { localePath, siteConfig, withBase } from "@/config/site";
import { collaborators, inspirations } from "@/data/credits";
import { sitePurpose } from "@/data/homepage";
import { industryVoices } from "@/data/industry-voices";
import { resources } from "@/data/resources";
import { t } from "@/lib/i18n";
import { collectionStructuredData } from "@/lib/seo";
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { LearningResource, Locale } from "@/types/content";
type Kind = "resources" | "privacy" | "about";
interface Props {
  locale: Locale;
  kind: Kind;
}
const { locale, kind } = Astro.props;
const bn = locale === "bn";
const metadata = {
  resources: {
    title: bn
      ? "Curated Free Learning Resources"
      : "Curated Free Learning Resources",
    description: bn
      ? "বাংলাদেশের tech leader, practitioner ও educator-দের সাজানো watchlist এবং CSE-Pothik-এর রোডম্যাপে ব্যবহৃত বাছাই করা বিনামূল্যের শেখার রিসোর্স।"
      : "An ordered watchlist of Bangladesh tech leaders, practitioners and educators plus carefully selected free learning resources used across CSE-Pothik roadmaps.",
  },
  privacy: {
    title: bn ? "গোপনীয়তা ও Analytics" : "Privacy & Analytics",
    description: bn
      ? "CSE-Pothik কোনো account, profile বা progress জমা রাখে না। Aggregate GA4 analytics, browser-এ রাখা preference আর ইচ্ছা হলে ব্যবহার করা বাইরের feedback form কীভাবে কাজ করে, তা জানো।"
      : "Learn how CSE-Pothik uses aggregate GA4 analytics, local preferences and an optional external feedback form without accounts, profiles or progress tracking.",
  },
  about: {
    title: bn ? "CSE-Pothik সম্পর্কে ও কৃতজ্ঞতা" : "About CSE-Pothik & Credits",
    description: bn
      ? "CSE-তে ভর্তি হওয়ার পর পথ হারিয়ে ফেলা থেকে শুরু করে নিজের পরের বাস্তব পদক্ষেপ খুঁজে পাওয়া—CSE-Pothik কেন তৈরি হয়েছে এবং কারা কীভাবে এটি গড়ে তুলেছে, সেই গল্প।"
      : "Why CSE-Pothik exists: the gap between entering CSE and finding direction, the practical way back, its inspiration, and the human and AI roles behind it.",
  },
}[kind];
const resourceGroupDefinitions: Array<{
  id: string;
  title: string;
  description: string;
  types: LearningResource["type"][];
}> = [
  {
    id: "official-reference",
    title: bn ? "অফিশিয়াল documentation" : "Official documentation",
    description: bn
      ? "Tool, platform আর standard সম্পর্কে হালনাগাদ primary reference।"
      : "Maintained primary references for tools, platforms and standards.",
    types: ["official-docs"],
  },
  {
    id: "courses-university",
    title: bn
      ? "Course ও university material"
      : "Courses & university material",
    description: bn
      ? "ভিত্তি তৈরি বা ধাপে ধাপে শেখার জন্য সাজানো material।"
      : "Structured learning material for foundations and guided sequences.",
    types: ["course", "university"],
  },
  {
    id: "labs-practice",
    title: bn ? "ল্যাব ও হাতে-কলমে অনুশীলন" : "Labs & practice",
    description: bn
      ? "পড়া জ্ঞানকে ছোট ও নিরাপদ evidence-এ বদলানোর জায়গা।"
      : "Places to turn reading into small, safe evidence.",
    types: ["lab", "practice"],
  },
  {
    id: "books-articles",
    title: bn ? "বই ও বাছাই করা লেখা" : "Books & focused articles",
    description: bn
      ? "Context, গভীরভাবে ভাবা বা নির্দিষ্ট topic বোঝার জন্য সীমিত ও বাছাই করা পড়া।"
      : "Carefully scoped reading for context, deeper reasoning or a focused topic.",
    types: ["book", "article"],
  },
];
const resourceGroups = resourceGroupDefinitions.map((group) => ({
  ...group,
  resources: resources.filter((resource) =>
    group.types.includes(resource.type),
  ),
}));
const structuredData =
  kind === "resources"
    ? collectionStructuredData({
        title: metadata.title,
        description: metadata.description,
        url: Astro.url.href,
        locale,
        homeUrl: new URL(withBase(localePath(locale, "/")), Astro.site).href,
        homeLabel: bn ? "হোম" : "Home",
        items: [
          ...industryVoices.map((voice) => ({
            name: t(voice.title, locale),
            url: `${Astro.url.href}#industry-voice-${voice.id}`,
          })),
          ...resources.map((resource) => ({
            name: resource.title,
            url: `${Astro.url.href}#resource-${resource.id}`,
          })),
        ],
      })
    : undefined;
---

<BaseLayout
  locale={locale}
  title={metadata.title}
  description={metadata.description}
  structuredData={structuredData}
>
  <Breadcrumbs locale={locale} items={[{ label: metadata.title }]} />
  {
    kind === "resources" && (
      <>
        <header class="page-hero page-hero--compact container">
          <>
            <p class="eyebrow">
              {bn ? "সংখ্যা নয়, মানটাই আসল" : "Quality over quantity"}
            </p>
            <h1>
              {bn
                ? "Resource-এর গুদাম নয়—বাছাই করা শুরুর জায়গা।"
                : "Not a resource directory. Curated starting points."}
            </h1>
            <p class="lede">
              {bn
                ? "রোডম্যাপে context-সহ resource ব্যবহার করাই সবচেয়ে কাজে দেয়। এই তালিকায় resource কেন বাছা হয়েছে, কতটুকু পড়বে আর কবে যাচাই করা হয়েছে—সব এক জায়গায় দেখা যায়।"
                : "Resources work best in roadmap context. This index lets students and maintainers inspect selection, scope and review dates in one place."}
            </p>
          </>
        </header>
        <section
          class="section section--tinted"
          id="industry-voices"
          aria-label={
            bn
              ? "বাংলাদেশের tech leaders ও practitioners"
              : "Bangladesh tech leaders and practitioners"
          }
        >
          <div class="container">
            <IndustryVoices locale={locale} />
          </div>
        </section>
        <section class="section resource-orientation">
          <div class="container">
            <>
              <div class="callout">
                <>
                  <p class="callout__label">
                    {bn ? "যেভাবে ব্যবহার করবে" : "Use the pattern"}
                  </p>
                  <h2>Learn → Practice → Go deeper (optional)</h2>
                  <p>
                    {bn
                      ? "একটি primary resource-এর দরকারি অংশ শেষ করো, কিছু বানাও, তারপর আরও গভীর resource সত্যিই দরকার কি না দেখো।"
                      : "Finish the recommended scope of one primary resource, build something, then decide whether deeper material is needed."}
                  </p>
                </>
              </div>
              <div class="button-row">
                <a
                  class="button"
                  href={withBase(localePath(locale, "/roadmaps/"))}
                >
                  {bn
                    ? "রোডম্যাপ থেকে resource বেছে নিই"
                    : "Choose resources through a roadmap"}
                </a>
                <a class="button button--secondary" href="#site-search-input">
                  {bn ? "নির্দিষ্ট topic খুঁজি" : "Search for a specific topic"}
                </a>
              </div>
            </>
          </div>
        </section>
        <DirectoryJumpNav
          eyebrow={bn ? "রিসোর্সের ধরন বেছে নাও" : "Jump by resource type"}
          label={bn ? "রিসোর্সের ধরন" : "Resource type index"}
          items={resourceGroups.map((group) => ({
            id: group.id,
            label: group.title,
            count: group.resources.length,
          }))}
        />
        {resourceGroups.map((group, index) => (
          <section
            class:list={[
              "section",
              "directory-target",
              { "section--tinted": index % 2 === 1 },
            ]}
            id={group.id}
          >
            <div class="container">
              <div class="resource-group-heading">
                <p class="eyebrow">
                  {group.resources.length}{" "}
                  {bn ? "টি বাছাই করা resource" : "curated resources"}
                </p>
                <h2>{group.title}</h2>
                <p class="lede">{group.description}</p>
              </div>
              <div class="resource-index">
                <ResourceList
                  locale={locale}
                  resourceIds={group.resources.map((resource) => resource.id)}
                  directory
                />
              </div>
            </div>
          </section>
        ))}
      </>
    )
  }
  {
    kind === "privacy" && (
      <>
        <header class="page-hero container">
          <>
            <p class="eyebrow">
              {bn
                ? "Privacy-conscious by design"
                : "Privacy-conscious by design"}
            </p>
            <h1>
              {bn
                ? "এই mentoring experience-এ কোনো account বা profile নেই।"
                : "No account or profile sits behind the mentoring experience."}
            </h1>
            <p class="lede">
              {bn
                ? "CSE-Pothik একটি static site। এখানে account, roadmap progress বা career score জমা রাখা হয় না। আলাদা Google feedback form-টি কেবল তুমি নিজে খুলে উত্তর পাঠাতে চাইলে ব্যবহার হবে।"
                : "CSE-Pothik is static. It stores no account, roadmap progress or career score. The separate Google feedback form is used only if you choose to open it and submit a response."}
            </p>
          </>
        </header>
        <section class="section section--tinted">
          <div class="container policy">
            <>
              <article>
                <>
                  <h2>
                    {bn
                      ? "এই device-এ যা রাখা হতে পারে"
                      : "What may stay on this device"}
                  </h2>
                  <p>
                    {bn
                      ? "Theme (light/dark) আর ভাষার preference browser-এর localStorage-এ রাখা হতে পারে। এটি profile বা progress নয়; browser settings থেকে মুছে দেওয়া যায়।"
                      : "Theme (light/dark) and language preferences may be stored in browser localStorage. They are not a profile or progress and can be cleared in browser settings."}
                  </p>
                </>
              </article>
              <article>
                <>
                  <h2>
                    {bn ? "সামগ্রিক ব্যবহারের তথ্য" : "Aggregate analytics"}
                  </h2>
                  <p>
                    {bn
                      ? "Production site-এ GA4 দিয়ে page ও product interaction-এর aggregate event পাঠানো হয়—যেমন language switch, career view, experiment start আর resource click। Search query, form-এর উত্তর বা free text analytics-এ পাঠানো হয় না। Local/test build-এ ID না থাকলে analytics load হয় না।"
                      : "The production site uses GA4 for aggregate page and product-interaction events, such as language switching, career views, experiment starts and resource clicks. Search queries, form responses and free text are not sent to analytics. Analytics does not load in local/test builds without an ID."}
                  </p>
                </>
              </article>
              <article>
                <>
                  <h2>
                    {bn
                      ? "যে তথ্য ইচ্ছা করেই পাঠাই না"
                      : "What we intentionally do not send"}
                  </h2>
                  <ul>
                    <>
                      <li>
                        {bn ? "নাম বা email" : "Names or email addresses"}
                      </li>
                      <li>
                        {bn
                          ? "Free-form student answer"
                          : "Free-form student answers"}
                      </li>
                      <li>
                        {bn
                          ? "ব্যক্তিগত learning profile বা লুকানো user ID"
                          : "Personal learning profiles or hidden user IDs"}
                      </li>
                      <li>
                        {bn
                          ? "রোডম্যাপ progress, streak বা assessment history"
                          : "Roadmap progress, streaks or assessment history"}
                      </li>
                    </>
                  </ul>
                </>
              </article>
              <article>
                <>
                  <h2>
                    {bn
                      ? "বাইরের রিসোর্স ও feedback form"
                      : "External resources and feedback form"}
                  </h2>
                  <p>
                    {bn
                      ? "Learning-resource link বা Google feedback form খুললে সেই provider-এর privacy policy প্রযোজ্য। Feedback form-এ তুমি যা লিখে submit করবে, সেটি Google Forms-এর মাধ্যমে যাবে; শুধু link দেখলেই কোনো উত্তর পাঠানো হয় না। CSE-Pothik resource ID/provider বা feedback-link click গুনতে পারে, কিন্তু URL query, form response বা তোমার free text analytics-এ পাঠায় না।"
                      : "When you open a learning resource or the Google feedback form, that provider’s privacy policy applies. Anything you choose to enter and submit in the form is handled through Google Forms; merely seeing the link submits nothing. CSE-Pothik may count a resource or feedback-link click, but it does not send URL queries, form responses or your free text to analytics."}
                  </p>
                </>
              </article>
            </>
          </div>
        </section>
      </>
    )
  }
  {
    kind === "about" && (
      <>
        <header class="page-hero container">
          <>
            <p class="eyebrow">
              {bn ? "CSE-তে নিজের পথ খুঁজে নাও" : siteConfig.tagline}
            </p>
            <h1>
              {bn
                ? "CSE-তে পথ অনেক। নিজের পথটি বুঝে শুরু করাই কঠিন।"
                : "A practical career guide for CSE students."}
            </h1>
            <p class="lede">
              {bn
                ? "প্রথম semester-এ হোক বা graduation-এর ঠিক আগে—CSE-Pothik তোমাকে কাজের জগৎটা বুঝতে, ছোট করে যাচাই করতে এবং এখন সত্যিই কাজে লাগবে এমন একটি পরের ধাপ বেছে নিতে সাহায্য করে।"
                : "CSE-Pothik helps students—from freshers to final year—understand the landscape, try real work, avoid common mistakes and take a meaningful next step in the AI era."}
            </p>
            <div class="about-actions">
              <a class="button" href="#why-this-exists">
                {bn ? "কেন এই সাইট" : "Read why this exists"}
              </a>
              <a class="button button--secondary" href="#credits">
                {bn
                  ? "অনুপ্রেরণা ও নির্মাণের গল্প"
                  : "Inspiration & how this was built"}
              </a>
            </div>
          </>
        </header>
        <section
          class="section section--tinted"
          id="why-this-exists"
          aria-labelledby="why-title"
        >
          <div class="container origin-story">
            <div class="origin-heading">
              <p class="eyebrow">{bn ? "এই সাইট কেন" : "Why this exists"}</p>
              <h2 id="why-title">
                {bn
                  ? "সমস্যা মেধার নয়; শুরুতেই কাজের মানচিত্রটা না পাওয়ার।"
                  : "The difficult part is the gap between admission and direction."}
              </h2>
            </div>
            <div class="origin-narrative">
              <p>{t(sitePurpose.premise, locale)}</p>
              <p>{t(sitePurpose.drift, locale)}</p>
              <p class="recovery-note">
                <strong>{t(sitePurpose.recovery, locale)}</strong>
              </p>
            </div>
            <ol class="story-arc" role="list">
              {[
                [
                  bn ? "আকর্ষণ" : "Attraction",
                  bn
                    ? "জনপ্রিয়তা, আয়ের সম্ভাবনা, বিদেশে কাজের আশা।"
                    : "Popularity, earning potential and opportunities abroad.",
                ],
                [
                  bn ? "শুরুতে দিকনির্দেশনার ঘাটতি" : "Orientation gap",
                  bn
                    ? "ক্ষেত্রটি কত বড় আর আসল কাজ কী—দুটোই পরিষ্কার নয়।"
                    : "The breadth of the field and its real work stay unclear.",
                ],
                [
                  bn ? "শেষ মুহূর্তে উত্তর খোঁজা" : "The urgent search",
                  bn
                    ? "Graduation সামনে; social-media group-এ প্রশ্ন—‘এখন কী শিখব?’"
                    : "Graduation approaches; the question becomes, “What should I learn now?”",
                ],
                [
                  bn ? "ঘুরে দাঁড়ানোর পরের ধাপ" : "A practical recovery",
                  bn
                    ? "Noise থামাও, একটি পথ বোঝো, ছোট evidence বানিয়ে এগোও।"
                    : "Stop the noise, understand one route and build a small piece of evidence.",
                ],
              ].map(([title, description], index) => (
                <li>
                  <span aria-hidden="true">0{index + 1}</span>
                  <strong>{title}</strong>
                  <small>{description}</small>
                </li>
              ))}
            </ol>
            <div class="purpose-goals">
              <article>
                <p class="eyebrow">{bn ? "কেন এই সাইট" : "Purpose"}</p>
                <h3>{t(sitePurpose.purpose, locale)}</h3>
              </article>
              <article>
                <p class="eyebrow">{bn ? "আমাদের লক্ষ্য" : "Goal"}</p>
                <h3>{t(sitePurpose.goal, locale)}</h3>
              </article>
            </div>
            <p class="orientation-use">
              {bn
                ? "একজন student নিজে ব্যবহার করুক বা orientation class-এ guide হিসেবে দেখানো হোক—লক্ষ্য একটাই: বিভ্রান্তি জমে ওঠার আগেই পরের কাজটি চোখে দেখা। আর দেরিতে এলে, ‘সব শেষ’ না ভেবে সেখান থেকেই গুছিয়ে শুরু করা।"
                : "Whether a student uses it independently or an educator uses it during orientation, the aim is the same: make one useful next step visible before confusion compounds."}
            </p>
          </div>
        </section>
        <section class="section">
          <div class="container editorial-grid">
            <>
              <div>
                <>
                  <p class="eyebrow">{bn ? "এটি কী" : "What this is"}</p>
                  <h2>
                    {bn
                      ? "Orientation publication + practical mentor"
                      : "Orientation publication + practical mentor"}
                  </h2>
                  <p>
                    {bn
                      ? "ক্যারিয়ার বিভাগ, বিস্তারিত গাইড, তুলনা, experiment, রোডম্যাপ, AI-এর প্রভাব আর recovery route—সব static, বিনামূল্যে এবং account ছাড়াই।"
                      : "Career families, detailed guides, comparisons, experiments, roadmaps, AI exposure and recovery routes—static, free and usable without an account."}
                  </p>
                </>
              </div>
              <div>
                <>
                  <p class="eyebrow">{bn ? "এটি যা নয়" : "What this is not"}</p>
                  <h2>
                    {bn
                      ? "এটি LMS, job board বা prediction machine নয়"
                      : "Not an LMS, job board or prediction machine"}
                  </h2>
                  <p>
                    {bn
                      ? "কোনো certificate, job promise, personality score, AI-proof claim, progress dashboard বা paid learning funnel নেই।"
                      : "There are no certificates, job promises, personality scores, AI-proof claims, progress dashboards or paid-learning funnels."}
                  </p>
                </>
              </div>
            </>
          </div>
        </section>
        <section class="section" id="credits" aria-labelledby="credits-title">
          <div class="container credits-intro">
            <p class="eyebrow">{bn ? "কৃতজ্ঞতা" : "With thanks"}</p>
            <h2 id="credits-title">
              {bn ? "অনুপ্রেরণা ও সহযোগিতা" : "Inspiration & collaboration"}
            </h2>
            <p class="lede">
              {bn
