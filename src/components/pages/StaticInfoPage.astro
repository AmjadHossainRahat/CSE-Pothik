---
import Breadcrumbs from "@/components/common/Breadcrumbs.astro";
import ResourceList from "@/components/common/ResourceList.astro";
import { siteConfig } from "@/config/site";
import { collaborators, inspirations } from "@/data/credits";
import { resources } from "@/data/resources";
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { Locale } from "@/types/content";
type Kind = "resources" | "privacy" | "about";
interface Props {
  locale: Locale;
  kind: Kind;
}
const { locale, kind } = Astro.props;
const bn = locale === "bn";
const metadata = {
  resources: {
    title: bn
      ? "Curated Free Learning Resources"
      : "Curated Free Learning Resources",
    description: bn
      ? "CSE Compass roadmap-এ ব্যবহৃত carefully selected free official docs, university course, lab, book আর practice resource।"
      : "Carefully selected free official documentation, university courses, labs, books and practice resources used across CSE Compass roadmaps.",
  },
  privacy: {
    title: bn ? "Privacy ও Analytics" : "Privacy & Analytics",
    description: bn
      ? "CSE Compass account, profile বা progress collect করে না; optional aggregate GA4 analytics আর local preference কীভাবে কাজ করে জানো।"
      : "Learn how CSE Compass uses optional aggregate GA4 analytics and local preferences without accounts, profiles or progress tracking.",
  },
  about: {
    title: bn
      ? "CSE Compass সম্পর্কে ও কৃতজ্ঞতা"
      : "About CSE Compass & Credits",
    description: bn
      ? "CSE Compass-এর উদ্দেশ্য, roadmap.sh ও Architect Prep-এর অনুপ্রেরণা এবং উদ্যোক্তা, ChatGPT ও Codex-এর ভূমিকা জানো।"
      : "The purpose of CSE Compass, inspiration from roadmap.sh and Architect Prep, and the roles of its creator, ChatGPT and Codex.",
  },
}[kind];
---

<BaseLayout
  locale={locale}
  title={metadata.title}
  description={metadata.description}
>
  <Breadcrumbs locale={locale} items={[{ label: metadata.title }]} />
  {
    kind === "resources" && (
      <>
        <header class="page-hero container">
          <>
            <p class="eyebrow">
              {bn ? "Quality over quantity" : "Quality over quantity"}
            </p>
            <h1>
              {bn
                ? "Resource directory না। Curated starting points।"
                : "Not a resource directory. Curated starting points."}
            </h1>
            <p class="lede">
              {bn
                ? "Roadmap-এ contextসহ resource ব্যবহার করাই best। এই index maintainers আর students-কে selection, scope আর review date এক জায়গায় দেখতে দেয়।"
                : "Resources work best in roadmap context. This index lets students and maintainers inspect selection, scope and review dates in one place."}
            </p>
          </>
        </header>
        <section class="section section--tinted">
          <div class="container">
            <>
              <div class="callout">
                <>
                  <p class="callout__label">
                    {bn ? "Use the pattern" : "Use the pattern"}
                  </p>
                  <h2>Learn → Practice → Go deeper (optional)</h2>
                  <p>
                    {bn
                      ? "একটি primary resource-এর recommended scope শেষ করো, কিছু build করো, তারপর deeper resource দরকার কি না দেখো।"
                      : "Finish the recommended scope of one primary resource, build something, then decide whether deeper material is needed."}
                  </p>
                </>
              </div>
              <div class="resource-index">
                <ResourceList
                  locale={locale}
                  resourceIds={resources.map((resource) => resource.id)}
                />
              </div>
            </>
          </div>
        </section>
      </>
    )
  }
  {
    kind === "privacy" && (
      <>
        <header class="page-hero container">
          <>
            <p class="eyebrow">
              {bn
                ? "Privacy-conscious by design"
                : "Privacy-conscious by design"}
            </p>
            <h1>
              {bn
                ? "Mentoring experience-এ কোনো account বা profile নেই।"
                : "No account or profile sits behind the mentoring experience."}
            </h1>
            <p class="lede">
              {bn
                ? "CSE Compass static site। তোমার answer, roadmap progress, career score, email বা name collect করার form নেই।"
                : "CSE Compass is static. There is no form collecting your answers, roadmap progress, career score, email or name."}
            </p>
          </>
        </header>
        <section class="section section--tinted">
          <div class="container policy">
            <>
              <article>
                <>
                  <h2>
                    {bn
                      ? "এই device-এ যা থাকতে পারে"
                      : "What may stay on this device"}
                  </h2>
                  <p>
                    {bn
                      ? "Theme (light/dark) আর language preference browser localStorage-এ রাখা হতে পারে। এটা profile বা progress না; browser settings থেকে clear করা যায়।"
                      : "Theme (light/dark) and language preferences may be stored in browser localStorage. They are not a profile or progress and can be cleared in browser settings."}
                  </p>
                </>
              </article>
              <article>
                <>
                  <h2>{bn ? "Aggregate analytics" : "Aggregate analytics"}</h2>
                  <p>
                    {bn
                      ? "Production owner GA4 measurement ID configure করলে page ও product interaction-এর aggregate event পাঠানো হয়—যেমন language switch, career view, experiment start আর resource click। Local/test build-এ ID না থাকলে analytics load হয় না।"
                      : "If the production owner configures a GA4 measurement ID, aggregate page and product-interaction events are sent, such as language switching, career views, experiment starts and resource clicks. Analytics does not load in local/test builds without an ID."}
                  </p>
                </>
              </article>
              <article>
                <>
                  <h2>
                    {bn
                      ? "যা intentionally পাঠাই না"
                      : "What we intentionally do not send"}
                  </h2>
                  <ul>
                    <>
                      <li>
                        {bn ? "Name বা email" : "Names or email addresses"}
                      </li>
                      <li>
                        {bn
                          ? "Free-form student answer"
                          : "Free-form student answers"}
                      </li>
                      <li>
                        {bn
                          ? "Personal learning profile বা hidden user ID"
                          : "Personal learning profiles or hidden user IDs"}
                      </li>
                      <li>
                        {bn
                          ? "Roadmap progress, streak বা assessment history"
                          : "Roadmap progress, streaks or assessment history"}
                      </li>
                    </>
                  </ul>
                </>
              </article>
              <article>
                <>
                  <h2>{bn ? "External resources" : "External resources"}</h2>
                  <p>
                    {bn
                      ? "Learning-resource link খুললে সেই provider-এর privacy policy প্রযোজ্য। CSE Compass resource ID/provider দিয়ে click count করতে পারে; URL query বা তোমার free text পাঠায় না।"
                      : "When you open a learning resource, that provider’s privacy policy applies. CSE Compass may count the click using a resource ID/provider; it does not send URL queries or your free text."}
                  </p>
                </>
              </article>
            </>
          </div>
        </section>
      </>
    )
  }
  {
    kind === "about" && (
      <>
        <header class="page-hero container">
          <>
            <p class="eyebrow">{siteConfig.tagline}</p>
            <h1>
              {bn
                ? "CSE student-এর জন্য practical career compass।"
                : "A practical career compass for CSE students."}
            </h1>
            <p class="lede">
              {bn
                ? "CSE Compass fresher থেকে final-year student-কে landscape বুঝতে, real কাজ try করতে, common mistake এড়াতে আর AI era-তে next meaningful step নিতে সাহায্য করে।"
                : "CSE Compass helps students—from freshers to final year—understand the landscape, try real work, avoid common mistakes and take a meaningful next step in the AI era."}
            </p>
            <a class="button button--secondary" href="#credits">
              {bn
                ? "অনুপ্রেরণা ও নির্মাণের গল্প"
                : "Inspiration & how this was built"}
            </a>
          </>
        </header>
        <section class="section section--tinted">
          <div class="container editorial-grid">
            <>
              <div>
                <>
                  <p class="eyebrow">{bn ? "What this is" : "What this is"}</p>
                  <h2>
                    {bn
                      ? "Orientation publication + practical mentor"
                      : "Orientation publication + practical mentor"}
                  </h2>
                  <p>
                    {bn
                      ? "Career family, detailed guide, comparison, experiment, roadmap, AI exposure আর recovery route—সব static, free এবং account ছাড়াই।"
                      : "Career families, detailed guides, comparisons, experiments, roadmaps, AI exposure and recovery routes—static, free and usable without an account."}
                  </p>
                </>
              </div>
              <div>
                <>
                  <p class="eyebrow">
                    {bn ? "What this is not" : "What this is not"}
                  </p>
                  <h2>
                    {bn
                      ? "LMS, job board বা prediction machine না"
                      : "Not an LMS, job board or prediction machine"}
                  </h2>
                  <p>
                    {bn
                      ? "কোনো certificate, job promise, personality score, AI-proof claim, progress dashboard বা paid learning funnel নেই।"
                      : "There are no certificates, job promises, personality scores, AI-proof claims, progress dashboards or paid-learning funnels."}
                  </p>
                </>
              </div>
            </>
          </div>
        </section>
        <section class="section" id="credits" aria-labelledby="credits-title">
          <div class="container credits-intro">
            <p class="eyebrow">{bn ? "কৃতজ্ঞতা" : "With thanks"}</p>
            <h2 id="credits-title">
              {bn ? "অনুপ্রেরণা ও সহযোগিতা" : "Inspiration & collaboration"}
            </h2>
            <p class="lede">
              {bn
                ? "একজন মানুষের উদ্যোগ ও পরিচালনা, অনুপ্রেরণাদায়ী community project আর AI-এর সহযোগিতায় তৈরি। প্রত্যেকের ভূমিকা আলাদা।"
                : "Human-led, inspired by community projects and built with AI assistance. Each contribution has a different role."}
            </p>
          </div>
          <div class="container editorial-grid">
            <>
              <div>
                <>
                  <h3>
                    {bn
                      ? "Principle নেওয়া, content copy নয়"
                      : "Principles, never copied content"}
                  </h3>
                  <p>
                    {bn
                      ? "roadmap.sh-এর structured role/skill navigation আর Architect Prep-এর focused technical navigation conceptually inspire করেছে। Visual system, copy, roadmap আর mentoring model original।"
                      : "The structured role/skill navigation of roadmap.sh and focused technical navigation of Architect Prep offered conceptual inspiration. The visual system, copy, roadmaps and mentoring model are original."}
                  </p>
                  <ul class="inspiration-list" role="list">
                    {inspirations.map((source) => (
                      <li>
                        <a
                          class="text-link"
                          href={source.url}
                          rel="noopener noreferrer"
                        >
                          {source.name} <span aria-hidden="true">↗</span>
                        </a>
                        <p>{source.contribution[locale]}</p>
                      </li>
                    ))}
                  </ul>
                  <p class="muted">
                    {bn
                      ? "এটি কৃতজ্ঞতা প্রকাশ, কোনো আনুষ্ঠানিক সম্পর্ক বা endorsement-এর দাবি নয়। নামগুলোর মালিকানা সংশ্লিষ্ট প্রতিষ্ঠান ও প্রকল্পের।"
                      : "These acknowledgments do not imply affiliation or endorsement. Names belong to their respective owners."}
                  </p>
                </>
              </div>
              <div>
                <>
                  <h3>
                    {bn ? "যেভাবে সাইটটি তৈরি হয়েছে" : "How this was built"}
                  </h3>
                  <dl class="collaboration-list">
                    {collaborators.map((person) => (
                      <div>
                        <dt>
                          <strong>{person.name}</strong>
                          <span>{person.role[locale]}</span>
                        </dt>
                        <dd>{person.contribution[locale]}</dd>
                      </div>
                    ))}
                  </dl>
                  <p>
                    {bn
                      ? "Repository MIT License-এর অধীনে। Student-facing resource free ও accessible রাখার community philosophy-কে সম্মান করা encouraged।"
                      : "The repository is MIT licensed. Contributors are encouraged to honor the community philosophy of keeping student-facing resources free and accessible."}
                  </p>
                </>
              </div>
            </>
          </div>
        </section>
      </>
    )
  }
</BaseLayout>
<style>
  .credits-intro {
    margin-bottom: 2.5rem;
  }
  .inspiration-list {
    margin: 1.5rem 0;
    padding: 0;
    list-style: none;
  }
  .collaboration-list > div {
    padding-block: 1rem;
    border-bottom: 1px solid var(--color-border);
  }
  .collaboration-list > div:first-child {
    padding-top: 0;
  }
  .collaboration-list dt span {
    display: block;
    color: var(--color-primary-strong);
    font-size: 0.92rem;
    font-weight: 700;
  }
  .collaboration-list dd {
    margin: 0.5rem 0 0;
  }
  .resource-index {
    margin-top: 3rem;
  }
  .policy {
    display: grid;
    gap: 2rem;
  }
  .policy article {
    padding-top: 1rem;
    border-top: 3px solid var(--color-primary);
  }
  @media (min-width: 48rem) {
    .policy {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
