---
import Breadcrumbs from "@/components/common/Breadcrumbs.astro";
import ResourceList from "@/components/common/ResourceList.astro";
import { localePath, withBase } from "@/config/site";
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { Locale } from "@/types/content";
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const bn = locale === "bn";
const levels = bn
  ? [
      [
        "Level 1 · Computational Foundation",
        "প্রায় সব CSE শিক্ষার্থীর জন্য। Array, string, recursion, sorting, search, complexity আর নিয়মিত problem solving।",
      ],
      [
        "Level 2 · Algorithmic Competence",
        "Stronger DSA, graph, dynamic programming আর interview/relevant career-এর জন্য deliberate practice।",
      ],
      [
        "Level 3 · Competitive Track",
        "যারা competition সত্যিই enjoy করে বা ICPC-level practice চায়। এটি সবার default গন্তব্য নয়।",
      ],
    ]
  : [
      [
        "Level 1 · Computational Foundation",
        "Useful for nearly every CSE student: arrays, strings, recursion, sorting, search, complexity and regular problem solving.",
      ],
      [
        "Level 2 · Algorithmic Competence",
        "Stronger DSA, graphs, dynamic programming and deliberate practice for relevant careers and interviews.",
      ],
      [
        "Level 3 · Competitive Track",
        "For students who genuinely enjoy competition or want ICPC-level practice. It is not everyone’s default destination.",
      ],
    ];
const practiceLoop = bn
  ? [
      [
        "01 · Learn one idea",
        "একটি language-এ foundation topic বোঝো। Example হাতে ধরে trace করো; code মুখস্থ কোরো না।",
      ],
      [
        "02 · Attempt honestly",
        "সহজ problem দিয়ে শুরু করো। আগে model, input-output, edge case আর complexity লেখো; আটকে গেলেও নিজের চেষ্টা মুছে ফেলো না।",
      ],
      [
        "03 · Submit, debug, log",
        "Online judge feedback evidence হিসেবে নাও। Wrong answer-এর counterexample আর accepted solution-এর complexity log করো।",
      ],
      [
        "04 · Review and transfer",
        "Editorial বা Bangla explanation পরে পড়ো। solution নিজের ভাষায় বোঝাও, তারপর একই idea অন্য problem-এ কাজে লাগাও। সপ্তাহে real project-এর সময়ও রেখো।",
      ],
    ]
  : [
      [
        "01 · Learn one idea",
        "Understand one foundation topic in one language. Trace examples; do not memorize code.",
      ],
      [
        "02 · Attempt honestly",
        "Start with an approachable problem. Write the model, inputs, edge cases and complexity first; preserve your own attempt even when stuck.",
      ],
      [
        "03 · Submit, debug, log",
        "Use online-judge feedback as evidence. Record a counterexample for wrong answers and the complexity of an accepted solution.",
      ],
      [
        "04 · Review and transfer",
        "Read an editorial or Bangla explanation afterward, explain the solution in your own words, then apply the idea to a changed problem. Keep a real project in the week, too.",
      ],
    ];
---

<BaseLayout
  locale={locale}
  title={bn
    ? "Competitive Programming / ACM / ICPC Guide"
    : "Competitive Programming, ACM & ICPC Guide"}
  description={bn
    ? "Competitive programming-কে computational thinking-এর gym হিসেবে ব্যবহার করো—পুরো ক্যারিয়ার কিংবা সবার জন্য একই রাস্তা হিসেবে নয়।"
    : "Use competitive programming as a gym for computational thinking—not the whole sport or the same track for every CSE student."}
>
  <Breadcrumbs
    locale={locale}
    items={[
      { label: bn ? "দিকনির্দেশনা" : "Guidance" },
      { label: "ACM / ICPC" },
    ]}
  />
  <header class="page-hero container">
    <p class="eyebrow">ACM · ICPC · Problem solving</p><h1>
      {
        bn
          ? "Computational thinking-এর gym—পুরো খেলাটা নয়।"
          : "A gym for computational thinking. Not the whole sport."
      }
    </h1><p class="lede">
      {
        bn
          ? "Competitive programming decomposition, algorithm, complexity, edge case আর precision গড়ে। কিন্তু real software, collaboration, deployment, accessibility বা user-এর সমস্যা নিজে থেকে শেখায় না।"
          : "Competitive programming builds decomposition, algorithms, complexity, edge-case analysis and precision. It does not automatically teach real software, collaboration, deployment, accessibility or user problems."
      }
    </p>
  </header>
  <section class="section section--tinted">
    <div class="container editorial-grid">
      <div>
        <p class="eyebrow">
          {bn ? "যে দক্ষতাগুলো গড়ে" : "What it develops"}
        </p><h2>
          {
            bn
              ? "স্পষ্ট নিয়মের মধ্যে যুক্তি খাটানো"
              : "Reasoning under clear rules"
          }
        </h2><ul class="rule-list">
          {
            (bn
              ? [
                  "Problem decomposition",
                  "Data structure ও algorithm",
                  "Complexity reasoning",
                  "Mathematical thinking",
                  "Edge-case analysis",
                  "Debugging ও precision",
                ]
              : [
                  "Problem decomposition",
                  "Data structures and algorithms",
                  "Complexity reasoning",
                  "Mathematical thinking",
                  "Edge-case analysis",
                  "Debugging and precision",
                ]
            ).map((item) => <li>{item}</li>)
          }
        </ul>
      </div><div class="callout callout--warm">
        <p class="callout__label">{bn ? "বাস্তব কথাটা" : "Reality check"}</p><p>
          {
            bn
              ? "Online judge-এ accepted solution production-ready software-এর certificate নয়। test pass করেছে; maintainability, security, usability আর team fit এখনও খোলা প্রশ্ন।"
              : "An accepted online-judge solution is not a certificate of production-ready engineering. It passed tests; maintainability, security, usability and team fit remain open questions."
          }
        </p>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">
            {bn ? "কাজের তিনটি স্তর" : "Three useful levels"}
          </p><h2>
            {bn ? "লক্ষ্য অনুযায়ী কতটা গভীরে যাবে" : "Choose depth by goal"}
          </h2>
        </div><p class="lede">
          {
            bn
              ? "Advanced competitor না হওয়া failure নয়। Level 1 মজবুত করে project-এর সঙ্গে মিলিয়ে নেওয়া অনেক ক্যারিয়ারের জন্য দারুণ পথ।"
              : "Not becoming an advanced competitor is not failure. A strong Level 1 combined with projects is excellent for many careers."
          }
        </p>
      </div><div class="level-list">
        {
          levels.map(([title, copy], index) => (
            <article>
              <>
                <span>0{index + 1}</span>
                <h3>{title}</h3>
                <p>{copy}</p>
              </>
            </article>
          ))
        }
      </div>
    </div>
  </section>
  <section class="section entry-bridge" id="industry-entry">
    <div class="container editorial-grid">
      <div>
        <p class="eyebrow">
          {bn ? "চাকরির দরজায় এই skill" : "At the industry entrance"}
        </p>
        <h2>
          {
            bn
              ? "CP একটি শক্তিশালী দরজা খুলতে পারে—একমাত্র দরজা নয়।"
              : "CP can open a strong door—not the only door."
          }
        </h2>
      </div>
      <div class="entry-bridge__body">
        <p>
          {
            bn
              ? "দেশের কিছু entry-level hiring process-এ strong problem solving আর ভালো OOP-কে অনেক গুরুত্ব দেওয়া হয়। এই জায়গায় ভালো হলে target assessment যাচাই করে advantage-টি কাজে লাগাও—তার সঙ্গে project explanation, Git, testing ও debugging যোগ করো।"
              : "Some local entry-level hiring pipelines give strong problem solving and solid OOP substantial weight. If that is your strength, verify the target assessment and use the advantage—then add project explanation, Git, testing and debugging."
          }
        </p>
        <p>
          {
            bn
              ? "CP কম হলে নিজেকে বাতিল কোরো না। Bounded problem-solving foundation-এর সঙ্গে project, debugging, testing, UI/mobile work, QA বা অন্য role-specific evidence দিয়ে আলাদা route বানানো যায়। কোনটা এখন করবে আর কখন আবেদন শুরু করবে—তিনটি route পাশাপাশি দেখে নাও।"
              : "If CP is not your strength, do not self-reject. A bounded problem-solving foundation can grow alongside project, debugging, testing, UI/mobile, QA or other role-specific evidence. Compare three routes to see what to do now and when to apply."
          }
        </p>
        <a
          class="button"
          href={withBase(
            localePath(locale, "/guidance/first-software-role/#entry-routes"),
          )}
          data-track-event="next_step_clicked"
          data-track-param-destination="first-role/entry-routes"
          >{
            bn ? "আমার entry route বেছে নিই" : "Choose my industry-entry route"
          }</a
        >
      </div>
    </div>
  </section>
  <section class="section section--tinted">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">ACM programming · ICPC practice track</p><h2>
            {
              bn
                ? "ছয় সপ্তাহের deliberate practice loop"
                : "A six-week deliberate-practice loop"
            }
          </h2>
        </div><p class="lede">
          {
            bn
              ? "Topic list শেষ করার দৌড় নয়। নিজের সৎ চেষ্টা, feedback, debugging আর শেখা জিনিস অন্য problem-এ ব্যবহার—এই loop চালাও। শুরুতে সপ্তাহে বেছে নেওয়া ৪–৬টি problem-ই যথেষ্ট।"
              : "This is not a race to finish a topic list. Repeat honest attempts, feedback, debugging and transfer. Four to six carefully chosen problems a week is enough to begin."
          }
        </p>
      </div>
      <div class="practice-grid">
        {
          practiceLoop.map(([title, description]) => (
            <article>
              <h3>{title}</h3>
              <p>{description}</p>
            </article>
          ))
        }
      </div>
      <aside class="bangla-shelf">
        <div>
          <p class="callout__label">
            {bn ? "বাংলায় শুরু করার তাক" : "Bangla starting shelf"}
          </p><h3>
            {
              bn
                ? "বাংলায় বুঝে নাও, তারপর problem সমাধান করে প্রমাণ দাও।"
                : "Learn in Bangla, then prove it on a problem."
            }
          </h3><p>
            {
              bn
                ? "Shafaet's Planet-এর সাজানো algorithm notes আর Amirul Islam-এর Bangla লেখা থেকে প্রয়োজনমতো topic বেছে নাও। CSE Compass তাদের curriculum copy করে না; এগুলো complementary starting references।"
                : "Use Shafaet's Planet's structured algorithm notes and Amirul Islam's Bangla writing as topic-by-topic starting references. CSE Compass does not copy their curricula; these are complementary guides."
            }
          </p>
        </div>
        <ResourceList
          locale={locale}
          resourceIds={["shafaet-algorithms-bn", "amirul-programming-bn"]}
        />
      </aside>
    </div>
  </section>
  <section class="section">
    <div class="container editorial-grid">
      <div>
        <p class="eyebrow">
          {bn ? "AI-এর যুগে অনুশীলন" : "AI-era practice"}
        </p><h2>
          {
            bn
              ? "AI-free solve, AI-assisted review"
              : "AI-free solve, AI-assisted review"
          }
        </h2>
      </div><div>
        <article class="mode">
          <h3>
            {bn ? "AI ছাড়া Problem Solving" : "AI-Free Problem Solving"}
          </h3><p>
            {
              bn
                ? "Timer না থাকলেও চলে। আগে নিজে model, invariant, complexity আর edge case বের করো। foundation-এর চিন্তাটুকু ধার কোরো না।"
                : "No timer required. First derive the model, invariant, complexity and edge cases yourself. Do not borrow foundational reasoning."
            }
          </p>
        </article><article class="mode">
          <h3>{bn ? "AI-এর সাহায্যে Review" : "AI-Assisted Review"}</h3><p>
            {
              bn
                ? "AI-এর solution-এ bug খোঁজো, complexity-এর সমস্যা ধরো, counterexample বানাও, বিকল্প মিলিয়ে দেখো। নিজের ভাষায় বোঝাতে না পারলে solution-টি এখনও তোমার নয়।"
                : "Find a bug in an AI-generated solution, identify the complexity problem, construct a counterexample and compare alternatives. If you cannot explain it, it is not yet your solution."
            }
          </p>
        </article>
      </div>
    </div>
  </section>
  <section class="section section--tinted">
    <div class="container editorial-grid">
      <div>
        <p class="eyebrow">
          {bn ? "সপ্তাহটা ভারসাম্যে রাখো" : "A balanced week"}
        </p><h2>
          {
            bn
              ? "Problem solve + কিছু real build"
              : "Solve problems and build something real"
          }
        </h2><p>
          {
            bn
              ? "যেমন: তিন দিন ৪৫ মিনিট foundation problem, দুই দিন project, এক দিন review/refactor। Competitive track নিলে problem বাড়াও—project পুরো বাদ দিয়ো না।"
              : "Example: three 45-minute foundation sessions, two project sessions and one review/refactor session. Competitive-track students can increase volume without deleting real engineering practice."
          }
        </p>
      </div><aside>
        <h3>{bn ? "বাছাই করা রিসোর্স" : "Selected resources"}</h3><ResourceList
          locale={locale}
          resourceIds={["algorithms-princeton", "cp-algorithms"]}
        />
      </aside>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <p class="eyebrow">{bn ? "এবার কী করবে" : "Next step"}</p><h2>
        {
          bn
            ? "তোমার level declare করে ৬ সপ্তাহ test করো।"
            : "Declare your level and test it for six weeks."
        }
      </h2><div class="next-actions">
        <a
          class="button"
          href={withBase(localePath(locale, "/guidance/new-cse-student/"))}
          >{bn ? "ফ্রেশারদের foundation plan" : "Fresher foundation plan"}</a
        ><a
          class="button button--secondary"
          href={withBase(
            localePath(locale, "/guidance/software-engineering-foundations/"),
          )}
          >{
            bn
              ? "Software engineering-এর ভিত্তি"
              : "Software engineering foundations"
          }</a
        >
      </div>
    </div>
  </section>
</BaseLayout>
<style>
  .level-list {
    display: grid;
    border-top: 1px solid var(--color-border-strong);
  }
  .level-list article {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 0.3rem 1rem;
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--color-border);
  }
  .level-list article > span {
    grid-row: 1 / 3;
    color: var(--color-warm);
    font-size: 0.75rem;
    font-weight: 800;
  }
  .level-list p {
    margin: 0;
    color: var(--color-text-muted);
  }
  .mode {
    padding: 1.2rem 0;
    border-top: 2px solid var(--color-primary);
  }
  .entry-bridge {
    border-block: 1px solid var(--color-border);
  }
  .entry-bridge__body {
    padding-inline-start: 1.25rem;
    border-inline-start: 3px solid var(--color-teal);
  }
  .entry-bridge__body p:first-child {
    margin-top: 0;
  }
  .practice-grid {
    display: grid;
    gap: 0.75rem;
  }
  .practice-grid article {
    padding: 1rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: var(--color-surface-raised);
  }
  .practice-grid h3 {
    margin-bottom: 0.35rem;
    font-size: 1rem;
  }
  .practice-grid p,
  .bangla-shelf p {
    margin: 0;
    color: var(--color-text-muted);
  }
  .bangla-shelf {
    display: grid;
    gap: 1rem;
    margin-top: 1rem;
    padding: 1.25rem;
    border-left: 4px solid var(--color-warm);
    background: var(--color-surface-raised);
  }
  .bangla-shelf h3 {
    margin: 0.2rem 0 0.5rem;
  }
  @media (min-width: 48rem) {
    .practice-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .bangla-shelf {
      grid-template-columns: minmax(0, 0.9fr) minmax(0, 1.1fr);
      gap: 2rem;
    }
  }
</style>
