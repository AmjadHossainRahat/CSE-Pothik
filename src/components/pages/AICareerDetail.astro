---
import Breadcrumbs from "@/components/common/Breadcrumbs.astro";
import {
  careerPath,
  experimentPath,
  roadmapPath,
  withBase,
} from "@/config/site";
import { t } from "@/lib/i18n";
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { Career, Locale } from "@/types/content";
interface Props {
  locale: Locale;
  career: Career;
}
const { locale, career } = Astro.props;
const bn = locale === "bn";
---

<BaseLayout
  locale={locale}
  title={`AI & ${t(career.title, locale)}`}
  description={bn
    ? `${t(career.title, locale)}-এর কোন কাজে AI-এর প্রভাব বেশি, কোথায় AI গতি বাড়ায় আর কোন দক্ষতা নিজের শক্তিতে গড়বে।`
    : `See which ${t(career.title, locale)} tasks have higher automation exposure, where AI accelerates work and which capabilities to build independently.`}
>
  <Breadcrumbs
    locale={locale}
    items={[
      { label: bn ? "AI ও ক্যারিয়ার" : "AI & Your Career", path: "/ai/" },
      { label: t(career.title, locale) },
    ]}
  />
  <header class="page-hero container">
    <p class="eyebrow">
      {bn ? "এই ক্যারিয়ারে AI" : "Career-specific AI guide"}
    </p><h1>AI & {t(career.title, locale)}</h1><p class="lede">
      {
        bn
          ? "এখানে কোনো replacement score নেই। কাজগুলো আলাদা করে দেখুন—কোথায় AI-কে নির্দেশ দেবে, আর কোথায় নিজের চিন্তার হাল ছাড়বে না।"
          : "No replacement score. Separate the career’s tasks to see where to direct AI and where to preserve independent reasoning."
      }
    </p>
  </header>
  <section class="section section--tinted">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">Task Automation Exposure</p><h2>
            {
              bn
                ? "কাজ, ব্যাখ্যা, আপনার করণীয়"
                : "Task, explanation, student response"
            }
          </h2>
        </div><p class="lede">
          {
            bn
              ? "Lower মানে চিরদিন নিরাপদ নয়; higher মানে ক্যারিয়ারটি অর্থহীনও নয়। কাজের মিশ্রণ আর দায়িত্ব বদলায়।"
              : "Lower never means permanently safe; higher never means the career is useless. Task mix and responsibility change."
          }
        </p>
      </div><div class="exposure">
        {
          career.aiExposure.map((item) => (
            <article class="exposure__item" data-level={item.exposure}>
              <>
                <span class="tag">{item.exposure}</span>
                <h3>{t(item.task, locale)}</h3>
                <p>{t(item.explanation, locale)}</p>
                <p>
                  <strong>{bn ? "আপনি যা করবেন:" : "Your response:"}</strong>{" "}
                  {t(item.studentResponse, locale)}
                </p>
              </>
            </article>
          ))
        }
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container editorial-grid">
      <div>
        <p class="eyebrow">
          {bn ? "নিজের শক্তির জায়গা" : "Independent capability"}
        </p><h2>
          {
            bn
              ? "AI ছাড়া কী পারা উচিত?"
              : "What should you still be able to do?"
          }
        </h2><ul class="rule-list">
          {
            career.foundation
              .concat(career.core.slice(0, 2))
              .map((item) => <li>{t(item, locale)}</li>)
          }
        </ul>
      </div><div class="callout callout--warm">
        <p class="callout__label">
          {bn ? "যাচাইয়ের ছোট অনুশীলন" : "Verification drill"}
        </p><p>
          {
            bn
              ? "AI-এর বানানো solution থেকে একটি bug, প্রমাণহীন একটি assumption, বাদ পড়া একটি edge case আর সহজতর একটি বিকল্প খুঁজে লিখুন।"
              : "In an AI-generated solution, identify one bug, one unproven assumption, one missing edge case and one simpler alternative."
          }
        </p>
      </div>
    </div>
  </section>
  <section class="section section--tinted">
    <div class="container">
      <p class="eyebrow">{bn ? "এবার কী করবেন" : "Next choices"}</p><h2>
        {bn ? "ভয় নিয়ে বসে না থেকে কাজে নামো" : "Move from fear to practice"}
      </h2><div class="next-actions">
        <a class="button" href={withBase(experimentPath(locale, career.slug))}
          >{bn ? "ক্যারিয়ারের কাজ করে দেখি" : "Run the career experiment"}</a
        ><a
          class="button button--secondary"
          href={withBase(roadmapPath(locale, career.slug))}
          >{bn ? "রোডম্যাপ খুলি" : "Open the roadmap"}</a
        ><a
          class="button button--secondary"
          href={withBase(careerPath(locale, career.slug))}
          >{bn ? "ক্যারিয়ার পরিচিতি" : "Career overview"}</a
        >
      </div>
    </div>
  </section>
</BaseLayout>
