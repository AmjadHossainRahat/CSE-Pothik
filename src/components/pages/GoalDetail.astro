---
import Breadcrumbs from "@/components/common/Breadcrumbs.astro";
import { careerById } from "@/data/careers";
import { goalById } from "@/data/goals";
import { guidanceSourceById } from "@/data/guidance-sources";
import { firstSoftwareRoleGuide } from "@/data/first-software-role";
import { localePath, roadmapPath, withBase } from "@/config/site";
import { t } from "@/lib/i18n";
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { GoalGuide, Locale } from "@/types/content";
interface Props {
  locale: Locale;
  goal: GoalGuide;
}
const { locale, goal } = Astro.props;
const bn = locale === "bn";
const href = (path: string) => withBase(localePath(locale, path));
const sections = [
  { id: "orientation", title: bn ? "পথের ধরন" : "Choose your branch" },
  ...(goal.id === "local-industry"
    ? [
        {
          id: "industry-entry-routes",
          title: bn ? "Industry-তে ঢোকার route" : "Industry-entry routes",
        },
      ]
    : []),
  {
    id: "starting-point",
    title: bn ? "কোথা থেকে শুরু" : "Your starting point",
  },
  ...goal.stages.map((stage) => ({
    id: `stage-${stage.id}`,
    title: t(stage.title, locale),
  })),
  { id: "pitfalls", title: bn ? "ফাঁদ আর AI ব্যবহার" : "Pitfalls & AI use" },
  { id: "this-week", title: bn ? "এই সপ্তাহের কাজ" : "One action this week" },
  {
    id: "career-paths",
    title: bn ? "যুক্ত career roadmap" : "Connected career roadmaps",
  },
  {
    id: "sources",
    title: bn ? "তথ্যের উৎস ও যাচাই" : "Sources & verification",
  },
];
const starts = [
  {
    id: "orientation",
    title: bn ? "এখনো explore করছি" : "Still exploring",
    text: bn
      ? "আগে পথের ধরনটা বুঝুন।"
      : "Understand the different branches first.",
  },
  {
    id: "stage-foundation",
    title: bn ? "ভিত্তি তৈরি করছি" : "Building foundations",
    text: bn
      ? "লক্ষ্য আর prerequisite মিলিয়ে নিন।"
      : "Match your target and prerequisites.",
  },
  {
    id: "stage-evidence",
    title: bn ? "কাজ বানাতে পারি" : "Can already build or investigate",
    text: bn
      ? "লক্ষ্যের সঙ্গে মেলে এমন evidence বানান।"
      : "Turn ability into relevant evidence.",
  },
  {
    id: "stage-application",
    title: bn
      ? "আবেদন বা delivery-র জন্য প্রস্তুত"
      : "Ready to apply or deliver",
    text: bn
      ? "আগের evidence-গুলো শর্তের সঙ্গে মিলিয়ে নিন।"
      : "Check the earlier evidence criteria, then proceed.",
  },
];
const sourceIds = [
  ...new Set([
    ...goal.sourceIds,
    ...goal.stages.map((stage) => stage.sourceId),
  ]),
];
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: t(goal.title, locale),
    description: t(goal.summary, locale),
    inLanguage: locale,
    isAccessibleForFree: true,
    author: { "@type": "Organization", name: "CSE-Pothik" },
    mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: bn ? "লক্ষ্যভিত্তিক পথ" : "Goal guides",
        item: new URL(href("/goals/"), Astro.site).href,
      },
      {
        "@type": "ListItem",
        position: 2,
        name: t(goal.title, locale),
        item: new URL(Astro.url.pathname, Astro.site).href,
      },
    ],
  },
];
---

<BaseLayout
  locale={locale}
  title={t(goal.title, locale)}
  description={t(goal.summary, locale)}
  structuredData={structuredData}
>
  <Breadcrumbs
    locale={locale}
    items={[
      { label: bn ? "লক্ষ্যভিত্তিক পথ" : "Goal guides", path: "/goals/" },
      { label: t(goal.title, locale) },
    ]}
  />
  <header class="page-hero container goal-hero">
    <p class="eyebrow">
      {
        bn
          ? "লক্ষ্যভিত্তিক গাইড · নিজের জায়গা থেকে শুরু"
          : "Goal guide · start from where you are"
      }
    </p>
    <h1>{t(goal.title, locale)}</h1><p class="lede">
      {t(goal.summary, locale)}
    </p>
    <div class="button-row">
      <a class="button" href="#starting-point"
        >{bn ? "শুরুর জায়গা বেছে নিই" : "Find my starting point"}</a
      ><a class="button button--secondary" href="#this-week"
        >{bn ? "এই সপ্তাহে একটি কাজ" : "Give me one action this week"}</a
      >
    </div>
  </header>
  <div class="container goal-layout">
    <aside class="goal-index">
      <nav class="desktop-index" aria-label={bn ? "এই পাতায়" : "On this page"}>
        <p class="eyebrow">{bn ? "এই পাতায়" : "On this page"}</p><ol>
          {
            sections.map((section) => (
              <li>
                <a href={`#${section.id}`}>{section.title}</a>
              </li>
            ))
          }
        </ol>
      </nav>
      <details class="mobile-index">
        <summary
          >{
            bn ? "এই পাতায় · অংশ বেছে নিন" : "On this page · jump to a section"
          }</summary
        ><nav aria-label={bn ? "পাতার অংশ" : "Page sections"}>
          <ol>
            {
              sections.map((section) => (
                <li>
                  <a href={`#${section.id}`}>{section.title}</a>
                </li>
              ))
            }
          </ol>
        </nav>
      </details>
    </aside>
    <div class="goal-content">
      <section class="guide-section" id="orientation">
        <p class="eyebrow">
          {bn ? "আগে বাস্তব কথাটা" : "First, a reality check"}
        </p><h2>
          {bn ? "পথটা বুঝে নিন" : "Know the route before the checklist"}
        </h2><div class="reality-note">
          <p>{t(goal.reality, locale)}</p>
        </div><div class="goal-variants">
          {
            goal.variants.map((variant) => (
              <article>
                <>
                  <h3>{t(variant.title, locale)}</h3>
                  <p>{t(variant.description, locale)}</p>
                </>
              </article>
            ))
          }
        </div>
      </section>
      {
        goal.id === "local-industry" && (
          <section class="guide-section" id="industry-entry-routes">
            <p class="eyebrow">
              {bn
                ? "Problem solving অনুযায়ী পথ"
                : "Choose by your current evidence"}
            </p>
            <h2>
              {bn
                ? "একই industry-তে ঢোকার route সবার এক নয়।"
                : "There is more than one route into the same industry."}
            </h2>
            <p>
              {bn
                ? "Strong CP আপনাকে algorithm-heavy hiring process-এ এগিয়ে রাখতে পারে। CP কম হলে project, debugging, testing বা role-specific কাজের evidence দিয়ে অন্য route ধরুন—সঙ্গে প্রয়োজনীয় problem-solving foundation গড়তে থাকুন। কোনোটিই shortcut বা guarantee নয়।"
                : "Strong CP can create an advantage in algorithm-heavy hiring. If CP is not your strength, use project, debugging, testing or other role-specific evidence while building the necessary problem-solving floor. Neither route is a shortcut or guarantee."}
            </p>
            <nav
              aria-label={bn ? "Industry entry route" : "Industry entry routes"}
            >
              <ul class="industry-entry-list">
                {firstSoftwareRoleGuide.entryRoutes.map((route) => (
                  <li>
                    <a
                      href={href(
                        `/guidance/first-software-role/#entry-route-${route.id}`,
                      )}
                      data-track-event="next_step_clicked"
                      data-track-param-destination={`first-role/route-${route.id}`}
                    >
                      <strong>{t(route.title, locale)}</strong>
                      <span>{t(route.signal, locale)}</span>
                      <span class="industry-entry-list__action">
                        {bn ? "এই route দেখুন" : "See this route"} →
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          </section>
        )
      }
      <section class="guide-section" id="starting-point">
        <p class="eyebrow">
          {bn ? "এটি পরীক্ষা নয়" : "Not a test or a score"}
        </p><h2>
          {bn ? "আজ আপনি কোথায়?" : "Where are you starting today?"}
        </h2><p>
          {
            bn
              ? "যে অবস্থাটি মেলে, সেখান থেকে শুরু করুন। আগের ধাপের evidence না থাকলে এক ধাপ ফিরে আসুন। কোনো উত্তর বা progress জমা হয় না; ধাপ শেষ করার বাঁধা deadline-ও নেই।"
              : "Jump to the point that fits. If earlier evidence is missing, return to it. Nothing is saved or scored, and stages have no fixed completion deadline."
          }
        </p><ul class="start-options">
          {
            starts.map((start) => (
              <li>
                <a href={`#${start.id}`}>
                  <>
                    <strong>{start.title}</strong>
                    <span>{start.text}</span>
                  </>
                </a>
              </li>
            ))
          }
        </ul>
      </section>
      {
        goal.stages.map((stage, index) => (
          <section class="guide-section goal-stage" id={`stage-${stage.id}`}>
            <>
              <p class="eyebrow">
                {bn
                  ? `ধাপ ${index + 1} / ${goal.stages.length}`
                  : `Stage ${index + 1} / ${goal.stages.length}`}
              </p>
              <h2>{t(stage.title, locale)}</h2>
              <p class="stage-why">{t(stage.why, locale)}</p>
              <h3>{bn ? "কাজগুলো" : "What to do"}</h3>
              <ul class="task-list">
                {stage.tasks.map((task) => (
                  <li>{t(task, locale)}</li>
                ))}
              </ul>
              <div class="evidence-note">
                <>
                  <h3>{bn ? "এখন যথেষ্ট যখন…" : "Enough for now when…"}</h3>
                  <p>{t(stage.evidence, locale)}</p>
                </>
              </div>
              <p class="not-yet">
                <strong>{bn ? "এখনই নয়: " : "Not yet: "}</strong>
                {t(stage.notYet, locale)}
              </p>
              <a class="stage-reference" href={`#source-${stage.sourceId}`}>
                {bn ? "এই ধাপের reference: " : "Reference for this stage: "}
                {guidanceSourceById.get(stage.sourceId)!.provider}{" "}
                <span aria-hidden="true">↓</span>
              </a>
            </>
          </section>
        ))
      }
      <section class="guide-section" id="pitfalls">
        <p class="eyebrow">
          {bn ? "বুদ্ধি দিয়ে এগিয়ে যান" : "Keep your judgment switched on"}
        </p><h2>
          {bn ? "ফাঁদ আর AI ব্যবহার" : "Common traps & sensible AI use"}
        </h2><ul class="task-list">
          {goal.pitfalls.map((pitfall) => <li>{t(pitfall, locale)}</li>)}
        </ul><div class="reality-note">
          <h3>
            {
              bn
                ? "AI সহকারী; দায়িত্ব কিন্তু আপনার"
                : "AI can assist. You remain responsible."
            }
          </h3><p>{t(goal.aiPractice, locale)}</p><a href={href("/ai/")}
            >{
              bn
                ? "AI-এর যুগে টিকে থাকার গাইড →"
                : "Explore AI-resilient skills →"
            }</a
          >
        </div>
      </section>
      <section class="guide-section" id="this-week">
        <div class="week-card">
          <p class="eyebrow">
            {bn ? "একটি ছোট কাজ যথেষ্ট" : "One small action is enough"}
          </p><h2>{bn ? "এই সপ্তাহে শুরু করুন" : "Make this week count"}</h2><p>
            {t(goal.thisWeek, locale)}
          </p><p class="week-reflection">
            {
              bn
                ? "শেষে তিনটি লাইন লিখুন: কী করলাম, কী শিখলাম, এরপর কী বদলাব। আজকের দিকটি একটি draft—আজীবনের contract নয়।"
                : "Afterwards, write three lines: what I did, what I learned, what I will change next. Today's direction is a draft—not a lifetime contract."
            }
          </p>
        </div>
      </section>
      <section class="guide-section" id="career-paths">
        <p class="eyebrow">
          {bn ? "কী শিখবেন, তার পথ" : "The skills underneath the goal"}
        </p><h2>
          {
            bn
              ? "একটি ক্যারিয়ার রোডম্যাপ মিলিয়ে নিন"
              : "Pair this with a career roadmap"
          }
        </h2><p>
          {
            bn
              ? "এগুলো প্রাসঙ্গিক starting point, সবগুলো prerequisite নয়। একটি বেছে নিন; আপনার নির্দিষ্ট লক্ষ্যের সঙ্গে অন্য ক্যারিয়ারও মিলতে পারে।"
              : "These are relevant starting points, not a list of prerequisites. Choose one; other careers may also fit your specific goal."
          }
        </p><ul class="career-paths">
          {
            goal.careerIds.map((id) => (
              <li>
                <a
                  href={withBase(roadmapPath(locale, id))}
                  data-track-event="next_step_clicked"
                  data-track-param-destination={`roadmap/${id}`}
                >
                  {t(careerById.get(id)!.title, locale)}{" "}
                  <span aria-hidden="true">→</span>
                </a>
              </li>
            ))
          }
        </ul><h3 class="related-heading">
          {bn ? "পাশের পথগুলো" : "Adjacent directions"}
        </h3><ul>
          {
            goal.relatedGoalIds.map((id) => (
              <li>
                <a href={href(`/goals/${id}/`)}>
                  {t(goalById.get(id)!.title, locale)}
                </a>
              </li>
            ))
          }
        </ul>
      </section>
      <section class="guide-section" id="sources">
        {
          ["global-companies", "local-industry", "remote-employment"].includes(
            goal.id,
          ) && (
            <p>
              <a
                href={href("/guidance/first-software-role/")}
                data-track-event="next_step_clicked"
                data-track-param-destination="first-software-role"
              >
                {bn
                  ? "Final semester থেকে internship বা junior software role-এ যাওয়ার সেতু"
                  : "Bridge from final semester to an internship or junior software role"}{" "}
                →
              </a>
            </p>
          )
        }
        <p>
          <a href={href("/guidance/final-year-project/")}
            >{
              bn
                ? "ফাইনাল ইয়ার প্রজেক্ট দিয়ে engineering evidence বানান"
                : "Build engineering evidence through your final-year project"
            } →</a
          >
        </p>
        <h2>
          {
            bn
              ? "তথ্যের উৎস ও শর্ত মিলিয়ে দেখুন"
              : "Sources & requirement checks"
          }
        </h2><p>
          {
            bn
              ? "এই রোডম্যাপ CSE-Pothik-এর editorial guidance। source-গুলো নির্দিষ্ট official reference—পুরো পরিকল্পনার endorsement নয়। গাইডটি বিনামূল্যে হলেও application, test, tool বা publication-এ খরচ হতে পারে। নিয়ম বদলায়, তাই সিদ্ধান্তের আগে official page আবার দেখে নিন। বাইরের source-গুলোর বেশির ভাগই English।"
              : "This roadmap is CSE-Pothik editorial guidance. Sources provide specific official references, not endorsement of the entire plan. Reading guidance may be free while applications, tests, tools or publication have costs. Rules change: recheck official pages before acting. External references are primarily in English."
          }
        </p><ul class="source-list">
          {
            sourceIds.map((id) => {
              const source = guidanceSourceById.get(id)!;
              return (
                <li id={`source-${source.id}`}>
                  <>
                    <a
                      href={source.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-describedby="external-link-description"
                      data-track-event="learning_resource_clicked"
                      data-track-param-resource-id={source.id}
                      data-track-param-provider={source.provider}
                    >
                      {source.provider} · {source.title}{" "}
                      <span aria-hidden="true">↗</span>
                    </a>
                    <p>{t(source.scope, locale)}</p>
                    <small>
                      {bn ? "তথ্যটি শেষ যাচাই: " : "Reference reviewed: "}
                      <time datetime={source.lastReviewed}>
                        {source.lastReviewed}
                      </time>
                    </small>
                  </>
                </li>
              );
            })
          }
        </ul>
      </section>
    </div>
  </div>
</BaseLayout>
<style>
  .goal-hero h1 {
    max-width: 19ch;
    font-size: clamp(2.4rem, 6vw, 5rem);
  }
  .goal-layout {
    display: grid;
    gap: 1.5rem;
    padding-bottom: 4rem;
  }
  .goal-content {
    min-width: 0;
    max-width: 52rem;
  }
  .desktop-index {
    display: none;
  }
  .goal-index ol {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .goal-index li {
    margin: 0;
  }
  .goal-index a {
    display: block;
    padding: 0.55rem 0;
    font-size: 0.9rem;
    line-height: 1.5;
  }
  .mobile-index {
    border-block: 1px solid var(--color-border-strong);
    padding: 0.7rem 0;
  }
  .mobile-index summary {
    cursor: pointer;
    padding: 0.5rem 0;
    font-weight: 750;
  }
  .guide-section {
    padding: 2.7rem 0;
    border-top: 1px solid var(--color-border);
  }
  .guide-section h2 {
    font-size: clamp(1.8rem, 3.5vw, 2.65rem);
    line-height: 1.2;
  }
  .guide-section h3 {
    font-size: 1.18rem;
    line-height: 1.4;
  }
  .reality-note {
    padding: 1.25rem;
    border-inline-start: 3px solid var(--color-warm);
    background: var(--color-surface);
  }
  .reality-note p:last-child {
    margin: 0;
  }
  .goal-variants {
    display: grid;
    gap: 1.3rem;
    margin-top: 1.8rem;
  }
  .goal-variants article {
    padding-bottom: 0.5rem;
  }
  .goal-variants p {
    margin: 0;
    color: var(--color-text-muted);
  }
  .start-options {
    display: grid;
    gap: 0.7rem;
    padding: 0;
    margin: 1.5rem 0 0;
    list-style: none;
  }
  .industry-entry-list {
    display: grid;
    gap: 0.75rem;
    margin: 1.5rem 0 0;
    padding: 0;
    list-style: none;
  }
  .industry-entry-list li {
    margin: 0;
  }
  .industry-entry-list a {
    display: grid;
    gap: 0.4rem;
    height: 100%;
    padding: 1rem;
    color: var(--color-text);
    border: 1px solid var(--color-border-strong);
    border-top: 3px solid var(--color-primary);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    text-decoration: none;
  }
  .industry-entry-list li:nth-child(2) a {
    border-top-color: var(--color-teal);
  }
  .industry-entry-list li:nth-child(3) a {
    border-top-color: var(--color-amber);
  }
  .industry-entry-list span {
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }
  .industry-entry-list .industry-entry-list__action {
    margin-top: 0.35rem;
    color: var(--color-primary-strong);
    font-weight: 750;
  }
  .start-options li {
    margin: 0;
  }
  .start-options a {
    display: block;
    height: 100%;
    padding: 1rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    text-decoration: none;
  }
  .start-options strong {
    display: block;
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }
  .start-options span {
    display: block;
    margin-top: 0.4rem;
    color: var(--color-text-muted);
    font-size: 0.9rem;
  }
