---
import Breadcrumbs from "@/components/common/Breadcrumbs.astro";
import DirectoryJumpNav from "@/components/common/DirectoryJumpNav.astro";
import { localePath, roadmapPath, withBase } from "@/config/site";
import { careerById, careerFamilies, careers } from "@/data/careers";
import { t } from "@/lib/i18n";
import { collectionStructuredData } from "@/lib/seo";
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { Locale } from "@/types/content";
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const bn = locale === "bn";
const title = bn ? "CSE ক্যারিয়ার রোডম্যাপ" : "CSE Career Roadmaps";
const description = bn
  ? "ভিত্তি থেকে ধাপে ধাপে এগোনো CSE ক্যারিয়ার রোডম্যাপ—কী শিখবেন, আপাতত কতটুকু যথেষ্ট, কী হাতে-কলমে করবেন আর কোনটা এখন না শিখলেও চলবে।"
  : "Foundation-first, mentor-guided CSE career roadmaps with practical tasks, curated resources and clear guidance on what not to learn yet.";
const groupedCareers = careerFamilies.map((family) => ({
  family,
  careers: family.careerIds.map((id) => careerById.get(id)!),
}));
const structuredData = collectionStructuredData({
  title,
  description,
  url: Astro.url.href,
  locale,
  homeUrl: new URL(withBase(localePath(locale, "/")), Astro.site).href,
  homeLabel: bn ? "হোম" : "Home",
  items: careers.map((career) => ({
    name: `${t(career.title, locale)} ${bn ? "রোডম্যাপ" : "roadmap"}`,
    url: new URL(withBase(roadmapPath(locale, career.slug)), Astro.site).href,
  })),
});
---

<BaseLayout
  locale={locale}
  title={title}
  description={description}
  structuredData={structuredData}
>
  <Breadcrumbs
    locale={locale}
    items={[{ label: bn ? "রোডম্যাপ" : "Roadmaps" }]}
  />
  <header class="page-hero page-hero--compact container">
    <p class="eyebrow">
      {bn ? "মেন্টরের মতো ধাপে ধাপে" : "Mentor-guided sequences"}
    </p><h1>
      {
        bn
          ? "শুধু roadmap poster নয়—কোনটির পর কোনটি শিখবেন, সেটিই আসল।"
          : "Not roadmap posters. Usable learning order."
      }
    </h1><p class="lede">
      {
        bn
          ? "প্রতিটি ধাপে জানবেন কেন শিখছেন, আপাতত কতটুকু যথেষ্ট, কীভাবে practice করবেন আর কোন চকচকে tool-কে এখন ‘পরে দেখা যাবে’ বলা যায়।"
          : "Each stage explains why it matters, what is enough for now, what to practice and which shiny tools can wait."
      }
    </p>
  </header>
  <DirectoryJumpNav
    eyebrow={bn ? "কাজের ধরন বেছে নিন" : "Jump to a career family"}
    label={bn ? "রোডম্যাপ বিভাগের তালিকা" : "Roadmap family index"}
    items={groupedCareers.map(({ family, careers: items }) => ({
      id: `roadmaps-${family.id}`,
      label: t(family.title, locale),
      count: items.length,
    }))}
  />
  <section
    class="section route-choices"
    aria-label={bn ? "রোডম্যাপের ধরন" : "Choose a roadmap type"}
  >
    <div class="container route-choice-grid">
      <article>
        <p class="eyebrow">{bn ? "কী শিখবেন" : "What to learn"}</p><h2>
          {bn ? "ক্যারিয়ার অনুযায়ী" : "By career"}
        </h2><p>
          {
            bn
              ? "Backend, mobile, UX/UI আর অন্য কাজের ভিত্তি থেকে specialization পর্যন্ত।"
              : "From foundations to specialization in backend, mobile, UX/UI and other careers."
          }
        </p><a class="button button--secondary" href="#career-roadmaps"
          >{bn ? "ক্যারিয়ার রোডম্যাপ দেখুন" : "Browse career roadmaps"}</a
        >
      </article>
      <article>
        <p class="eyebrow">
          {bn ? "কোথায় কাজে লাগাবেন" : "How to put it to work"}
        </p><h2>{bn ? "লক্ষ্য অনুযায়ী" : "By goal"}</h2><p>
          {
            bn
              ? "দেশে-বিদেশে চাকরি, remote work, উচ্চশিক্ষা, research, freelancing আর tech business—সাতটি বাস্তব পথ।"
              : "Seven practical routes: global/local industry, remote work, study abroad, research, freelancing and a tech business."
          }
        </p><a
          class="button"
          href={withBase(localePath(locale, "/goals/"))}
          data-track-event="next_step_clicked"
          data-track-param-destination="goals"
          >{bn ? "লক্ষ্য বেছে নিই" : "Find my goal guide"}</a
        >
      </article>
    </div>
  </section>
  <section class="section section--tinted" id="career-roadmaps">
    <div class="container project-entry">
      <p class="eyebrow">
        {bn ? "শেখা কাজে লাগান" : "Put your learning into practice"}
      </p>
      <h2>
        {
          bn
            ? "ফাইনাল ইয়ার প্রজেক্ট শুরু করছেন?"
            : "Starting your final-year project?"
        }
      </h2>
      <p>
        {
          bn
            ? "Requirement থেকে test, review আর handover—শিক্ষার্থী হিসেবেই industry practice মেনে শেষ করা সম্ভব এমন project বানান।"
            : "Turn a finishable project into engineering evidence: requirements, tests, reviews and a reproducible handover."
        }
      </p>
      <a
        href={withBase(localePath(locale, "/guidance/final-year-project/"))}
        data-track-event="next_step_clicked"
        data-track-param-destination="final-year-project"
        >{
          bn
            ? "Project standard আর template দেখুন"
            : "Explore project standards and templates"
        } →</a
      >
    </div>
  </section>
  {
    groupedCareers.map(({ family, careers: items }, familyIndex) => (
      <section
        class:list={[
          "section",
          "directory-target",
          { "section--tinted": familyIndex % 2 === 1 },
        ]}
        id={`roadmaps-${family.id}`}
      >
        <div class="container">
          <div class="directory-heading">
            <p class="eyebrow">{t(family.title, locale)}</p>
            <h2>{t(family.description, locale)}</h2>
          </div>
          <div class="roadmap-list">
            {items.map((career, index) => (
              <article>
                <span>{String(index + 1).padStart(2, "0")}</span>
                <div>
                  <h3>{t(career.title, locale)}</h3>
                  <p>{t(career.shortDescription, locale)}</p>
                  <a
                    href={withBase(roadmapPath(locale, career.slug))}
                    data-track-event="next_step_clicked"
                    data-track-param-destination={`roadmap/${career.id}`}
                  >
                    {bn ? "রোডম্যাপ খুলুন" : "Open roadmap"}{" "}
                    <span aria-hidden="true">→</span>
                  </a>
                </div>
              </article>
            ))}
          </div>
        </div>
      </section>
    ))
  }
  <section class="section">
    <div class="container callout">
      <p class="callout__label">
        {bn ? "কীভাবে ব্যবহার করবেন" : "How to use these"}
      </p><h2>
        {
          bn
            ? "সব ঘরে টিক দেওয়ার দৌড়ে নেমো না।"
            : "Do not try to tick every box."
        }
      </h2><p>
        {
          bn
            ? "এখনকার ধাপের ‘আপাতত যথেষ্ট’ শর্ত পূরণ করুন, হাতে-কলমে কাজটি শেষ করুন, তারপর পরের ধাপে যান। Resource link জমালেই skill জমে না।"
            : "Meet the current stage’s ‘enough for now’ criteria, complete its practical task, then move forward. Collecting resource links is not a skill."
        }
      </p>
      <div class="button-row">
        <a class="button" href={withBase(localePath(locale, "/careers/"))}>
          {bn ? "ক্যারিয়ারের বিভাগ দেখি" : "Explore career families"}
        </a>
        <a
          class="button button--secondary"
          href={withBase(localePath(locale, "/goals/"))}
        >
          {bn ? "লক্ষ্যভিত্তিক গাইড বেছে নিই" : "Choose a goal guide"}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
<style>
  .project-entry {
    margin-bottom: 3rem;
  }
  .project-entry p {
    max-width: 48rem;
  }
  .route-choices {
    padding-block: 2.5rem;
  }
  .route-choice-grid {
    display: grid;
    gap: 2rem;
  }
  .route-choice-grid article {
    padding: 1.5rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-md);
  }
  .route-choice-grid h2 {
    font-size: 2rem;
  }
  .directory-heading {
    max-width: 52rem;
    margin-bottom: 2rem;
  }
  .directory-heading h2 {
    font-size: clamp(1.4rem, 3vw, 2rem);
  }
  @media (min-width: 48rem) {
    .route-choice-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  .roadmap-list {
    border-top: 1px solid var(--color-border-strong);
  }
  .roadmap-list article {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 1rem;
    padding: 1.7rem 0;
    border-bottom: 1px solid var(--color-border);
  }
  .roadmap-list article > span {
    color: var(--color-warm);
    font-size: 0.75rem;
    font-weight: 800;
  }
  .roadmap-list h3 {
    margin-bottom: 0.4rem;
    font-size: clamp(1.4rem, 3vw, 2rem);
  }
  .roadmap-list p {
    max-width: 52rem;
    color: var(--color-text-muted);
  }
  .roadmap-list a {
    font-weight: 750;
  }
  .callout .button-row {
    margin-top: 1.25rem;
  }
</style>
