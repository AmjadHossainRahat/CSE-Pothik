---
import { Image } from "astro:assets";
import mentorImage from "@/assets/illustrations/mentor-guide.png";
import robotImage from "@/assets/illustrations/ai-study-partner.png";
import { experimentPath, localePath, withBase } from "@/config/site";
import { careerById, careerFamilies } from "@/data/careers";
import { experimentById, experiments } from "@/data/experiments";
import { studentSituations } from "@/data/situations";
import { t } from "@/lib/i18n";
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { CareerId, Locale } from "@/types/content";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const bn = locale === "bn";
const copy = (en: string, bangla: string) => (bn ? bangla : en);
const href = (path: string) => withBase(localePath(locale, path));
const experimentIds: CareerId[] = [
  "backend-engineering",
  "cybersecurity",
  "machine-learning",
];
const mapSteps = [
  [
    "See the landscape",
    "Landscape বোঝো",
    "CSE is more than one career",
    "CSE মানে একটাই career নয়",
    "#landscape",
  ],
  [
    "Meet the real work",
    "আসল কাজটা দেখো",
    "Tasks, not impressive titles",
    "Title নয়, কাজ দিয়ে চিনো",
    "/careers/",
  ],
  [
    "Try a small version",
    "ছোট করে try করো",
    "A little evidence beats a guess",
    "আন্দাজের চেয়ে experience ভালো",
    "#experiments",
  ],
  [
    "Take one next step",
    "একটা next step নাও",
    "Not a lifetime contract",
    "সারা জীবনের contract নয়",
    "#starting-point",
  ],
] as const;
const realityChecks = [
  [
    "CSE is a landscape, not one career.",
    "CSE একটা career নয়—অনেক ধরনের কাজের landscape।",
  ],
  [
    "Programming is a tool. A framework is not a career plan.",
    "Programming একটা tool। Framework career plan নয়।",
  ],
  [
    "You can explore deliberately without deciding your whole life.",
    "পুরো জীবনের সিদ্ধান্ত ছাড়াও ভেবেচিন্তে explore করা যায়।",
  ],
] as const;
const voices = [
  [
    "Software Engineer",
    "Learn how software works, not just which framework is trending.",
    "কোন framework trending শুধু সেটা নয়—software কীভাবে কাজ করে শেখো।",
  ],
  [
    "Cybersecurity Professional",
    "Start with networking, Linux and systems. The tools come after.",
    "Networking, Linux আর system দিয়ে শুরু করো। Tool পরে আসবে।",
  ],
  [
    "ML / AI Engineer",
    "Calling an AI API and understanding machine learning are different skills.",
    "AI API call করা আর Machine Learning বোঝা আলাদা skill।",
  ],
  [
    "DevOps / SRE Engineer",
    "Some people love features. Others want to know why the whole system failed.",
    "কেউ feature বানাতে ভালোবাসে। কেউ জানতে চায়—পুরো system কেন পড়ল।",
  ],
  [
    "Research / Systems",
    "If you enjoy asking why it works—not only how to use it—look deeper.",
    "কীভাবে use করতে হয় শুধু নয়, কেন কাজ করে জানতে চাইলে—গভীরে তাকাও।",
  ],
] as const;
const journey = [
  [
    "Understand",
    "বোঝো",
    "Find your starting point.",
    "এখন কোথায় আছ, বোঝো।",
    "#starting-point",
  ],
  [
    "Explore",
    "দেখো",
    "Look behind the job title.",
    "Job title-এর পেছনের কাজ দেখো।",
    "/careers/",
  ],
  [
    "Compare",
    "তুলনা করো",
    "Compare the trade-offs.",
    "কাজের ভালো-মন্দ মিলিয়ে দেখো।",
    "/compare/",
  ],
  [
    "Try",
    "ট্রাই করো",
    "Get a little real evidence.",
    "ছোট কাজ করে experience নাও।",
    "/try/",
  ],
  [
    "Prepare",
    "প্রস্তুত হও",
    "Build your foundations.",
    "Foundation শক্ত করো।",
    "/roadmaps/",
  ],
  [
    "Adapt",
    "বদলাও",
    "Keep learning as work changes.",
    "কাজ বদলালে শেখাটাও বদলাও।",
    "/ai/",
  ],
] as const;
const familySymbols = ["{ }", "▤", "✦", "◇", "☁", "⌘", "λ", "↔"];
---

<BaseLayout
  locale={locale}
  title={copy(
    "CSE Compass — Find Your Direction in CSE",
    "CSE Compass — CSE-তে তোমার direction খুঁজে নাও",
  )}
  description={copy(
    "Explore CSE careers, compare real work, try practical experiments, follow focused roadmaps and prepare for an AI-shaped future.",
    "বাংলাদেশি CSE student-দের জন্য practical career direction, roadmap, experiment আর AI-resilience guidance।",
  )}
>
  <div class="homepage">
    <section class="hero" aria-labelledby="hero-title">
      <div class="container">
        <div class="hero-grid">
          <div class="hero-copy">
            <p class="eyebrow">
              {
                copy(
                  "Understand CSE careers. Find your next step.",
                  "CSE-এর career বোঝো। নিজের পরের পদক্ষেপ খুঁজে নাও।",
                )
              }
            </p>
            <h1 id="hero-title">
              {copy("You got into CSE.", "CSE-তে ঢুকেছ।")}<br /><em
                >{copy("Now what?", "এখন কী?")}</em
              >
            </h1>
            <p class="hero-lede">
              {
                copy(
                  "You do not need a 10-year plan today. You need a clearer picture of the possibilities—and one small place to start.",
                  "আজই ১০ বছরের plan লাগবে না। কী কী পথ আছে সেটা বোঝো—তারপর ছোট একটা জায়গা থেকে শুরু করো।",
                )
              }
            </p>
            <div class="button-row">
              <a
                class="button"
                href="#starting-point"
                data-track-event="next_step_clicked"
                data-track-param-destination="starting-point"
                >{copy("Find My Starting Point", "আমার starting point খুঁজি")}
                <span aria-hidden="true">→</span></a
              >
              <a class="button button--secondary" href={href("/careers/")}
                >{copy("Explore CSE Careers", "CSE career দেখো")}</a
              >
            </div>
            <p class="hero-reassurance">
              <span aria-hidden="true">✦</span>
              {
                copy(
                  "New, confused, or starting again? You belong here.",
                  "নতুন, confused, বা আবার শুরু করছ? এই জায়গাটা তোমারও।",
                )
              }
            </p>
          </div>
          <figure class="hero-visual">
            <Image
              src={mentorImage}
              alt={copy(
                "A friendly young computing mentor in a navy hoodie working at a laptop.",
                "নেভি hoodie পরা হাসিমুখের তরুণ computing mentor laptop-এ কাজ করছে।",
              )}
              widths={[400, 640, 900]}
              sizes="(min-width: 960px) 46vw, 90vw"
              width={900}
              format="webp"
              quality={80}
              loading="eager"
              fetchpriority="high"
            />
            <figcaption class="mentor-caption">
              <span
                >{
                  copy(
                    "A note from your future self",
                    "ভবিষ্যতের তোমার একটা কথা",
                  )
                }</span
              ><p>
                {
                  copy(
                    "“Start small. Future you will be glad you did.”",
                    "“ছোট করে শুরু করো। পরে নিজেকেই ধন্যবাদ দেবে।”",
                  )
                }
              </p>
            </figcaption>
          </figure>
        </div>
        <nav class="orientation-note" aria-labelledby="orientation-title">
          <div class="note-top">
            <h2 id="orientation-title">
              {copy("Today’s orientation map", "আজকের orientation map")}
            </h2><p>
              {
                copy(
                  "Pick a stop. You do not need to read everything.",
                  "একটা জায়গা বেছে নাও। সবটা একসঙ্গে পড়তে হবে না।",
                )
              }
            </p>
          </div>
          <ol role="list">
            {
              mapSteps.map(
                ([en, bangla, description, bnDescription, path], index) => (
                  <li>
                    <a href={path.startsWith("#") ? path : href(path)}>
                      <>
                        <span class="map-number" aria-hidden="true">
                          0{index + 1}
                        </span>
                        <span class="map-copy">
                          <>
                            <strong>{copy(en, bangla)}</strong>
                            <small>{copy(description, bnDescription)}</small>
                          </>
                        </span>
                        <span class="map-arrow" aria-hidden="true">
                          →
                        </span>
                      </>
                    </a>
                  </li>
                ),
              )
            }
          </ol>
        </nav>
      </div>
    </section>

    <section
      class="home-section ai-section"
      id="ai-reality"
      aria-labelledby="ai-title"
    >
      <div class="container ai-layout">
        <div class="ai-art">
          <Image
            src={robotImage}
            alt={copy(
              "An AI study partner thoughtfully checking a result.",
              "একটি AI study partner মন দিয়ে ফলাফল যাচাই করছে।",
            )}
            widths={[180, 300, 480]}
            sizes="(min-width: 960px) 180px, 140px"
            width={300}
            format="webp"
            quality={80}
            loading="lazy"
          />
        </div>
        <div class="ai-copy">
          <p class="eyebrow">AI reality</p><h2 id="ai-title">
            {copy("AI is changing fast.", "AI দ্রুত বদলাচ্ছে।")}<br /><span
              >{copy("You can grow with it.", "তুমিও এগোতে পারো।")}</span
            >
          </h2><p>
            {
              copy(
                "Ignoring AI is not a strategy. Panicking is not one either. Learn to understand the problem, direct the tools, and check the answer.",
                "AI-কে ignore করা strategy নয়। Panic করাও নয়। Problem বোঝো, tool-কে নির্দেশ দাও, আর উত্তরটা ঠিক কি না যাচাই করো।",
              )
            }
          </p><a
            class="text-link"
            href={href("/ai/")}
            data-track-event="ai_guidance_viewed"
            data-track-param-career-id="overview"
            >{copy("Understand AI & My Career", "AI ও আমার career বুঝি")}
            <span aria-hidden="true">→</span></a
          >
        </div>
        <aside class="ai-note">
          <p class="eyebrow">
            {copy("The part you can control", "যেটা তোমার হাতে")}
          </p><p>
            {
              copy(
                "A career is a bundle of tasks—not a single replacement score. Foundations, judgment, debugging and responsibility still deserve your time.",
                "Career অনেক task-এর সমষ্টি—একটা replacement score নয়। Foundation, judgment, debugging আর responsibility শেখায় সময় দাও।",
              )
            }
          </p><strong
            >{
              copy(
                "Use AI. Also learn to notice when it is wrong.",
                "AI ব্যবহার করো। ভুল করলেও যেন ধরতে পারো।",
              )
            }</strong
          >
        </aside>
      </div>
    </section>

    <section
      class="home-section"
      id="starting-point"
      aria-labelledby="starting-title"
    >
      <div class="container">
        <div class="home-section-head">
          <div>
            <p class="eyebrow">
              {copy("Your next step starts here", "এখান থেকেই পরের ধাপ")}
            </p><h2 id="starting-title">
              {copy("Where are you right now?", "তুমি এখন কোথায়?")}
            </h2>
          </div><p>
            {
              copy(
                "There is no wrong starting point. Choose what sounds like you today—no quiz, account, or score.",
                "ভুল starting point বলে কিছু নেই। আজ তোমার সঙ্গে যেটা মেলে, বেছে নাও—quiz, account বা score নেই।",
              )
            }
          </p>
        </div>
        <div class="situation-list">
          {
            studentSituations.map((situation, index) => (
              <a
                href={withBase(situation.destination[locale])}
                data-track-event="starting_point_selected"
                data-track-param-situation-id={situation.id}
              >
                <>
                  <span class="situation-number" aria-hidden="true">
                    0{index + 1}
                  </span>
                  <span class="situation-copy">
                    <>
                      <strong>{t(situation.label, locale)}</strong>
                      <small>{t(situation.note, locale)}</small>
                    </>
                  </span>
                  <span class="situation-arrow" aria-hidden="true">
                    →
                  </span>
                </>
              </a>
            ))
          }
        </div>
        <p class="mentor-line goal-entry">
          <strong
            >{
              copy("Have a bigger goal in mind?", "বড় কোনো লক্ষ্য মাথায় আছে?")
            }</strong
          >{" "}
          {
            copy(
              "Global or local industry, remote work, study abroad, research, freelancing, or a tech business.",
              "Global বা local industry, remote কাজ, বিদেশে উচ্চশিক্ষা, research, freelancing বা tech business।",
            )
          }{" "}
          <a
            href={href("/goals/")}
            data-track-event="next_step_clicked"
            data-track-param-destination="goals"
            >{
              copy("Find your preparation path →", "প্রস্তুতির পথ বেছে নাও →")
            }</a
          >
        </p>
        <p class="mentor-line">
          <strong>{copy("Feeling behind?", "পিছিয়ে পড়েছ মনে হচ্ছে?")}</strong>{
            " "
          }
          {
            copy(
              "You do not have to catch everyone. You just need to stop standing still.",
              "সবার সঙ্গে পাল্লা দিতে হবে না। আজ একটা ছোট কাজ দিয়ে শুরু করলেই হয়।",
            )
          }{" "}
          <a href={href("/guidance/feel-behind/")}
            >{
              copy(
                "Make a realistic restart →",
                "বাস্তবসম্মতভাবে আবার শুরু করো →",
              )
            }</a
          >
        </p>
      </div>
    </section>

    <section
      class="home-section orientation-lessons"
      aria-labelledby="before-title"
    >
      <div class="container lesson-grid">
        <div>
          <p class="eyebrow">
            {copy("Before you choose anything", "কিছু choose করার আগে")}
          </p><h2 id="before-title">
            {copy("Take the pressure off.", "চাপটা একটু কমাও।")}
          </h2><ul class="rule-list">
            {realityChecks.map(([en, bangla]) => <li>{copy(en, bangla)}</li>)}
          </ul><p class="small-encouragement">
            {
              copy(
                "Your first direction is a draft, not a verdict.",
                "প্রথম direction একটা draft—চূড়ান্ত রায় নয়।",
              )
            }
          </p>
        </div>
        <div class="voices">
          <p class="eyebrow">
            {copy("Veteran orientation voices", "অভিজ্ঞদের ছোট্ট পরামর্শ")}
          </p><h2>
            {copy("A little senior perspective.", "একটু senior perspective।")}
          </h2><p class="voice-disclaimer">
            {
              copy(
                "Common industry lessons, not testimonials or invented professionals.",
                "পরিচিত industry lesson—testimonial বা বানানো professional-এর কথা নয়।",
              )
            }
          </p>
          {
            voices.slice(0, 2).map(([role, en, bangla]) => (
              <blockquote>
                <>
                  <p>“{copy(en, bangla)}”</p>
                  <cite>{role}</cite>
                </>
              </blockquote>
            ))
          }
          <details class="more-voices">
            <summary
              >{
                copy("Three more perspectives", "আরও তিনটি perspective")
              }</summary
            >{
              voices.slice(2).map(([role, en, bangla]) => (
                <blockquote>
                  <>
                    <p>“{copy(en, bangla)}”</p>
                    <cite>{role}</cite>
                  </>
                </blockquote>
              ))
            }
          </details>
        </div>
      </div>
    </section>

    <section
      class="home-section"
      id="landscape"
      aria-labelledby="landscape-title"
    >
      <div class="container">
        <div class="home-section-head">
          <div>
            <p class="eyebrow">
              {copy("The CSE career landscape", "CSE career landscape")}
            </p><h2 id="landscape-title">
              {
                copy(
                  "Different minds. Different kinds of work.",
                  "আলাদা আগ্রহ। আলাদা ধরনের কাজ।",
                )
              }
            </h2>
          </div><p>
            {
              copy(
                "Start with a problem you would like to solve. The job titles can come next.",
                "কোন ধরনের problem solve করতে ভালো লাগতে পারে, সেটা দিয়ে শুরু করো। Job title পরে আসুক।",
              )
            }
          </p>
        </div>
        <div class="family-map">
          {
            careerFamilies.map((family, index) => (
              <article class="family" data-accent={family.accent}>
                <>
                  <span class="family-symbol" aria-hidden="true">
                    {familySymbols[index]}
                  </span>
                  <h3>{t(family.title, locale)}</h3>
                  <p>{t(family.description, locale)}</p>
                  <div class="family-links">
                    {family.careerIds.map((id) => {
                      const career = careerById.get(id)!;
                      return (
                        <a
                          href={href(`/careers/${career.slug}/`)}
                          data-track-event="career_family_opened"
                          data-track-param-family-id={family.id}
                        >
                          {t(career.title, locale)}{" "}
                          <span aria-hidden="true">↗</span>
                        </a>
                      );
                    })}
                  </div>
                </>
              </article>
            ))
          }
        </div>
        <div class="section-footer">
          <a class="text-link" href={href("/careers/")}
            >{copy("Explore every career guide →", "সব career guide দেখো →")}</a
          ><a class="text-link" href={href("/compare/")}
            >{
              copy(
                "Two paths caught your eye? Compare them →",
                "দুটি path ভালো লাগছে? Compare করো →",
              )
            }</a
          >
        </div>
      </div>
    </section>

    <section
      class="home-section experiment-section"
      id="experiments"
      aria-labelledby="try-title"
    >
      <div class="container">
        <div class="home-section-head">
          <div>
            <p class="eyebrow">
              {copy("Try before you choose", "Choose করার আগে try করো")}
            </p><h2 id="try-title">
              {
                copy(
                  "One small experiment. A much better clue.",
                  "ছোট একটা experiment। অনেকটা পরিষ্কার ধারণা।",
                )
              }
            </h2>
          </div><p>
            {
              copy(
                "A salary video cannot tell you whether you enjoy the work. A safe, 60–120 minute experiment can give you a first clue.",
                "Salary video বলে দেবে না কাজটা তোমার ভালো লাগবে কি না। Safe, ৬০–১২০ মিনিটের experiment একটা ধারণা দেবে।",
              )
            }
          </p>
        </div>
        <div class="experiment-grid">
          {
            experimentIds.map((id) => {
              const experiment = experimentById.get(id)!;
              const career = careerById.get(id)!;
              return (
                <article>
                  <>
                    <span class="tag">{experiment.duration}</span>
                    <h3>{t(career.title, locale)}</h3>
                    <p>{t(experiment.title, locale)}</p>
                    <a
                      class="text-link"
                      href={withBase(experimentPath(locale, career.slug))}
                      data-track-event="career_experiment_started"
                      data-track-param-career-id={career.id}
                    >
                      {copy("Try this experiment →", "এই experiment করি →")}
                    </a>
                  </>
                </article>
              );
            })
          }
        </div>
        <div class="section-footer">
          <p>
            {
              copy(
                "Not enjoying one is useful information, too. You learned something about yourself.",
