---
import { Image } from "astro:assets";
import Breadcrumbs from "@/components/common/Breadcrumbs.astro";
import IndustryVoices from "@/components/common/IndustryVoices.astro";
import studyPartnersImage from "@/assets/illustrations/study-partners.png";
import robotImage from "@/assets/illustrations/ai-study-partner.png";
import { experimentPath, localePath, withBase } from "@/config/site";
import { careerById, careerFamilies } from "@/data/careers";
import { experimentById, experiments } from "@/data/experiments";
import { guidanceSourceById } from "@/data/guidance-sources";
import { studentSituations } from "@/data/situations";
import {
  aiEraDecisions,
  aiEraMessage,
  aiEraScenarioPaths,
  homepageAiSourceIds,
  homepageEntries,
  homepageIntro,
} from "@/data/homepage";
import { t } from "@/lib/i18n";
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { CareerId, Locale } from "@/types/content";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const bn = locale === "bn";
const copy = (en: string, bangla: string) => (bn ? bangla : en);
const href = (path: string) => withBase(localePath(locale, path));
const experimentIds: CareerId[] = [
  "backend-engineering",
  "cybersecurity",
  "machine-learning",
];
const moreExperimentIds: CareerId[] = [
  "data-analytics-bi",
  "ai-engineering",
  "application-security",
];
const mapSteps = [
  [
    "Explore careers",
    "ক্যারিয়ার চেনো",
    "What does the work involve?",
    "আসলে কী কাজ করতে হয়?",
    "#landscape",
  ],
  [
    "Try real work",
    "কাজ করে দেখো",
    "Would I enjoy doing it?",
    "কাজটা আমার ভালো লাগবে?",
    "#experiments",
  ],
  [
    "Find a learning path",
    "শেখার পথ খোঁজো",
    "What should I learn first?",
    "আগে কী শিখব?",
    "/roadmaps/",
  ],
  [
    "Prepare for a goal",
    "লক্ষ্যের প্রস্তুতি নাও",
    "How can I put my skills to work?",
    "শেখাটা কাজে লাগাব কীভাবে?",
    "/goals/",
  ],
] as const;
const realityChecks = [
  [
    "CSE is a landscape, not one career.",
    "CSE একটি ক্যারিয়ার নয়—অনেক ধরনের কাজের বিশাল জগৎ।",
  ],
  [
    "Programming is a tool. A framework is not a career plan.",
    "Programming একটি tool। আর framework-এর তালিকা কোনো career plan নয়।",
  ],
  [
    "You can explore deliberately without deciding your whole life.",
    "সারাজীবনের শপথ না নিয়েও ভেবেচিন্তে পথগুলো ঘুরে দেখা যায়।",
  ],
] as const;
const journey = [
  [
    "Understand",
    "বোঝো",
    "Find your starting point.",
    "এখন কোথায় আছ, বোঝো।",
    "#starting-point",
  ],
  [
    "Explore",
    "দেখো",
    "Look behind the job title.",
    "চাকরির নামের পেছনের আসল কাজ দেখো।",
    "/careers/",
  ],
  [
    "Compare",
    "তুলনা করো",
    "Compare the trade-offs.",
    "কাজের ভালো-মন্দ মিলিয়ে দেখো।",
    "/compare/",
  ],
  [
    "Try",
    "ট্রাই করো",
    "Get a little real evidence.",
    "ছোট কাজ করে নিজের অভিজ্ঞতা নাও।",
    "/try/",
  ],
  [
    "Prepare",
    "প্রস্তুত হও",
    "Build your foundations.",
    "ভিত্তিটা শক্ত করো।",
    "/roadmaps/",
  ],
  [
    "Adapt",
    "বদলাও",
    "Keep learning as work changes.",
    "কাজ বদলালে শেখাটাও বদলাও।",
    "/ai/",
  ],
] as const;
const familySymbols = ["{ }", "▤", "✦", "◇", "☁", "⌘", "λ", "↔"];
---

<BaseLayout
  locale={locale}
  title={copy(
    "CSE-Pothik — Find Your Direction in CSE",
    "CSE-Pothik — CSE-তে নিজের পথ খুঁজে নাও (বাংলা)",
  )}
  description={copy(
    "Free career guidance for CSE students: understand real career paths, try small experiments, build strong foundations and choose your next step in the AI era.",
    "CSE শিক্ষার্থীদের জন্য বিনামূল্যের ক্যারিয়ার গাইড—কাজের পথগুলো বোঝো, ছোট experiment করে দেখো, foundation গড়ো এবং AI যুগে নিজের পরের ধাপ বেছে নাও।",
  )}
  imageAlt={copy(
    "CSE-Pothik — Find your direction in CSE, illustrated with branching paths.",
    "CSE-Pothik — CSE-তে নিজের পথ খুঁজে নাও; বিভিন্ন দিকের পথচিহ্নসহ।",
  )}
>
  <Breadcrumbs locale={locale} items={[]} />
  <div class="homepage">
    <section class="hero" aria-labelledby="hero-title">
      <div class="container">
        <div class="hero-grid">
          <div class="hero-copy">
            <p class="eyebrow">{t(homepageIntro.eyebrow, locale)}</p>
            <h1 id="hero-title">
              {t(homepageIntro.title, locale)}{" "}<em
                >{t(homepageIntro.emphasis, locale)}</em
              >
            </h1>
            <p class="hero-lede">{t(homepageIntro.description, locale)}</p>
            <p class="hero-reassurance">
              {t(homepageIntro.reassurance, locale)}
            </p>
            <div class="button-row">
              <a
                class="button"
                href="#starting-point"
                data-track-event="next_step_clicked"
                data-track-param-destination="starting-point"
                >{t(homepageIntro.primaryAction, locale)}
                <span aria-hidden="true">→</span></a
              >
              <a class="button button--secondary" href={href("/careers/")}
                >{t(homepageIntro.secondaryAction, locale)}</a
              >
            </div>
            <p class="hero-outcome">{t(homepageIntro.outcome, locale)}</p>
          </div>
          <figure class="hero-visual">
            <Image
              src={studyPartnersImage}
              alt={copy(
                "A Chakma woman holds a QA checklist tablet between two teammates at laptops, all three smiling toward you.",
                "ল্যাপটপে কাজ করা দুই সতীর্থের মাঝে দাঁড়িয়ে ট্যাবলেটে সফটওয়্যার পরীক্ষার তালিকা দেখাচ্ছে এক চাকমা তরুণী; তিনজনই তোমার দিকে তাকিয়ে হাসছে।",
              )}
              widths={[400, 640, 900]}
              sizes="(min-width: 960px) 46vw, 90vw"
              width={900}
              format="webp"
              quality={80}
              loading="eager"
              fetchpriority="high"
            />
            <figcaption class="mentor-caption">
              <span
                >{
                  copy(
                    "A note from your future self",
                    "ভবিষ্যতের তোমার একটা কথা",
                  )
                }</span
              ><p>
                {
                  copy(
                    "“Start small. Future you will be glad you did.”",
                    "“ছোট করে শুরু করো। পরে নিজেকেই ধন্যবাদ দেবে।”",
                  )
                }
              </p>
            </figcaption>
          </figure>
        </div>
        <nav class="orientation-note" aria-labelledby="orientation-title">
          <div class="note-top">
            <h2 id="orientation-title">
              {copy("Today’s orientation map", "আজ কোথা থেকে শুরু করবে")}
            </h2><p>
              {
                copy(
                  "Pick a stop. You do not need to read everything.",
                  "একটা জায়গা বেছে নাও। সবটা একসঙ্গে পড়তে হবে না।",
                )
              }
            </p>
          </div>
          <ol role="list">
            {
              mapSteps.map(
                ([en, bangla, description, bnDescription, path], index) => (
                  <li>
                    <a href={path.startsWith("#") ? path : href(path)}>
                      <>
                        <span class="map-number" aria-hidden="true">
                          0{index + 1}
                        </span>
                        <span class="map-copy">
                          <>
                            <strong>{copy(en, bangla)}</strong>
                            <small>{copy(description, bnDescription)}</small>
                          </>
                        </span>
                        <span class="map-arrow" aria-hidden="true">
                          →
                        </span>
                      </>
                    </a>
                  </li>
                ),
              )
            }
          </ol>
        </nav>
      </div>
    </section>

    <section
      class="home-section ai-section"
      id="ai-reality"
      aria-labelledby="ai-title"
    >
      <div class="container">
        <div class="ai-intro">
          <div class="ai-art">
            <Image
              src={robotImage}
              alt={copy(
                "An AI study partner thoughtfully checking a result.",
                "একটি AI study partner মন দিয়ে ফলাফল যাচাই করছে।",
              )}
              widths={[180, 300, 480]}
              sizes="(min-width: 960px) 180px, 120px"
              width={300}
              format="webp"
              quality={80}
              loading="lazy"
            />
          </div>
          <div class="ai-copy">
            <p class="eyebrow">{t(aiEraMessage.eyebrow, locale)}</p>
            <h2 id="ai-title">{t(aiEraMessage.title, locale)}</h2>
            <p>{t(aiEraMessage.introduction, locale)}</p>
          </div>
          <aside class="ai-note">
            <p class="eyebrow">
              {copy("The shift", "যে পরিবর্তনটা বুঝতে হবে")}
            </p>
            <strong>{t(aiEraMessage.takeaway, locale)}</strong>
          </aside>
        </div>

        <div class="decision-heading">
          <p class="eyebrow">
            {copy("A 60-second decision tree", "৬০ সেকেন্ডের decision tree")}
          </p>
          <h3>
            {
              copy(
                "AI produced an answer. What do you do next?",
                "AI উত্তর দিয়েছে। এবার তুমি কী করবে?",
              )
            }
          </h3>
        </div>
        <ol class="ai-decision-tree" role="list">
          {
            aiEraDecisions.map((decision, index) => (
              <li data-step={decision.id}>
                <div class="decision-label">
                  <span aria-hidden="true">0{index + 1}</span>
                  <strong>{t(decision.label, locale)}</strong>
                </div>
                <h4>{t(decision.question, locale)}</h4>
                <dl>
                  <div class="branch branch--pause">
                    <dt>{copy("Not yet", "এখনও না")}</dt>
                    <dd>{t(decision.no, locale)}</dd>
                  </div>
                  <div class="branch branch--go">
                    <dt>{copy("Yes", "হ্যাঁ")}</dt>
                    <dd>{t(decision.yes, locale)}</dd>
                  </div>
                </dl>
              </li>
            ))
          }
        </ol>

        <details class="ai-scenario">
          <summary>{t(aiEraMessage.scenarioSummary, locale)}</summary>
          <div class="scenario-body">
            <p class="scenario-opening">
              {t(aiEraMessage.scenarioOpening, locale)}
            </p>
            <div class="scenario-grid">
              {
                aiEraScenarioPaths.map((path, index) => (
                  <article data-outcome={path.id}>
                    <span aria-hidden="true">0{index + 1}</span>
                    <h4>{t(path.title, locale)}</h4>
                    <p>{t(path.body, locale)}</p>
                    <strong>{t(path.consequence, locale)}</strong>
                  </article>
                ))
              }
            </div>
            <p class="scenario-closing">{t(aiEraMessage.closing, locale)}</p>
          </div>
        </details>

        <div class="ai-actions">
          <p>
            <strong
              >{
                copy(
                  "Evidence behind this framing:",
                  "এই ভাবনার পেছনের evidence:",
                )
              }</strong
            >{" "}
            {
              homepageAiSourceIds.map((id, index) => {
                const source = guidanceSourceById.get(id)!;
                return (
                  <>
                    <a
                      href={source.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-describedby="external-link-description"
                      data-track-event="learning_resource_clicked"
                      data-track-param-resource-id={source.id}
                      data-track-param-provider={source.provider}
                    >
                      {source.provider} <span aria-hidden="true">↗</span>
                    </a>
                    {index < homepageAiSourceIds.length - 1 ? " · " : ""}
                  </>
                );
              })
            }
          </p>
          <div class="button-row">
            <a
              class="button"
              href={href("/ai/")}
              data-track-event="ai_guidance_viewed"
              data-track-param-career-id="overview"
              >{
                copy(
                  "Build an AI-resilient practice",
                  "AI-resilient practice বানাও",
                )
              }</a
            >
            <a
              class="button button--secondary"
              href={href("/guidance/software-engineering-foundations/")}
              >{
                copy(
                  "Strengthen engineering foundations",
                  "Engineering foundation শক্ত করো",
                )
              }</a
            >
          </div>
        </div>
      </div>
    </section>

    <section
      class="home-section"
      id="starting-point"
      aria-labelledby="starting-title"
    >
      <div class="container">
        <div class="home-section-head">
          <div>
            <p class="eyebrow">
              {copy("Your next step starts here", "এখান থেকেই পরের ধাপ")}
            </p><h2 id="starting-title">
              {copy("What would help you today?", "আজ কোনটা তোমার কাজে লাগবে?")}
            </h2>
          </div><p>
            {
              copy(
                "Pick one route. You can change direction later—no quiz, account, or perfect answer needed.",
                "একটা পথ বেছে নাও। পরে বদলাতেই পারো—quiz, account বা নিখুঁত উত্তর লাগবে না।",
              )
            }
          </p>
        </div>
        <nav aria-labelledby="starting-title">
          <ul class="entry-list" role="list">
            {
              homepageEntries.map((entry, index) => (
                <li>
                  <a
                    href={href(entry.destination)}
                    data-home-entry={entry.id}
                    data-track-event="next_step_clicked"
                    data-track-param-destination={entry.analyticsDestination}
                  >
                    <span class="entry-number" aria-hidden="true">
                      0{index + 1}
                    </span>
                    <span class="entry-copy">
                      <>
                        <strong>{t(entry.label, locale)}</strong>
                        <span>{t(entry.note, locale)}</span>
                      </>
                    </span>
                    <span class="entry-arrow" aria-hidden="true">
                      →
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <aside class="first-role-prompt" aria-labelledby="first-role-title">
          <div>
            <p class="eyebrow">
              {
                copy(
                  "Trying to enter software industry?",
                  "Software industry-তে ঢোকার চেষ্টা করছ?",
                )
              }
            </p>
            <h3 id="first-role-title">
              {
                copy(
                  "Choose an entry route that fits your problem-solving baseline.",
                  "Problem solving এখন যতটুকু পারো, তার সঙ্গে মেলে এমন entry route বেছে নাও।",
                )
              }
            </h3>
            <p>
              {
                copy(
                  "Strong in CP, still building the foundation, or entering through project evidence? See what to try now, what to add next and when to start applying.",
                  "CP-তে ভালো, foundation এখনও গড়ছ, নাকি project evidence দিয়ে শুরু করবে? এখন কী করবে, এরপর কী যোগ করবে আর কখন আবেদন শুরু করবে—এক জায়গায় দেখে নাও।",
                )
              }
            </p>
          </div>
          <a
            href={href("/guidance/first-software-role/#entry-routes")}
            data-track-event="next_step_clicked"
            data-track-param-destination="first-software-role"
            >{copy("Choose my entry route", "আমার entry route বেছে নিই")} →</a
          >
        </aside>
        <details class="situation-options" id="your-situation">
          <summary
            >{
              copy(
                "Already studying? Find a more specific starting point",
                "আগেই পড়াশোনা শুরু করেছ? নিজের অবস্থার সঙ্গে মিলিয়ে দেখো",
              )
            }</summary
          >
          <h3>{copy("Where are you right now?", "তুমি এখন কোথায়?")}</h3>
          <p>
            {
              copy(
                "New, undecided, worried about AI, or feeling behind? Choose what sounds like you today.",
                "তুমি কি নতুন, দ্বিধায় আছ, AI নিয়ে চিন্তিত, নাকি পিছিয়ে পড়েছ মনে হচ্ছে? আজ যে কথাটি নিজের সঙ্গে মেলে, সেটি বেছে নাও।",
              )
            }
          </p>
          <div class="situation-list">
            {
              studentSituations.map((situation, index) => (
                <a
                  href={withBase(situation.destination[locale])}
                  data-track-event="starting_point_selected"
                  data-track-param-situation-id={situation.id}
                >
                  <>
                    <span class="situation-number" aria-hidden="true">
                      0{index + 1}
                    </span>
                    <span class="situation-copy">
                      <>
                        <strong>{t(situation.label, locale)}</strong>
                        <small>{t(situation.note, locale)}</small>
                      </>
                    </span>
                    <span class="situation-arrow" aria-hidden="true">
                      →
                    </span>
                  </>
                </a>
              ))
            }
          </div>
        </details>
        <p class="mentor-line">
          <strong>{copy("Feeling behind?", "পিছিয়ে পড়েছ মনে হচ্ছে?")}</strong>{
            " "
          }
          {
            copy(
              "You do not have to catch everyone. You just need to stop standing still.",
              "সবার সঙ্গে পাল্লা দিতে হবে না। আজ একটা ছোট কাজ দিয়ে শুরু করলেই হয়।",
            )
          }{" "}
          <a href={href("/guidance/feel-behind/")}
            >{
              copy(
                "Make a realistic restart →",
                "বাস্তবসম্মতভাবে আবার শুরু করো →",
              )
            }</a
          >
        </p>
      </div>
    </section>

    <section
      class="home-section orientation-lessons"
      aria-labelledby="before-title"
    >
      <div class="container lesson-grid">
        <div>
          <p class="eyebrow">
            {copy("Before you choose anything", "কিছু বেছে নেওয়ার আগে")}
          </p><h2 id="before-title">
            {copy("Take the pressure off.", "চাপটা একটু কমাও।")}
          </h2><ul class="rule-list">
            {realityChecks.map(([en, bangla]) => <li>{copy(en, bangla)}</li>)}
          </ul><p class="small-encouragement">
            {
              copy(
                "Your first direction is a draft, not a verdict.",
                "প্রথম দিকনির্দেশনা একটি draft—চূড়ান্ত রায় নয়।",
              )
            }
          </p>
        </div>
        <IndustryVoices locale={locale} variant="featured" />
      </div>
    </section>

    <section
      class="home-section"
      id="landscape"
      aria-labelledby="landscape-title"
    >
      <div class="container">
        <div class="home-section-head">
          <div>
            <p class="eyebrow">
              {copy("The CSE career landscape", "CSE career landscape")}
            </p><h2 id="landscape-title">
              {
                copy(
                  "What does this work actually involve?",
                  "কোন ক্যারিয়ারে আসলে কী কাজ?",
                )
              }
            </h2>
          </div><p>
            {
              copy(
                "Explore different kinds of problems, daily tasks and trade-offs. Open a career that makes you curious—you are exploring, not committing.",
