---
import Breadcrumbs from "@/components/common/Breadcrumbs.astro";
import { careerById } from "@/data/careers";
import { firstSoftwareRoleGuide as guide } from "@/data/first-software-role";
import { guidanceSourceById } from "@/data/guidance-sources";
import { careerPath, localePath, roadmapPath, withBase } from "@/config/site";
import { t } from "@/lib/i18n";
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { Locale } from "@/types/content";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const bn = locale === "bn";
const href = (path: string) => withBase(localePath(locale, path));
const sections = [
  { id: "start", title: bn ? "নিজের জায়গা থেকে শুরু" : "Start where you are" },
  {
    id: "entry-routes",
    title: bn ? "নিজের entry route বেছে নাও" : "Choose an entry route",
  },
  ...guide.stages.map((stage) => ({
    id: `stage-${stage.id}`,
    title: t(stage.title, locale),
  })),
  {
    id: "interview-baseline",
    title: bn ? "ইন্টারভিউয়ের ন্যূনতম প্রস্তুতি" : "Interview baseline",
  },
  {
    id: "feedback-loop",
    title: bn ? "ফল দেখে পরিকল্পনা বদলাও" : "Read the response",
  },
  { id: "traps", title: bn ? "যে ফাঁদগুলো এড়াবে" : "Traps to avoid" },
  { id: "this-week", title: bn ? "এই সপ্তাহের cycle" : "This week's cycle" },
  {
    id: "sources",
    title: bn ? "তথ্যের উৎস ও পরের পথ" : "Sources & next paths",
  },
];
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: t(guide.title, locale),
    description: t(guide.summary, locale),
    inLanguage: locale,
    isAccessibleForFree: true,
    author: { "@type": "Organization", name: "CSE Compass" },
    mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: bn ? "হোম" : "Home",
        item: new URL(href("/"), Astro.site).href,
      },
      {
        "@type": "ListItem",
        position: 2,
        name: t(guide.title, locale),
        item: new URL(Astro.url.pathname, Astro.site).href,
      },
    ],
  },
];
---

<BaseLayout
  locale={locale}
  title={t(guide.title, locale)}
  description={t(guide.summary, locale)}
  structuredData={structuredData}
>
  <Breadcrumbs
    locale={locale}
    items={[
      { label: bn ? "দিকনির্দেশনা" : "Guidance" },
      {
        label: bn
          ? "সফটওয়্যার ইন্ডাস্ট্রিতে প্রবেশ"
          : "Enter software industry",
      },
    ]}
  />
  <header class="page-hero container first-role-hero">
    <p class="eyebrow">
      {
        bn
          ? "ফাইনাল সেমিস্টার · সদ্য স্নাতক · ক্যারিয়ার বদল"
          : "Final semester · recent graduate · career transition"
      }
    </p>
    <h1>{t(guide.title, locale)}</h1>
    <p class="lede">{t(guide.summary, locale)}</p>
    <div class="button-row">
      <a class="button" href="#start"
        >{bn ? "আমার জায়গা থেকে শুরু" : "Start from my situation"}</a
      ><a class="button button--secondary" href="#this-week"
        >{bn ? "এই সপ্তাহের পরিকল্পনা" : "Give me this week's plan"}</a
      >
    </div>
  </header>

  <div class="container role-layout">
    <aside class="role-index">
      <details open>
        <summary>{bn ? "এই গাইডে যা আছে" : "In this guide"}</summary>
        <nav aria-label={bn ? "গাইডের বিভাগ" : "Guide sections"}>
          <ol>
            {
              sections.map((section) => (
                <li>
                  <a href={`#${section.id}`}>{section.title}</a>
                </li>
              ))
            }
          </ol>
        </nav>
      </details>
    </aside>

    <div class="role-content">
      <section class="role-section" id="start">
        <p class="eyebrow">
          {bn ? "এটি readiness score নয়" : "Not a readiness score"}
        </p>
        <h2>
          {bn ? "আজ কোথায় আটকে আছ?" : "Where is the process stuck today?"}
        </h2>
        <p>{t(guide.reality, locale)}</p>
        <nav
          aria-label={bn ? "কোথা থেকে শুরু করবে" : "Choose a starting point"}
        >
          <ul class="start-list">
            {
              guide.starts.map((start) => (
                <li>
                  <a
                    href={`#${start.destination}`}
                    data-track-event="next_step_clicked"
                    data-track-param-destination={`first-role/${start.id}`}
                  >
                    <span>
                      <strong>{t(start.title, locale)}</strong>
                      <small>{t(start.note, locale)}</small>
                    </span>
                    <span aria-hidden="true">→</span>
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <div class="reality-note">
          <strong>{bn ? "মূল কথা:" : "The core idea:"}</strong>{" "}
          {
            bn
              ? "আবার শূন্য থেকে শুরু নয়। যা আছে, সেটিকেই সৎ ও review করা যায় এমন evidence-এ বদলে focused hiring cycle চালাও।"
              : "Do not restart from zero. Turn what you have into honest, reviewable evidence and run one focused hiring cycle."
          }
        </div>
      </section>

      <section class="role-section" id="entry-routes">
        <p class="eyebrow">
          {bn ? "একটি পথ সবার জন্য নয়" : "One entrance does not fit everyone"}
        </p>
        <h2>
          {
            bn
              ? "আজ তোমার problem-solving অবস্থার সঙ্গে মেলে—এমন route বেছে নাও।"
              : "Choose the route that matches your problem-solving baseline today."
          }
        </h2>
        <p class="stage-why">
          {
            bn
              ? "এগুলো ranking নয়, আর কোনো route-ই চাকরির guarantee নয়। Target role-এর hiring format বদলালে তোমার route-ও বদলাতে পারে। প্রথম card-টি ভালো শোনায় বলে সেটি বেছে নিও না—যেটি সত্যি, সেটি বেছে নাও।"
              : "These are routes, not rankings or job guarantees. Your lane can change when the target role's hiring format changes. Choose the honest description—not the card that sounds most impressive."
          }
        </p>
        <div class="entry-route-list">
          {
            guide.entryRoutes.map((route, index) => (
              <article
                class="entry-route"
                id={`entry-route-${route.id}`}
                data-entry-route={route.id}
              >
                <div class="entry-route__identity">
                  <span aria-hidden="true">0{index + 1}</span>
                  <div>
                    <p class="entry-route__label">
                      {bn ? "তোমার সঙ্গে মিললে" : "Choose this if"}
                    </p>
                    <h3>{t(route.title, locale)}</h3>
                    <p>{t(route.signal, locale)}</p>
                  </div>
                </div>
                <div class="entry-route__plan">
                  <p class="entry-route__strategy">
                    {t(route.strategy, locale)}
                  </p>
                  <dl>
                    <div>
                      <dt>{bn ? "এখন" : "Now"}</dt>
                      <dd>{t(route.now, locale)}</dd>
                    </div>
                    <div>
                      <dt>{bn ? "এরপর" : "Next"}</dt>
                      <dd>{t(route.next, locale)}</dd>
                    </div>
                    <div>
                      <dt>{bn ? "আবেদন শুরু করবে যখন" : "Apply when"}</dt>
                      <dd>{t(route.applyWhen, locale)}</dd>
                    </div>
                  </dl>
                  <a
                    href={`#${route.destination}`}
                    data-track-event="next_step_clicked"
                    data-track-param-destination={`first-role/route-${route.id}`}
                  >
                    {bn ? "এই route ধরে পরের ধাপ" : "Continue with this route"}{" "}
                    →
                  </a>
                </div>
              </article>
            ))
          }
        </div>
      </section>

      {
        guide.stages.map((stage, index) => (
          <section class="role-section role-stage" id={`stage-${stage.id}`}>
            <p class="eyebrow">
              {bn
                ? `ধাপ ${index + 1} / ${guide.stages.length}`
                : `Stage ${index + 1} / ${guide.stages.length}`}
            </p>
            <h2>{t(stage.title, locale)}</h2>
            <p class="stage-why">{t(stage.why, locale)}</p>
            <h3>{bn ? "যা করবে" : "What to do"}</h3>
            <ul class="task-list">
              {stage.tasks.map((task) => (
                <li>{t(task, locale)}</li>
              ))}
            </ul>
            <div class="evidence-note">
              <h3>{bn ? "এখন যথেষ্ট যখন…" : "Enough for now when…"}</h3>
              <p>{t(stage.evidence, locale)}</p>
            </div>
            <p class="not-yet">
              <strong>{bn ? "এখনই নয়: " : "Not yet: "}</strong>
              {t(stage.notYet, locale)}
            </p>
            <a class="reference-link" href={`#source-${stage.sourceId}`}>
              {bn ? "এই ধাপের তথ্যসূত্র" : "Reference for this stage"} ↓
            </a>
          </section>
        ))
      }

      <section class="role-section" id="interview-baseline">
        <p class="eyebrow">{bn ? "ACM নিয়ে বাস্তবতা" : "The ACM reality"}</p>
        <h2>
          {
            bn
              ? "CP একটি শক্তিশালী advantage হতে পারে—একমাত্র দরজা নয়।"
              : "CP can be a strong advantage—not the only entrance."
          }
        </h2>
        <p>
          {
            bn
              ? "কিছু প্রতিষ্ঠান কঠিন algorithmic interview নেয়; অন্যরা role knowledge, debugging, project discussion বা take-home work-এ বেশি জোর দেয়। আসল vacancy ও recruiter-এর কাছ থেকে জানা format দেখে প্রস্তুতির গভীরতা ঠিক করো। ACM/ICPC দারুণ অনুশীলনের পথ, কিন্তু সব junior job-এর বাধ্যতামূলক দরজা নয়।"
              : "Some employers use strong algorithmic interviews; others emphasize role knowledge, debugging, project discussion or take-home work. Let the actual vacancy and recruiter-confirmed format determine the depth. ACM/ICPC is a valuable practice track—not a universal junior-job prerequisite."
          }
        </p>
        <div class="baseline-grid">
          {
            guide.interviewBaseline.map((item) => (
              <article>
                <h3>{t(item.title, locale)}</h3>
                <p>{t(item.description, locale)}</p>
              </article>
            ))
          }
        </div>
        <p>
          <a href={href("/guidance/competitive-programming/")}
            >{
              bn
                ? "DSA foundation আর optional competitive track আলাদা করে দেখো"
                : "See the difference between a DSA foundation and the optional competitive track"
            } →</a
          >
        </p>
      </section>

      <section class="role-section" id="feedback-loop">
        <p class="eyebrow">
          {
            bn
              ? "একটি rejection পুরো গল্প বলে না"
              : "Rejection = incomplete data"
          }
        </p>
        <h2>
          {
            bn
              ? "আবেদনের process ঠিক কোথায় আটকে যাচ্ছে, সেটি দেখো।"
              : "Notice where the process stops."
          }
        </h2>
        <p>
          {
            bn
              ? "একটি result দেখে diagnosis হয় না। কয়েকটি উপযুক্ত চেষ্টার pattern দেখো, তথ্য আর অনুমান আলাদা করো, তারপর একবারে একটি জিনিস বদলাও।"
              : "One result is not a diagnosis. Look for a pattern across several suitable attempts, separate facts from guesses, then change one variable."
          }
        </p>
        <div class="feedback-list">
          {
            guide.feedbackSignals.map((item) => (
              <article>
                <h3>{t(item.signal, locale)}</h3>
                <p>
                  <strong>{bn ? "সম্ভাব্য gap: " : "Possible gap: "}</strong>
                  {t(item.likelyGap, locale)}
                </p>
                <p>
                  <strong>{bn ? "পরের test: " : "Next test: "}</strong>
                  {t(item.nextAction, locale)}
                </p>
              </article>
            ))
          }
        </div>
      </section>

      <section class="role-section" id="traps">
        <p class="eyebrow">{bn ? "যা না করাই ভালো" : "What not to do"}</p>
        <h2>
          {
            bn
              ? "ব্যস্ত দেখায়, কিন্তু এগোতে সাহায্য করে না।"
              : "Activity that looks busy but adds little signal."
          }
        </h2>
        <ul class="task-list">
          {guide.pitfalls.map((pitfall) => <li>{t(pitfall, locale)}</li>)}
        </ul>
      </section>

      <section class="role-section" id="this-week">
        <div class="week-card">
          <p class="eyebrow">
            {bn ? "একটি সম্পূর্ণ ছোট cycle" : "One complete mini-cycle"}
          </p>
          <h2>{bn ? "এই সপ্তাহে এটুকুই করো।" : "Make this week concrete."}</h2>
          <p>{t(guide.thisWeek, locale)}</p>
        </div>
      </section>

      <section class="role-section" id="sources">
        <p class="eyebrow">
          {bn ? "তথ্যের উৎস ও যাচাই" : "Sources & verification"}
        </p>
        <h2>
          {
            bn
              ? "নিয়ম বদলায়—আসল job posting দেখে নাও।"
              : "Requirements change—check the actual opening."
          }
        </h2>
        <p>
          {
            bn
              ? "এই guide CSE Compass-এর editorial synthesis; কোনো employer-এর selection বা offer নিশ্চিত করে না। বর্তমান role-এর eligibility, interview format, deadline আর অনুমোদিত tool official source বা recruiter-এর কাছ থেকে যাচাই করো। বাইরের source-গুলোর বেশির ভাগই English।"
              : "This guide is CSE Compass editorial synthesis and no employer guarantees selection or an offer. Verify current eligibility, interview format, deadlines and permitted tools through the official opening or recruiter. External references are primarily in English."
          }
        </p>
        <ul class="source-list">
          {
            guide.sourceIds.map((id) => {
              const source = guidanceSourceById.get(id)!;
              return (
                <li id={`source-${id}`}>
                  <a
                    href={source.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    aria-describedby="external-link-description"
                    data-track-event="learning_resource_clicked"
                    data-track-param-resource-id={source.id}
                    data-track-param-provider={source.provider}
                  >
                    {source.provider} · {source.title}{" "}
                    <span aria-hidden="true">↗</span>
                  </a>
                  <p>{t(source.scope, locale)}</p>
                  <small>
                    {bn ? "পর্যালোচনা: " : "Reviewed: "}
                    <time datetime={source.lastReviewed}>
                      {source.lastReviewed}
                    </time>
                  </small>
                </li>
              );
            })
          }
        </ul>

        <h3>
          {
            bn
              ? "Role অনুযায়ী শেখার গভীরতা ঠিক করো"
              : "Choose role-specific depth"
          }
        </h3>
        <ul class="career-links">
          {
            guide.careerIds.map((id) => {
              const career = careerById.get(id)!;
              return (
                <li>
                  <a href={withBase(careerPath(locale, career.slug))}>
                    {t(career.title, locale)}
                  </a>
                  <a href={withBase(roadmapPath(locale, career.slug))}>
                    {bn ? "রোডম্যাপ" : "Roadmap"} →
                  </a>
                </li>
              );
            })
          }
        </ul>
        <div class="button-row">
          <a class="button" href={href("/goals/local-industry/")}
            >{bn ? "বাংলাদেশ industry plan" : "Bangladesh industry plan"}</a
          ><a
            class="button button--secondary"
            href={href("/guidance/final-year-project/")}
            >{
              bn
                ? "প্রজেক্টের প্রমাণ গুছানোর toolkit"
                : "Project evidence toolkit"
            }</a
          ><a href={href("/goals/remote-employment/")}
            >{bn ? "Remote চাকরির প্রস্তুতি" : "Prepare for remote roles"} →</a
          >
        </div>
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .first-role-hero h1 {
    max-width: 22ch;
  }
  .role-layout {
    display: grid;
    gap: 2rem;
    padding-bottom: 4rem;
  }
  .role-content {
    min-width: 0;
    max-width: 52rem;
  }
  .role-index details {
    padding: 1rem;
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
  }
  .role-index summary {
    min-height: 2rem;
    cursor: pointer;
    font-weight: 800;
  }
  .role-index ol,
  .start-list,
  .career-links {
    margin: 0.75rem 0 0;
    padding: 0;
    list-style: none;
  }
  .role-index li,
  .start-list li,
  .career-links li {
    margin: 0;
  }
  .role-index a {
    display: block;
    padding-block: 0.45rem;
    font-size: 0.88rem;
  }
  .role-section {
    padding-block: 2.75rem;
    border-top: 1px solid var(--color-border);
    scroll-margin-top: 6rem;
  }
  .role-section h2 {
    font-size: clamp(1.7rem, 3vw, 2.55rem);
  }
  .stage-why {
    color: var(--color-text-muted);
    font-size: 1.08rem;
  }
  .start-list {
    display: grid;
    gap: 0.65rem;
    margin-top: 1.5rem;
  }
  .start-list a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1rem;
    color: var(--color-text);
    border: 1px solid var(--color-border-strong);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
    text-decoration: none;
  }
  .start-list strong,
  .start-list small {
    display: block;
  }
  .start-list small {
    margin-top: 0.3rem;
    color: var(--color-text-muted);
    font-size: 0.88rem;
  }
  .reality-note,
  .evidence-note {
    margin-top: 1.5rem;
    padding: 1.2rem;
    border-inline-start: 3px solid var(--color-teal);
    background: var(--color-surface);
  }
  .evidence-note h3 {
    font-size: 1rem;
  }
  .evidence-note p {
    margin-bottom: 0;
  }
  .task-list {
    padding-inline-start: 1.25rem;
  }
  .entry-route-list {
    display: grid;
    gap: 1rem;
    margin-top: 1.75rem;
  }
  .entry-route {
    display: grid;
    gap: 1.2rem;
    scroll-margin-top: 6rem;
    padding: clamp(1.15rem, 3vw, 1.6rem);
    border: 1px solid var(--color-border-strong);
    border-inline-start: 4px solid var(--color-primary);
    border-radius: var(--radius-sm);
    background: var(--color-surface);
  }
  .entry-route:nth-child(2) {
    border-inline-start-color: var(--color-teal);
  }
  .entry-route:nth-child(3) {
    border-inline-start-color: var(--color-amber);
  }
  .entry-route__identity {
    display: grid;
    grid-template-columns: 2rem minmax(0, 1fr);
    gap: 0.8rem;
  }
  .entry-route__identity > span {
    color: var(--color-warm);
    font-size: 0.75rem;
    font-weight: 850;
    letter-spacing: 0.08em;
  }
  .entry-route__identity h3,
  .entry-route__identity p,
  .entry-route__plan p,
  .entry-route__plan dd {
    margin: 0;
  }
  .entry-route__identity h3 {
    font-size: clamp(1.15rem, 2vw, 1.4rem);
  }
  .entry-route__identity p:not(.entry-route__label),
  .entry-route__plan dd {
    margin-top: 0.45rem;
    color: var(--color-text-muted);
  }
  .entry-route__label {
    color: var(--color-primary-strong);
