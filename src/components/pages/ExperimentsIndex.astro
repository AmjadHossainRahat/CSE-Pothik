---
import Breadcrumbs from "@/components/common/Breadcrumbs.astro";
import DirectoryJumpNav from "@/components/common/DirectoryJumpNav.astro";
import { experimentPath, localePath, withBase } from "@/config/site";
import { careerById, careerFamilies } from "@/data/careers";
import { experiments } from "@/data/experiments";
import { t } from "@/lib/i18n";
import { collectionStructuredData } from "@/lib/seo";
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { Locale } from "@/types/content";
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const bn = locale === "bn";
const title = bn
  ? "ক্যারিয়ার বাছার আগে কাজ করে দেখুন"
  : "Career Experiments — Try Before You Choose";
const description = bn
  ? "নিরাপদ, beginner-friendly ও অল্প সময়ের experiment দিয়ে CSE-র আসল কাজের একটু স্বাদ নিন।"
  : "Safe, beginner-friendly, time-bounded CSE career experiments that let you feel a small version of the real work.";
const groupedExperiments = careerFamilies.map((family) => ({
  family,
  experiments: family.careerIds
    .map((careerId) =>
      experiments.find((experiment) => experiment.careerId === careerId),
    )
    .filter((experiment) => experiment !== undefined),
}));
const structuredData = collectionStructuredData({
  title,
  description,
  url: Astro.url.href,
  locale,
  homeUrl: new URL(withBase(localePath(locale, "/")), Astro.site).href,
  homeLabel: bn ? "হোম" : "Home",
  items: experiments.map((experiment) => {
    const career = careerById.get(experiment.careerId)!;
    return {
      name: t(experiment.title, locale),
      url: new URL(withBase(experimentPath(locale, career.slug)), Astro.site)
        .href,
    };
  }),
});
---

<BaseLayout
  locale={locale}
  title={title}
  description={description}
  structuredData={structuredData}
>
  <Breadcrumbs
    locale={locale}
    items={[{ label: bn ? "কাজ করে দেখুন" : "Try a Career" }]}
  />
  <header class="page-hero page-hero--compact container">
    <p class="eyebrow">
      {bn ? "বাছার আগে করে দেখুন" : "Try before you choose"}
    </p><h1>
      {
        bn
          ? "চাকরির নাম পছন্দ করার আগে কাজটা করে দেখুন।"
          : "Try the work before you fall for the title."
      }
    </h1><p class="lede">
      {
        bn
          ? "এগুলো course বা assessment নয়। ৬০–১২০ মিনিট মন দিয়ে কাজ করে দেখুন—কোন সমস্যায় আবার ফিরতে ইচ্ছে করে, সেটাই লক্ষ করুন।"
          : "These are not courses or assessments. They are focused 60–120 minute experiences for noticing which problems you want to revisit."
      }
    </p>
  </header>
  <DirectoryJumpNav
    eyebrow={bn ? "কাজের ধরনে যান" : "Jump by work family"}
    label={bn ? "কাজের বিভাগের তালিকা" : "Experiment family index"}
    items={groupedExperiments.map(({ family, experiments: items }) => ({
      id: `experiments-${family.id}`,
      label: t(family.title, locale),
      count: items.length,
    }))}
  />
  {
    groupedExperiments.map(({ family, experiments: items }, familyIndex) => (
      <section
        class:list={[
          "section",
          "directory-target",
          { "section--tinted": familyIndex % 2 === 0 },
        ]}
        id={`experiments-${family.id}`}
      >
        <div class="container">
          <div class="directory-heading">
            <p class="eyebrow">{t(family.title, locale)}</p>
            <h2>{t(family.description, locale)}</h2>
          </div>
          <div class="experiment-list">
            {items.map((experiment, index) => {
              const career = careerById.get(experiment.careerId)!;
              return (
                <article>
                  <span class="index">
                    {String(index + 1).padStart(2, "0")}
                  </span>
                  <div>
                    <p class="tag">{experiment.duration}</p>
                    <h3>{t(experiment.title, locale)}</h3>
                    <p>
                      <strong>{t(career.title, locale)}</strong> ·{" "}
                      {t(experiment.experienceGoals[0]!, locale)}
                    </p>
                    <a
                      href={withBase(experimentPath(locale, career.slug))}
                      data-track-event="career_experiment_started"
                      data-track-param-career-id={career.id}
                    >
                      {bn ? "কাজটি খুলে দেখি" : "Open experiment"}{" "}
                      <span aria-hidden="true">→</span>
                    </a>
                  </div>
                </article>
              );
            })}
          </div>
        </div>
      </section>
    ))
  }
  <section class="section">
    <div class="container callout callout--warm">
      <p class="callout__label">
        {bn ? "শেষে একটু ভেবে দেখুন" : "Reflection rule"}
      </p><h2>
        {
          bn
            ? "শেষ করাই সাফল্য নয়; নিজের সম্পর্কে সৎ কিছু বুঝতে পারাই সাফল্য।"
            : "Finishing is not the success. Noticing something honest is."
        }
      </h2><p>
        {
          bn
            ? "কোন অংশে সময় দ্রুত কেটেছে? কোনটা ক্লান্ত করেছে? এই কাজে আরও পাঁচ ঘণ্টা দিতে ইচ্ছে করবে? উত্তর কোথাও জমা হবে না—নিজের জন্য লিখে রাখুন।"
            : "Where did time move quickly? What drained you? Would you spend five more hours here? Nothing is saved; write the answer for yourself."
        }
      </p>
      <div class="button-row">
        <a class="button" href={withBase(localePath(locale, "/careers/"))}>
          {bn ? "ক্যারিয়ারের বিভাগে ফিরি" : "Explore career families"}
        </a>
        <a
          class="button button--secondary"
          href={withBase(localePath(locale, "/compare/"))}
        >
          {bn ? "দুটি ক্যারিয়ার মিলিয়ে দেখি" : "Compare two careers"}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>
<style>
  .experiment-list {
    border-top: 1px solid var(--color-border-strong);
  }
  .directory-heading {
    max-width: 52rem;
    margin-bottom: 2rem;
  }
  .directory-heading h2 {
    font-size: clamp(1.4rem, 3vw, 2rem);
  }
  .experiment-list article {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 1rem;
    padding: 1.8rem 0;
    border-bottom: 1px solid var(--color-border);
  }
  .index {
    color: var(--color-warm);
    font-size: 0.75rem;
    font-weight: 800;
  }
  .experiment-list h3 {
    margin: 1rem 0 0.5rem;
    font-size: clamp(1.4rem, 3vw, 2.2rem);
  }
  .experiment-list a {
    font-weight: 750;
  }
  .callout .button-row {
    margin-top: 1.25rem;
  }
</style>
