---
import Breadcrumbs from "@/components/common/Breadcrumbs.astro";
import { careerPath, roadmapPath, withBase } from "@/config/site";
import { careerById, careerFamilies, careers } from "@/data/careers";
import { t } from "@/lib/i18n";
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { Locale } from "@/types/content";
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const bn = locale === "bn";
const groupedCareers = careerFamilies.map((family) => ({
  family,
  careers: family.careerIds.map((id) => careerById.get(id)!),
}));
const dimensionRows = [
  ["coding", bn ? "কোডিং" : "Coding"],
  ["mathematics", bn ? "গণিত" : "Mathematics"],
  ["systems", bn ? "সিস্টেমের গভীরতা" : "Systems depth"],
  ["investigation", bn ? "অনুসন্ধান" : "Investigation"],
  ["creativity", bn ? "সৃজনশীলতা" : "Visual / creative work"],
  ["communication", bn ? "যোগাযোগ" : "Communication"],
  ["production", bn ? "Production-এর দায়িত্ব" : "Production responsibility"],
] as const;
const level = (value: number) =>
  value === 3
    ? bn
      ? "High"
      : "High"
    : value === 2
      ? bn
        ? "Medium"
        : "Medium"
      : bn
        ? "Lower"
        : "Lower";
---

<BaseLayout
  locale={locale}
  title={bn ? "CSE ক্যারিয়ার তুলনা" : "Compare CSE Careers"}
  description={bn
    ? "২–৩টি CSE ক্যারিয়ারের আসল কাজ, চাপ, AI-এর প্রভাব, রোডম্যাপ আর experiment পাশাপাশি মিলিয়ে দেখুন।"
    : "Compare 2–3 CSE careers by real work, pressure, AI exposure, roadmaps and experiments in a mobile-friendly format."}
>
  <Breadcrumbs
    locale={locale}
    items={[{ label: bn ? "ক্যারিয়ার তুলনা" : "Compare" }]}
  />
  <header class="page-hero page-hero--compact container">
    <p class="eyebrow">
      {bn ? "Ranking নয়—নিজের সঙ্গে মিল খুঁজুন" : "Compare for fit—not rank"}
    </p><h1>
      {
        bn
          ? "‘High’ মানে ভালো নয়—শুধু কাজের ধরন আলাদা।"
          : "High is not better. The work is simply different."
      }
    </h1><p class="lede">
      {
        bn
          ? "২–৩টি ক্যারিয়ার বেছে কাজের ধরন, অস্বস্তিকর অংশ আর পরের evidence মিলিয়ে দেখুন। এখানে fit score নেই—ক্যারিয়ারের সিদ্ধান্ত spreadsheet-এর formula নয় যে Enter চাপলেই উত্তর বের হবে।"
          : "Choose 2–3 careers and compare work style, uncomfortable parts and next evidence. There is no fit score because career decisions are not spreadsheet formulas."
      }
    </p>
  </header>
  <section class="section section--tinted">
    <div class="container">
      <fieldset class="compare-picker">
        <legend>{bn ? "২–৩টি ক্যারিয়ার বেছে নিন" : "Choose 2–3 careers"}</legend
        ><p id="compare-help" class="muted">
          {
            bn
              ? "কমপক্ষে ২টি, সর্বোচ্চ ৩টি। URL বদলাবে, তাই চাইলে ফলটি share করতে পারবে।"
              : "Minimum 2, maximum 3. The URL updates so you can share the comparison."
          }
        </p><div class="career-option-groups">
          {
            groupedCareers.map(({ family, careers: familyCareers }) => (
              <section
                class="career-option-group"
                role="group"
                aria-labelledby={`compare-family-${family.id}`}
              >
                <h2 id={`compare-family-${family.id}`}>
                  {t(family.title, locale)}
                </h2>
                <div class="career-options">
                  {familyCareers.map((career) => {
                    const index = careers.findIndex(
                      (item) => item.id === career.id,
                    );
                    return (
                      <label>
                        <input
                          type="checkbox"
                          value={career.id}
                          checked={index < 2}
                          aria-describedby="compare-help"
                        />
                        <span>{t(career.title, locale)}</span>
                      </label>
                    );
                  })}
                </div>
              </section>
            ))
          }
        </div>
      </fieldset><p
        id="compare-status"
        class="compare-status"
        aria-live="polite"
        data-minimum={bn
          ? "কমপক্ষে দুটি ক্যারিয়ার বেছে নিন।"
          : "Choose at least two careers."}
        data-selected={bn
          ? "{count}টি ক্যারিয়ার বেছে নেওয়া হয়েছে।"
          : "{count} careers selected."}
      >
      </p>
    </div>
  </section>
  <section class="section">
    <div class="container compare-shell">
      <h2>{bn ? "কাজ আর চাপ পাশাপাশি" : "Work-pressure comparison"}</h2><p
        class="muted"
      >
        {
          bn
            ? "Level কোনো scientific score নয়; এটি content model-এর একটি editorial summary।"
            : "Levels are editorial summaries, not scientific scores."
        }
      </p><table class="compare-table" data-compare-table>
        <thead
          ><tr
            ><th scope="col">{bn ? "দিক" : "Dimension"}</th>{
              careers.map((career) => (
                <th scope="col" data-career-column={career.id}>
                  {t(career.title, locale)}
                </th>
              ))
            }</tr
          ></thead
        ><tbody
          >{
            dimensionRows.map(([key, label]) => (
              <tr>
                <th scope="row">{label}</th>
                {careers.map((career) => (
                  <td
                    data-career-column={career.id}
                    data-career={t(career.title, locale)}
                  >
                    <strong>{level(career.dimensions[key])}</strong>
                    <span class="dot-text" aria-hidden="true">
                      {"●".repeat(career.dimensions[key])}
                      {"○".repeat(3 - career.dimensions[key])}
                    </span>
                  </td>
                ))}
              </tr>
            ))
          }<tr
            ><th scope="row">{bn ? "কাজে AI-এর প্রভাব" : "AI task exposure"}</th
            >{
              careers.map((career) => (
                <td
                  data-career-column={career.id}
                  data-career={t(career.title, locale)}
                >
                  {career.aiExposure.map((item) => item.exposure).join(" · ")}
                </td>
              ))
            }</tr
          ><tr
            ><th scope="row">{bn ? "অস্বস্তিকর অংশ" : "Uncomfortable part"}</th
            >{
              careers.map((career) => (
                <td
                  data-career-column={career.id}
                  data-career={t(career.title, locale)}
                >
                  {t(career.dislikeIf[0]!, locale)}
                </td>
              ))
            }</tr
          ><tr
            ><th scope="row">{bn ? "পরের evidence" : "Next evidence"}</th>{
              careers.map((career) => (
                <td
                  data-career-column={career.id}
                  data-career={t(career.title, locale)}
                >
                  <a href={withBase(careerPath(locale, career.slug))}>
                    {bn ? "গাইড" : "Guide"}
                  </a>{" "}
                  ·{" "}
                  <a href={withBase(roadmapPath(locale, career.slug))}>
                    {bn ? "রোডম্যাপ" : "Roadmap"}
                  </a>
                </td>
              ))
            }</tr
          ></tbody
        >
      </table>
    </div>
  </section>
  <section class="section section--tinted">
    <div class="container callout callout--amber">
      <p class="callout__label">
        {bn ? "এবার কাজ করে দেখুন" : "Try this instead"}
      </p><h2>
        {
          bn
            ? "Table দেখা শেষ হলে দুটি ছোট experiment করুন।"
            : "If the table feels close, run two experiments."
        }
      </h2><p>
        {
          bn
            ? "ক্যারিয়ার তুলনা সিদ্ধান্ত বানিয়ে দেয় না—বরং ভালো প্রশ্ন তৈরি করে। আসল কাজের ছোট সংস্করণ সেই প্রশ্নের সঙ্গে নিজের evidence যোগ করে।"
            : "Comparison does not manufacture a decision; it produces better questions. Small versions of the real work add evidence."
        }
      </p>
    </div>
  </section>
  <script>
    import { trackCareerCompared } from "@/lib/analytics";
    const checkboxes = [
      ...document.querySelectorAll<HTMLInputElement>(".career-options input"),
    ];
    const columns = [
      ...document.querySelectorAll<HTMLElement>("[data-career-column]"),
    ];
    const status = document.querySelector<HTMLElement>("#compare-status");
    const update = (announce = false) => {
      const selected = checkboxes
        .filter((item) => item.checked)
        .map((item) => item.value);
      checkboxes.forEach((item) => {
        item.disabled = selected.length >= 3 && !item.checked;
      });
      columns.forEach((column) => {
        column.hidden = !selected.includes(column.dataset.careerColumn ?? "");
      });
      if (status)
        status.textContent =
          selected.length < 2
            ? (status.dataset.minimum ?? "")
            : (status.dataset.selected ?? "").replace(
                "{count}",
                String(selected.length),
              );
      const url = new URL(window.location.href);
      url.searchParams.set("careers", selected.join(","));
      history.replaceState({}, "", url);
      if (announce && selected.length >= 2)
        trackCareerCompared(selected.join(","));
    };
    const query = new URL(window.location.href).searchParams
      .get("careers")
      ?.split(",")
      .filter(Boolean);
    if (query && query.length >= 2 && query.length <= 3)
      checkboxes.forEach((item) => {
        item.checked = query.includes(item.value);
      });
    checkboxes.forEach((item) =>
      item.addEventListener("change", () => update(true)),
    );
    update();
  </script>
</BaseLayout>
<style>
  .compare-picker {
    padding: 0;
    border: 0;
  }
  .compare-picker legend {
    font-size: clamp(1.5rem, 4vw, 2.2rem);
    font-weight: 780;
  }
  .career-options {
    display: grid;
    gap: 0.5rem;
  }
  .career-option-groups {
    display: grid;
    gap: 1.5rem;
    margin-top: 1.5rem;
  }
  .career-option-group {
    padding-top: 1rem;
    border-top: 2px solid var(--color-border-strong);
  }
  .career-option-group h2 {
    margin-bottom: 0.75rem;
    font-size: 1rem;
  }
  .career-options label {
    display: flex;
    min-height: 3.1rem;
    align-items: center;
    gap: 0.7rem;
    padding: 0.6rem 0.8rem;
    border: 1px solid var(--color-border);
    background: var(--color-surface-raised);
    cursor: pointer;
  }
  .career-options input {
    width: 1.2rem;
    height: 1.2rem;
    accent-color: var(--color-primary);
  }
  .career-options label:has(input:checked) {
    border-color: var(--color-primary);
    background: var(--color-code);
  }
  .compare-status {
    min-height: 1.6rem;
    margin-top: 1rem;
    color: var(--color-text-muted);
  }
  .dot-text {
    display: block;
    color: var(--color-primary);
    letter-spacing: 0.15em;
  }
  [hidden] {
    display: none !important;
  }
  @media (min-width: 40rem) {
    .career-option-groups {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .career-options {
      grid-template-columns: 1fr;
    }
  }
</style>
