---
import Breadcrumbs from "@/components/common/Breadcrumbs.astro";
import { localePath, withBase } from "@/config/site";
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { Locale } from "@/types/content";
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const bn = locale === "bn";
---

<BaseLayout
  locale={locale}
  title={bn
    ? "3rd/4th Year Recovery Route"
    : "Third/Fourth-Year CSE Recovery Route"}
  description={bn
    ? "পিছিয়ে পড়া CSE student-এর জন্য shame-free 12-week recovery route: narrow target, foundation audit, one project, feedback আর realistic next step।"
    : "A shame-free 12-week recovery route for CSE students: narrow target, foundation audit, one project, feedback and a realistic next step."}
>
  <Breadcrumbs
    locale={locale}
    items={[
      { label: bn ? "Guidance" : "Guidance" },
      { label: bn ? "পিছিয়ে মনে হচ্ছে" : "Feel behind" },
    ]}
  />
  <header class="page-hero container">
    <p class="eyebrow">{bn ? "Recovery route" : "Recovery route"}</p><h1>
      {
        bn
          ? "তিন বছরের gap তিন সপ্তাহে যাবে না।"
          : "You cannot recover three years in three weeks."
      }
    </h1><p class="lede">
      {
        bn
          ? "কিন্তু পরের তিন মাস নষ্ট হওয়া আজই বন্ধ করতে পারো। Shame useful plan না। Narrow target, honest audit, one project আর feedback useful।"
          : "But you can stop losing the next three months. Shame is not a useful plan. A narrow target, honest audit, one project and feedback are."
      }
    </p>
  </header>
  <section class="section section--tinted">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">
            {bn ? "First 48 hours" : "The first 48 hours"}
          </p><h2>
            {
              bn
                ? "Decision কমাও, signal বাড়াও"
                : "Reduce decisions. Increase signal."
            }
          </h2>
        </div><p class="lede">
          {
            bn
              ? "Perfect career choose করতে যেও না। আগামী ১২ সপ্তাহের জন্য provisional target নাও।"
              : "Do not wait for a perfect career choice. Choose a provisional target for the next 12 weeks."
          }
        </p>
      </div><ol class="recovery-steps">
        {
          (bn
            ? [
                "দুটি career guide পড়ো; একটিকে provisional target করো।",
                "Programming, Git, DSA, project আর communication-এর honest audit লিখো।",
                "Target career-এর roadmap-এ current stage mark করো—progress save নয়, নিজের notebook-এ।",
                "একটি small project scope করো যেটা ৬ সপ্তাহে শেষ হবে।",
              ]
            : [
                "Read two career guides and choose one provisional target.",
                "Write an honest audit of programming, Git, DSA, projects and communication.",
                "Find your current stage on the target roadmap—in your notebook, not as tracked progress here.",
                "Scope one small project that can finish in six weeks.",
              ]
          ).map((item, index) => (
            <li>
              <>
                <span>0{index + 1}</span>
                <p>{item}</p>
              </>
            </li>
          ))
        }
      </ol>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <p class="eyebrow">{bn ? "12-week recovery" : "A 12-week recovery"}</p><h2
      >
        {
          bn
            ? "Foundation → Build → Feedback → Apply"
            : "Foundation → Build → Feedback → Apply"
        }
      </h2><div class="recovery-grid">
        <article>
          <span>Week 1–3</span><h3>
            {bn ? "Foundation audit repair" : "Repair foundations"}
          </h3><p>
            {
              bn
                ? "প্রতিদিন ৬০–৯০ মিনিট target-এর core prerequisite। Tool hopping বন্ধ।"
                : "Spend 60–90 minutes daily on core prerequisites. Stop tool hopping."
            }
          </p>
        </article><article>
          <span>Week 4–8</span><h3>
            {bn ? "একটি end-to-end project" : "One end-to-end project"}
          </h3><p>
            {
              bn
                ? "README, error handling, test, Git history আর deployable result। Clone project না।"
                : "Include a README, errors, tests, Git history and a deployable result. Avoid a clone-only project."
            }
          </p>
        </article><article>
          <span>Week 9–10</span><h3>
            {bn ? "Feedback আর refactor" : "Feedback and refactor"}
          </h3><p>
            {
              bn
                ? "Peer/mentor review নাও। একটা design pain testসহ improve করো।"
                : "Get peer or mentor review. Improve one design pain with tests."
            }
          </p>
        </article><article>
          <span>Week 11–12</span><h3>
            {bn ? "Evidence present করো" : "Present the evidence"}
          </h3><p>
            {
              bn
                ? "Project explain, CV/portfolio update, mock conversation আর focused application।"
                : "Explain the project, update your CV/portfolio, rehearse a technical conversation and apply with focus."
            }
          </p>
        </article>
      </div>
    </div>
  </section>
  <section class="section section--tinted">
    <div class="container editorial-grid">
      <div>
        <p class="eyebrow">
          {bn ? "Uncomfortable part" : "The uncomfortable part"}
        </p><h2>
          {
            bn
              ? "তুমি সব gap একসঙ্গে close করবে না।"
              : "You will not close every gap at once."
          }
        </h2><p>
          {
            bn
              ? "Relevant gap close করো। Job-ready মানে সব জানা না; useful problem independently solve, explain, learn আর improve করতে পারা।"
              : "Close the relevant gaps. Job-ready does not mean knowing everything; it means solving, explaining, learning and improving useful problems with growing independence."
          }
        </p>
      </div><div class="callout">
        <p class="callout__label">{bn ? "Mentor note" : "Mentor note"}</p><p>
          {
            bn
              ? "Comparison যদি action বন্ধ করে, LinkedIn tab বন্ধ করে ২৫ মিনিট code পড়ো। অন্যের timeline তোমার compiler error fix করবে না।"
              : "If comparison blocks action, close the timeline and read code for 25 minutes. Someone else’s timeline will not fix your compiler error."
          }
        </p>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <h2>
        {
          bn
            ? "আজ provisional direction নাও"
            : "Choose a provisional direction today"
        }
      </h2><div class="next-actions">
        <a class="button" href={withBase(localePath(locale, "/careers/"))}
          >{bn ? "Career guide" : "Explore careers"}</a
        ><a
          class="button button--secondary"
          href={withBase(localePath(locale, "/roadmaps/"))}>Roadmaps</a
        ><a
          class="button button--secondary"
          href={withBase(localePath(locale, "/try/"))}
          >{bn ? "Experiment" : "Try a career"}</a
        >
      </div>
    </div>
  </section>
</BaseLayout>
<style>
  .recovery-steps {
    margin: 2rem 0 0;
    padding: 0;
    border-top: 1px solid var(--color-border-strong);
    list-style: none;
  }
  .recovery-steps li {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 1rem;
    padding: 1.2rem 0;
    border-bottom: 1px solid var(--color-border);
  }
  .recovery-steps span {
    color: var(--color-warm);
    font-size: 0.75rem;
    font-weight: 800;
  }
  .recovery-steps p {
    margin: 0;
  }
  .recovery-grid {
    display: grid;
    gap: 1rem;
    margin-top: 2rem;
  }
  .recovery-grid article {
    padding: 1.4rem;
    border-top: 3px solid var(--color-primary);
    background: var(--color-surface);
  }
  .recovery-grid span {
    color: var(--color-warm);
    font-size: 0.78rem;
    font-weight: 800;
  }
  @media (min-width: 48rem) {
    .recovery-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }
</style>
