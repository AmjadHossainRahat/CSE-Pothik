---
import Breadcrumbs from "@/components/common/Breadcrumbs.astro";
import { localePath, withBase } from "@/config/site";
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { Locale } from "@/types/content";
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const bn = locale === "bn";
---

<BaseLayout
  locale={locale}
  title={bn
    ? "3rd/4th Year Recovery Route"
    : "Third/Fourth-Year CSE Recovery Route"}
  description={bn
    ? "পিছিয়ে পড়েছেন মনে হওয়া CSE শিক্ষার্থীর জন্য ১২ সপ্তাহের recovery plan: ছোট লক্ষ্য, নিজের ভিত্তির হিসাব, একটি project, feedback আর বাস্তবসম্মত পরের ধাপ।"
    : "A shame-free 12-week recovery route for CSE students: narrow target, foundation audit, one project, feedback and a realistic next step."}
>
  <Breadcrumbs
    locale={locale}
    items={[
      { label: bn ? "দিকনির্দেশনা" : "Guidance" },
      { label: bn ? "পিছিয়ে মনে হচ্ছে" : "Feel behind" },
    ]}
  />
  <header class="page-hero container">
    <p class="eyebrow">{bn ? "ঘুরে দাঁড়ানোর পথ" : "Recovery route"}</p><h1>
      {
        bn
          ? "তিন বছরের ঘাটতি তিন সপ্তাহে মিটবে না।"
          : "You cannot recover three years in three weeks."
      }
    </h1><p class="lede">
      {
        bn
          ? "কিন্তু পরের তিন মাস নষ্ট হওয়া আজই থামাতে পারেন। নিজেকে দোষ দিলে plan হয় না; ছোট লক্ষ্য, সৎ হিসাব, একটি project আর feedback—এগুলো দিয়ে হয়।"
          : "But you can stop losing the next three months. Shame is not a useful plan. A narrow target, honest audit, one project and feedback are."
      }
    </p>
  </header>
  <section class="section section--tinted">
    <div class="container">
      <div class="section-head">
        <div>
          <p class="eyebrow">
            {bn ? "শুরুর ৪৮ ঘণ্টা" : "The first 48 hours"}
          </p><h2>
            {
              bn
                ? "সিদ্ধান্ত কমান, evidence বাড়ান"
                : "Reduce decisions. Increase signal."
            }
          </h2>
        </div><p class="lede">
          {
            bn
              ? "নিখুঁত ক্যারিয়ার বাছতে যাবেন না। আপাতত আগামী ১২ সপ্তাহের জন্য একটি লক্ষ্য নিন।"
              : "Do not wait for a perfect career choice. Choose a provisional target for the next 12 weeks."
          }
        </p>
      </div><ol class="recovery-steps">
        {
          (bn
            ? [
                "দুটি ক্যারিয়ার গাইড পড়ুন; একটিকে আপাতত লক্ষ্য ধরুন।",
                "Programming, Git, DSA, project আর communication-এ নিজের অবস্থার সৎ হিসাব লিখুন।",
                "লক্ষ্যের রোডম্যাপে এখন কোথায় আছেন চিহ্নিত করুন—সাইটে নয়, নিজের notebook-এ।",
                "ছয় সপ্তাহে শেষ করা যাবে, এমন ছোট একটি project ঠিক করুন।",
              ]
            : [
                "Read two career guides and choose one provisional target.",
                "Write an honest audit of programming, Git, DSA, projects and communication.",
                "Find your current stage on the target roadmap—in your notebook, not as tracked progress here.",
                "Scope one small project that can finish in six weeks.",
              ]
          ).map((item, index) => (
            <li>
              <>
                <span>0{index + 1}</span>
                <p>{item}</p>
              </>
            </li>
          ))
        }
      </ol>
      <aside class="existing-project-callout">
        <div>
          <h3>
            {
              bn
                ? "Project আর কোন দিকে যাবেন—দুটোই আগে থেকে জানা?"
                : "Already have a project and a target direction?"
            }
          </h3>
          <p>
            {
              bn
                ? "তাহলে আরেকটি project শূন্য থেকে শুরু করবেন না। আগের কাজটিকেই review করা যায় এমন evidence বানিয়ে internship বা junior-role cycle শুরু করুন।"
                : "Do not automatically start another project. Turn the work you already understand into reviewable evidence and begin an internship or junior-role cycle."
            }
          </p>
        </div>
        <a
          href={withBase(localePath(locale, "/guidance/first-software-role/"))}
          data-track-event="next_step_clicked"
          data-track-param-destination="first-software-role"
          >{bn ? "প্রথম চাকরির গাইড" : "Open the first-role guide"} →</a
        >
      </aside>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <p class="eyebrow">{bn ? "12-week recovery" : "A 12-week recovery"}</p><h2
      >
        {
          bn
            ? "Foundation → Build → Feedback → Apply"
            : "Foundation → Build → Feedback → Apply"
        }
      </h2><div class="recovery-grid">
        <article>
          <span>Week 1–3</span><h3>
            {bn ? "ভিত্তির ঘাটতি মেরামত" : "Repair foundations"}
          </h3><p>
            {
              bn
                ? "প্রতিদিন ৬০–৯০ মিনিট লক্ষ্যের মূল prerequisite-এ দিন। আজ এটা, কাল ওটা—tool hopping বন্ধ রাখুন।"
                : "Spend 60–90 minutes daily on core prerequisites. Stop tool hopping."
            }
          </p>
        </article><article>
          <span>Week 4–8</span><h3>
            {bn ? "একটি end-to-end project" : "One end-to-end project"}
          </h3><p>
            {
              bn
                ? "README, error handling, test, পরিষ্কার Git history আর deploy করা যায় এমন ফল। আরেকটি clone project নয়।"
                : "Include a README, errors, tests, Git history and a deployable result. Avoid a clone-only project."
            }
          </p>
        </article><article>
          <span>Week 9–10</span><h3>
            {bn ? "মতামত নিন, তারপর refactor করুন" : "Feedback and refactor"}
          </h3><p>
            {
              bn
                ? "Peer বা mentor-এর review নিন। design-এর একটি সমস্যা testসহ ঠিক করুন।"
                : "Get peer or mentor review. Improve one design pain with tests."
            }
          </p>
        </article><article>
          <span>Week 11–12</span><h3>
            {bn ? "কাজের প্রমাণটা গুছিয়ে দেখান" : "Present the evidence"}
          </h3><p>
            {
              bn
                ? "Project explain, CV/portfolio update, mock conversation আর focused application।"
                : "Explain the project, update your CV/portfolio, rehearse a technical conversation and apply with focus."
            }
          </p>
        </article>
      </div>
    </div>
  </section>
  <section class="section section--tinted">
    <div class="container editorial-grid">
      <div>
        <p class="eyebrow">
          {bn ? "অস্বস্তিকর হলেও সত্যি" : "The uncomfortable part"}
        </p><h2>
          {
            bn
              ? "সব ঘাটতি একসঙ্গে মেটাতে হবে না।"
              : "You will not close every gap at once."
          }
        </h2><p>
          {
            bn
              ? "যে ঘাটতিটি লক্ষ্যের পথে বাধা, সেটি আগে মেটাও। Job-ready মানে সব জানা নয়; দরকারি সমস্যা নিজে সমাধান, ব্যাখ্যা, শেখা আর উন্নত করতে পারা।"
              : "Close the relevant gaps. Job-ready does not mean knowing everything; it means solving, explaining, learning and improving useful problems with growing independence."
          }
        </p>
      </div><div class="callout">
        <p class="callout__label">{bn ? "মেন্টরের কথা" : "Mentor note"}</p><p>
          {
            bn
              ? "তুলনা করতে করতে কাজ বন্ধ হয়ে গেলে LinkedIn tab বন্ধ করে ২৫ মিনিট code পড়ুন। অন্যের timeline আপনার compiler error ঠিক করবে না—দুঃখিত, algorithm এখনও এত উন্নত হয়নি।"
              : "If comparison blocks action, close the timeline and read code for 25 minutes. Someone else’s timeline will not fix your compiler error."
          }
        </p>
      </div>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <h2>
        {
          bn
            ? "আজ provisional direction নিন"
            : "Choose a provisional direction today"
        }
      </h2><div class="next-actions">
        <a class="button" href={withBase(localePath(locale, "/careers/"))}
          >{bn ? "ক্যারিয়ারগুলো দেখুন" : "Explore careers"}</a
        ><a
          class="button button--secondary"
          href={withBase(localePath(locale, "/roadmaps/"))}>Roadmaps</a
        ><a
          class="button button--secondary"
          href={withBase(localePath(locale, "/try/"))}
          >{bn ? "কাজটা করে দেখুন" : "Try a career"}</a
        >
      </div>
    </div>
  </section>
</BaseLayout>
<style>
  .recovery-steps {
    margin: 2rem 0 0;
    padding: 0;
    border-top: 1px solid var(--color-border-strong);
    list-style: none;
  }
  .recovery-steps li {
    display: grid;
    grid-template-columns: 2.5rem 1fr;
    gap: 1rem;
    padding: 1.2rem 0;
    border-bottom: 1px solid var(--color-border);
  }
  .recovery-steps span {
    color: var(--color-warm);
    font-size: 0.75rem;
    font-weight: 800;
  }
  .recovery-steps p {
    margin: 0;
  }
  .recovery-grid {
    display: grid;
    gap: 1rem;
    margin-top: 2rem;
  }
  .recovery-grid article {
    padding: 1.4rem;
    border-top: 3px solid var(--color-primary);
    background: var(--color-surface);
  }
  .recovery-grid span {
    color: var(--color-warm);
    font-size: 0.78rem;
    font-weight: 800;
  }
  .existing-project-callout {
    display: grid;
    gap: 0.8rem;
    margin-top: 2rem;
    padding: 1.25rem;
    border-inline-start: 4px solid var(--color-teal);
    background: var(--color-surface-raised);
  }
  .existing-project-callout h3 {
    margin-top: 0;
  }
  .existing-project-callout p {
    margin-bottom: 0;
    color: var(--color-text-muted);
  }
  .existing-project-callout > a {
    align-self: center;
    font-weight: 750;
  }
  @media (min-width: 48rem) {
    .recovery-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .existing-project-callout {
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: 2rem;
    }
  }
</style>
