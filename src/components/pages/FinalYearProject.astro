---
import Breadcrumbs from "@/components/common/Breadcrumbs.astro";
import TeamPlaybooks from "@/components/project/TeamPlaybooks.astro";
import { projectTemplates } from "@/data/project/templates";
import { localePath, withBase } from "@/config/site";
import { finalYearProject as guide } from "@/data/final-year-project";
import { guidanceSourceById } from "@/data/guidance-sources";
import { t } from "@/lib/i18n";
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { Locale } from "@/types/content";
interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const bn = locale === "bn";
const href = (path: string) => withBase(localePath(locale, path));
const sections = [
  { id: "start", title: bn ? "কোথা থেকে শুরু" : "Start at your current stage" },
  {
    id: "team-workflows",
    title: bn ? "দলের কাজ গুছানোর playbook" : "Team working playbooks",
  },
  {
    id: "templates",
    title: bn ? "বারবার কাজে লাগবে এমন template" : "Reusable templates",
  },
  ...guide.stages.map((stage) => ({
    id: stage.id,
    title: t(stage.title, locale),
  })),
  {
    id: "traceability",
    title: bn ? "শুরু থেকে শেষ—একটি উদাহরণ" : "A worked example",
  },
  {
    id: "project-type",
    title: bn ? "প্রজেক্ট অনুযায়ী প্রমাণ সাজাও" : "Adapt to your project",
  },
  {
    id: "handover",
    title: bn ? "জমা দেওয়ার আগে শেষ যাচাই" : "Submission readiness",
  },
  {
    id: "sources",
    title: bn ? "তথ্যের উৎস ও পরের ধাপ" : "Sources & next steps",
  },
];
const pageUrl = new URL(Astro.url.pathname, Astro.site).href;
const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "Article",
    headline: t(guide.title, locale),
    description: t(guide.summary, locale),
    inLanguage: locale,
    author: { "@type": "Organization", name: "CSE Compass" },
    isAccessibleForFree: true,
    mainEntityOfPage: pageUrl,
  },
  {
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: [
      {
        "@type": "ListItem",
        position: 1,
        name: bn ? "রোডম্যাপ" : "Roadmaps",
        item: new URL(href("/roadmaps/"), Astro.site).href,
      },
      {
        "@type": "ListItem",
        position: 2,
        name: bn ? "ফাইনাল ইয়ার প্রজেক্ট" : "Final-year project",
        item: pageUrl,
      },
    ],
  },
];
---

<BaseLayout
  locale={locale}
  title={t(guide.title, locale)}
  description={t(guide.summary, locale)}
  structuredData={structuredData}
>
  <Breadcrumbs
    locale={locale}
    items={[
      { label: bn ? "রোডম্যাপ" : "Roadmaps", path: "/roadmaps/" },
      { label: bn ? "ফাইনাল ইয়ার প্রজেক্ট" : "Final-year project" },
    ]}
  />
  <header class="page-hero container project-hero">
    <p class="eyebrow">
      {
        bn
          ? "শিক্ষার্থী প্রজেক্ট → বাস্তব engineering practice"
          : "Student project → engineering practice"
      }
    </p>
    <h1>{t(guide.title, locale)}</h1><p class="lede">
      {t(guide.summary, locale)}
    </p>
    <p>
      {
        bn
          ? "এটি CSE Compass-এর প্রস্তাবিত quality bar—বিশ্ববিদ্যালয়ের নিয়ম, accreditation বা certification নয়। সবার আগে department-এর rubric, supervisor-এর নির্দেশনা ও ethics/safety requirement মানবে। সময় কমে গেলে scope ছোট করো, কাজের প্রমাণ নয়।"
          : "This is a suggested CSE Compass quality bar—not a university rule, accreditation or certification. Your department rubric, supervisor and ethics/safety requirements take priority. Reduce the scope, not the evidence."
      }
    </p>
    <div class="button-row">
      <a class="button" href="#start"
        >{bn ? "আমি যে ধাপে আছি, সেখান থেকে শুরু" : "Find my starting stage"}</a
      ><a
        class="button button--secondary"
        href={withBase(`/downloads/final-year-project.${bn ? "bn" : "en"}.md/`)}
        download={`final-year-project.${bn ? "bn" : "en"}.md`}
        data-track-event="next_step_clicked"
        data-track-param-destination="fyp-evidence-template"
        >{bn ? "দলের toolkit ডাউনলোড (.md)" : "Download team toolkit (.md)"}</a
      >
    </div>
  </header>
  <div class="container project-layout">
    <aside class="project-index">
      <details open>
        <summary>{bn ? "এই গাইডে যা আছে" : "In this guide"}</summary>
        <nav
          aria-label={bn ? "প্রজেক্ট গাইডের বিভাগ" : "Project guide sections"}
        >
          <ol>
            {
              sections.map((section) => (
                <li>
                  <a href={`#${section.id}`}>{section.title}</a>
                </li>
              ))
            }
          </ol>
        </nav>
      </details>
    </aside>
    <div class="project-content">
      <section id="start" class="project-section">
        <h2>
          {
            bn
              ? "যে অবস্থাতেই থাকো, পরের দরকারি evidence-টি বানাও।"
              : "Wherever you are, build the next useful evidence."
          }
        </h2>
        <ul class="stage-entry">
          <li>
            <a href="#task-board"
              >{
                bn
                  ? "Team-এর কাজ গুছাব → task board আর ছোট ছোট task"
                  : "Organizing team work → task board & small tasks"
              }</a
            >
          </li>
          <li>
            <a href="#git-workflow"
              >{
                bn
                  ? "একসঙ্গে code করব → Git review-এর workflow"
                  : "Coding together → Git review workflow"
              }</a
            >
          </li>
          <li>
            <a href="#test-strategy"
              >{
                bn
                  ? "কীভাবে test করব → risk-based test plan"
                  : "Unsure how to test → a risk-based test plan"
              }</a
            >
          </li>
          <li>
            <a href="#define"
              >{
                bn
                  ? "Idea বাছছি → এক পাতার brief"
                  : "Choosing an idea → a one-page brief"
              }</a
            >
          </li>
          <li>
            <a href="#specify"
              >{
                bn
                  ? "Build শুরু করব → acceptance criteria ঠিক করা"
                  : "About to build → acceptance criteria"
              }</a
            >
          </li>
          <li>
            <a href="#verify"
              >{
                bn
                  ? "Demo আছে → test আর অন্যের চালিয়ে দেখার ব্যবস্থা"
                  : "Have a demo → testing and reproducibility"
              }</a
            >
          </li>
          <li>
            <a href="#handover"
              >{
                bn
                  ? "Submission কাছে → evidence-এর শেষ হিসাব"
                  : "Submission is close → an evidence audit"
              }</a
            >
          </li>
        </ul>
        <div class="callout">
          <p class="callout__label">{bn ? "মেন্টরের কথা" : "Mentor note"}</p><p>
            {
              bn
                ? "পিছিয়ে থাকলে সবকিছু rewrite করতে যেয়ো না। একটি core journey নাও, ঝুঁকি লেখো, failing case ঠিক করো, তারপর অন্য কাউকে চালিয়ে দেখতে দাও। ছোট কিন্তু নিজের ভাষায় বোঝানো যায় এমন কাজও শক্তিশালী portfolio evidence।"
                : "If you feel behind, do not rewrite everything. Pick one core journey, name its risks, fix a failure and let someone else run it. Small work you can explain is strong portfolio evidence."
            }
          </p>
        </div>
      </section>
      <section id="team-workflows" class="project-section">
        <h2>
          {
            bn
              ? "কাজের অভ্যাস: ছোট team, পরিষ্কার workflow"
              : "Working habits: small team, clear flow"
          }
        </h2>
        <TeamPlaybooks locale={locale} />
      </section>
      <section id="templates" class="project-section">
        <h2>
          {
            bn
              ? "খালি page-এর দিকে তাকিয়ে নয়, template দিয়ে শুরু"
              : "Start with a useful template, not a blank page"
          }
        </h2>
        <p>
          {
            bn
              ? "দশটি template একই Markdown toolkit-এ আছে। দরকারি অংশটি তোমার task manager বা repository-তে নাও। এগুলো লেখার শুরু, completed evidence নয়; এখানে কিছু জমা বা submit হয় না।"
              : "Ten templates are included in one Markdown toolkit. Copy the sections you need into your task manager or repository. These are prompts to fill in, not completed evidence; nothing is saved or submitted here."
          }
        </p>
        {
          projectTemplates.map((template) => (
            <details class="project-template" id={`template-${template.id}`}>
              <summary>{t(template.title, locale)}</summary>
              <p>{t(template.use, locale)}</p>
              <ul>
                {template.fields.map((field) => (
                  <li>{t(field, locale)}</li>
                ))}
              </ul>
            </details>
          ))
        }
        <a
          class="button toolkit-download"
          href={withBase(`/downloads/final-year-project.${locale}.md/`)}
          download={`final-year-project.${locale}.md`}
          data-track-event="next_step_clicked"
          data-track-param-destination="fyp-evidence-template"
          >{
            bn
              ? "পুরো toolkit ডাউনলোড (.md)"
              : "Download the full toolkit (.md)"
          }</a
        >
      </section>
      {
        guide.stages.map((stage) => (
          <section id={stage.id} class="project-section">
            <>
              <h2>{t(stage.title, locale)}</h2>
              <p class="stage-why">{t(stage.why, locale)}</p>
            </>
            <ul>
              {stage.tasks.map((task) => (
                <li>{t(task, locale)}</li>
              ))}
            </ul>
            <div class="project-evidence">
              <>
                <h3>{bn ? "এখন কতটুকু যথেষ্ট" : "Enough for now"}</h3>
                <p>{t(stage.evidence, locale)}</p>
              </>
            </div>
            <p>
              <strong>{bn ? "এখনই নয়: " : "Not yet: "}</strong>
              {t(stage.notYet, locale)}
            </p>
            <a class="reference-link" href={`#source-${stage.sourceId}`}>
              {bn ? "প্রাসঙ্গিক reference" : "Relevant reference"} →
            </a>
            {stage.id === "build" && (
              <p>
                <a href="#team-workflows">
                  {bn
                    ? "Team-এ কীভাবে করবে: task, Git আর sync-up playbook"
                    : "How to do this as a team: task, Git & sync-up playbooks"}{" "}
                  →
                </a>
              </p>
            )}
            {stage.id === "verify" && (
              <p>
                <a href="#test-strategy">
                  {bn
                    ? "Test strategy আর TEST-01 example খোলো"
                    : "Open the test strategy & TEST-01 example"}{" "}
                  →
                </a>
              </p>
            )}
          </section>
        ))
      }
      <section id="traceability" class="project-section">
        <p class="eyebrow">
          {
            bn
              ? "Example · campus equipment booking"
              : "Example · campus equipment booking"
          }
        </p>
        <h2>
          {
            bn
              ? "একটি requirement থেকে তার evidence পর্যন্ত।"
              : "One requirement, all the way to evidence."
          }
        </h2>
        <p>
          {
            bn
              ? "এটি শেখার উদাহরণ; তোমার domain আর supervisor-এর নির্দেশনা অনুযায়ী বদলাবে।"
              : "This is a teaching example. Adapt it to your domain and supervisor’s expectations."
          }
        </p>
        <dl class="evidence-chain">
          <div>
            <dt>REQ-01 · {bn ? "প্রয়োজন" : "Requirement"}</dt><dd>
              {
                bn
                  ? "একই equipment একই সময়ে দুজনের জন্য confirmed booking হবে না।"
                  : "Two confirmed bookings must not overlap for the same equipment."
              }
            </dd>
          </div>
          <div>
            <dt>AC-01 · {bn ? "গ্রহণযোগ্যতা" : "Acceptance"}</dt><dd>
              {
                bn
                  ? "একই সময়ে দুটি request এলে ঠিক একটিই সফল হবে; অন্যটি পরিষ্কার conflict দেখাবে, duplicate record থাকবে না।"
                  : "With two competing requests, exactly one succeeds; the other receives a clear conflict, with no duplicate reservation."
              }
            </dd>
          </div>
          <div>
            <dt>ADR-01 · {bn ? "সিদ্ধান্ত" : "Decision"}</dt><dd>
              {
                bn
                  ? "শুধু button disable নয়—server/data layer-এ atomic conflict protection থাকবে; বেছে নেওয়া database-এর আচরণ test দিয়ে যাচাই হবে।"
                  : "Use atomic conflict protection at the server/data layer, not only a disabled button; verify the chosen database’s behavior with a test."
              }
            </dd>
          </div>
          <div>
            <dt>TEST-01 · {bn ? "যাচাই" : "Verification"}</dt><dd>
              {
                bn
                  ? "একই সময়ের concurrent request দিয়ে integration test; পাশাপাশি পাশের সময়, cancel আর retry case-ও পরীক্ষা।"
                  : "An integration test sends concurrent requests for the same interval; also test adjacent times, cancellation and retries."
              }
            </dd>
          </div>
          <div>
            <dt>REL-01 · {bn ? "হস্তান্তর" : "Handover"}</dt><dd>
              {
                bn
                  ? "Release tag, environment, আসল test log আর জানা সীমাবদ্ধতা report-এ দাও। নকল screenshot বা বানানো pass result নয়।"
                  : "Link the release tag, environment, actual test log and known limits in the report. No fabricated screenshots or pass results."
              }
            </dd>
          </div>
        </dl>
      </section>
      <section id="project-type" class="project-section">
        <h2>
          {
            bn
              ? "Project বদলালে evidence-ও বদলাবে।"
              : "Different projects need different evidence."
          }
        </h2>
        <p>
          {
            bn
              ? "শুধু নিজের project-এর ধরনটি মন দিয়ে পড়ো; সব ধরনের project একসঙ্গে বোঝার দরকার নেই।"
              : "Go deeper into your own branch. You do not need to build every kind of project."
          }
        </p>
        {
          guide.variants.map((variant) => (
            <details class="project-variant">
              <>
                <summary>{t(variant.title, locale)}</summary>
                <p>{t(variant.evidence, locale)}</p>
                <p class="muted">{t(variant.caution, locale)}</p>
              </>
            </details>
          ))
        }
      </section>
      <section id="handover" class="project-section">
        <h2>
          {
            bn
              ? "Submission-এর আগে evidence মিলিয়ে দেখো"
              : "The pre-submission evidence audit"
          }
        </h2>
        <p>
          {
            bn
              ? "এটি score বা tracker নয়। Team review-এ প্রতিটি দাবির evidence দেখাও; ঘাটতি থাকলে scope কমাও, ঠিক করো অথবা limitation হিসেবে লিখে supervisor-এর সঙ্গে আলোচনা করো।"
              : "This is not a score or tracker. Show evidence for each claim in a team review. For gaps, reduce scope, fix the issue or document the limitation and discuss it with your supervisor."
          }
        </p>
        <ul>
          {guide.releaseChecks.map((check) => <li>{t(check, locale)}</li>)}
        </ul>
        <h3>{bn ? "এই সপ্তাহে একটি কাজ" : "One action this week"}</h3><p>
          {
            bn
              ? "Template নিয়ে এক পাতার brief আর একটি acceptance criterion লেখো। Peer-কে পাঁচ মিনিটে সেটি বুঝিয়ে বলতে বলো। যেখানে সে আটকে যায়, সেই অস্পষ্ট অংশ বদলাও—এটাই প্রথম কাজে লাগা review।"
              : "Use the template to write a one-page brief and one acceptance criterion. Ask a peer to explain it back in five minutes. Revise the unclear part—that is your first useful review."
          }
        </p>
        <a
          href={withBase(
            `/downloads/final-year-project.${bn ? "bn" : "en"}.md/`,
          )}
          download={`final-year-project.${bn ? "bn" : "en"}.md`}
          >{
            bn
              ? "Brief, test report আর handover template (.md)"
              : "Get the brief, test report and handover template (.md)"
          }</a
        >
      </section>
      <section id="sources" class="project-section">
        <h2>
          {
            bn
              ? "Reference, scope আর পরের পদক্ষেপ"
              : "References, scope and your next step"
          }
        </h2>
        <p>
          {
            bn
              ? "এই guide একটি original editorial synthesis; reference provider-রা পুরো guide endorse করেনি। বাইরের reference-গুলোর বেশির ভাগই English। প্রতিটি source-এর review date আলাদা দেওয়া আছে।"
              : "This guide is original editorial synthesis, not an endorsement by the reference providers. External references are primarily in English. Each source has its own review date below."
          }
        </p>
        <ul class="project-sources">
          {
            guide.sourceIds.map((id) => {
              const source = guidanceSourceById.get(id)!;
              return (
                <li id={`source-${id}`}>
                  <>
                    <a
                      href={source.url}
                      target="_blank"
                      rel="noopener noreferrer"
                      aria-describedby="external-link-description"
                      data-track-event="learning_resource_clicked"
                      data-track-param-resource-id={id}
                      data-track-param-provider={source.provider}
                    >
                      {source.provider} · {source.title} ↗
                    </a>
                    <p>{t(source.scope, locale)}</p>
                    <small>
                      {bn ? "পর্যালোচনা: " : "Reviewed: "}
                      <time datetime={source.lastReviewed}>
                        {source.lastReviewed}
                      </time>
                    </small>
                  </>
                </li>
              );
            })
          }
        </ul>
        <div class="button-row">
          <a
            class="button"
            href={href("/guidance/first-software-role/")}
            data-track-event="next_step_clicked"
            data-track-param-destination="first-software-role"
            >{
              bn
                ? "শেষ করা project থেকে প্রথম role"
                : "Turn a completed project into first-role evidence"
            }</a
          >
          <a
            class="button button--secondary"
            href={href("/guidance/software-engineering-foundations/")}
            >{bn ? "Engineering-এর ভিত্তি" : "Engineering foundations"}</a
          ><a
            class="button button--secondary"
            href={href("/goals/research-publication/")}
            >{bn ? "থিসিস ও গবেষণার প্রস্তুতি" : "Thesis & research"}</a
          ><a href={href("/roadmaps/")}
            >{bn ? "ক্যারিয়ার রোডম্যাপে ফিরি" : "Back to career roadmaps"} →</a
          >
        </div>
      </section>
    </div>
  </div>
</BaseLayout>
<style>
  .project-hero h1 {
    max-width: 24ch;
  }
  .project-hero > p:not(.eyebrow) {
    max-width: 52rem;
  }
  .project-layout {
    display: grid;
    gap: 2rem;
    padding-bottom: 4rem;
  }
  .project-content {
    min-width: 0;
    max-width: 51rem;
  }
  .project-index details {
    border: 1px solid var(--color-border-strong);
    padding: 1rem;
    border-radius: var(--radius-sm);
  }
  .project-index summary {
    cursor: pointer;
    font-weight: 800;
    min-height: 2rem;
  }
  .project-index ol {
    list-style: none;
    margin: 0.75rem 0 0;
    padding: 0;
  }
  .project-index li {
    margin: 0;
  }
  .project-index a {
    display: block;
    padding-block: 0.55rem;
