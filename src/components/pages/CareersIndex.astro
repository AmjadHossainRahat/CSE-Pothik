---
import CareerCard from "@/components/careers/CareerCard.astro";
import Breadcrumbs from "@/components/common/Breadcrumbs.astro";
import DirectoryJumpNav from "@/components/common/DirectoryJumpNav.astro";
import { localePath, withBase } from "@/config/site";
import { careerFamilies, careerById } from "@/data/careers";
import { t } from "@/lib/i18n";
import { collectionStructuredData } from "@/lib/seo";
import BaseLayout from "@/layouts/BaseLayout.astro";
import type { Locale } from "@/types/content";

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const bn = locale === "bn";
const title = bn ? "CSE Career Landscape" : "Explore CSE Careers";
const description = bn
  ? "আটটি broad work family দিয়ে CSE career explore করো; real কাজ, drawback, roadmap, experiment আর AI exposure দেখো।"
  : "Explore CSE careers through eight broad work families, with realistic work, drawbacks, roadmaps, experiments and AI task exposure.";
const structuredData = collectionStructuredData({
  title,
  description,
  url: Astro.url.href,
  locale,
  homeUrl: new URL(withBase(localePath(locale, "/")), Astro.site).href,
  homeLabel: bn ? "হোম" : "Home",
  items: careerFamilies.flatMap((family) =>
    family.careerIds.map((id) => {
      const career = careerById.get(id)!;
      return {
        name: t(career.title, locale),
        url: new URL(
          withBase(localePath(locale, `/careers/${career.slug}/`)),
          Astro.site,
        ).href,
      };
    }),
  ),
});
---

<BaseLayout
  locale={locale}
  title={title}
  description={description}
  structuredData={structuredData}
>
  <Breadcrumbs locale={locale} items={[{ label: bn ? "Career" : "Careers" }]} />
  <header class="page-hero page-hero--compact container">
    <p class="eyebrow">{bn ? "Career landscape" : "Career landscape"}</p>
    <h1>
      {
        bn
          ? "Title কম, real work বেশি।"
          : "Less job-title noise. More real work."
      }
    </h1>
    <p class="lede">
      {
        bn
          ? "কোন career ‘best’—এই page তার ranking নয়। কোন ধরনের problem, pressure আর responsibility তোমার curiosity ধরে রাখে—সেটা explore করার জায়গা।"
          : "This is not a ranking of the ‘best’ career. Explore which problems, pressures and responsibilities can hold your curiosity."
      }
    </p>
  </header>
  <DirectoryJumpNav
    eyebrow={bn ? "Career family-তে যাও" : "Jump to a career family"}
    label={bn ? "Career family index" : "Career family index"}
    items={careerFamilies.map((family) => ({
      id: family.id,
      label: t(family.title, locale),
      count: family.careerIds.length,
    }))}
  />
  {
    careerFamilies.map((family, index) => (
      <section
        class:list={[
          "section",
          "directory-target",
          { "section--tinted": index % 2 === 0 },
        ]}
        id={family.id}
      >
        <div class="container">
          <div class="section-head">
            <div>
              <>
                <p class="eyebrow">
                  {String(index + 1).padStart(2, "0")} ·{" "}
                  {t(family.title, locale)}
                </p>
                <h2>{t(family.title, locale)}</h2>
              </>
            </div>
            <p class="lede">{t(family.description, locale)}</p>
          </div>
          <div class="card-grid">
            {family.careerIds.map((id) => (
              <CareerCard career={careerById.get(id)!} locale={locale} />
            ))}
          </div>
          {family.practiceTrack && (
            <aside class="practice-track">
              <div>
                <p class="callout__label">
                  {bn
                    ? "আলাদা practice track · job title নয়"
                    : "Separate practice track · not a job title"}
                </p>
                <h3>{t(family.practiceTrack.title, locale)}</h3>
                <p>{t(family.practiceTrack.description, locale)}</p>
              </div>
              <a
                class="button button--secondary"
                href={withBase(localePath(locale, family.practiceTrack.path))}
              >
                {bn ? "ACM / ICPC guide দেখো" : "Open the ACM / ICPC guide"}
              </a>
            </aside>
          )}
        </div>
      </section>
    ))
  }
  <section class="section">
    <div class="container callout callout--warm">
      <p class="callout__label">
        {bn ? "Try this instead" : "Try this instead"}
      </p><h2>
        {
          bn
            ? "দুটির মধ্যে stuck? দুটোই ছোট করে try করো।"
            : "Stuck between two paths? Try both in miniature."
        }
      </h2><p>
        {
          bn
            ? "Comparison তোমাকে language দেবে। Experiment evidence দেবে। কোনো quiz তোমাকে final identity দেবে না।"
            : "Comparison gives you language. Experiments give you evidence. No quiz gives you a final identity."
        }
      </p>
      <div class="button-row">
        <a
          class="button"
          href={withBase(localePath(locale, "/compare/"))}
          data-track-event="next_step_clicked"
          data-track-param-destination="compare"
        >
          {bn ? "দুটি career compare করি" : "Compare two careers"}
        </a>
        <a
          class="button button--secondary"
          href={withBase(localePath(locale, "/try/"))}
          data-track-event="next_step_clicked"
          data-track-param-destination="experiments"
        >
          {bn ? "ছোট experiment বেছে নিই" : "Choose a small experiment"}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .practice-track {
    display: grid;
    gap: 1rem;
    align-items: center;
    margin-top: 1rem;
    padding: 1.25rem;
    border: 1px dashed var(--color-border-strong);
    border-radius: var(--radius-md);
    background: var(--color-surface-raised);
  }
  .practice-track h3 {
    margin: 0.2rem 0 0.35rem;
  }
  .practice-track p:last-child {
    margin: 0;
    color: var(--color-text-muted);
  }
  .practice-track .button {
    justify-self: start;
  }
  .callout .button-row {
    margin-top: 1.25rem;
  }
  @media (min-width: 48rem) {
    .practice-track {
      grid-template-columns: minmax(0, 1fr) auto;
    }
  }
</style>
