---
import { withBase } from "@/config/site";
import BaseLayout from "@/layouts/BaseLayout.astro";
---

<BaseLayout
  locale="en"
  title="Direction not found"
  description="The requested route could not be found. Return to CSE Compass for a useful next step."
  noindex
  headerPathname="/"
>
  <section class="page-hero container">
    <p class="eyebrow">404 · Direction not found</p><h1>
      This path does not exist.
    </h1><p class="lede">
      The link may be old or mistyped. Nothing is wrong with your career
      plan—this route is simply missing.
    </p><div class="button-row">
      <a class="button" href={withBase("/")}>Return home</a><a
        class="button button--secondary"
        href={withBase("/im-lost/")}>I’m Lost</a
      >
    </div>
  </section>
</BaseLayout>
