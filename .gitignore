# Keep Yarn Berry/Corepack project files when intentionally committed.
# Do NOT ignore:
# .yarn/releases/
# .yarn/plugins/
# .yarn/patches/
# .yarn/versions/
# yarn.lock
# .yarnrc.yml

# npm artifacts are forbidden in this Yarn-only project
package-lock.json
npm-shrinkwrap.json
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-lock.yaml

# Environment files
.env
.env.*
!.env.example

# Local analytics/config overrides
*.local

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Editor / IDE
.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
*.swp
*.swo
*~

# Logs
logs/
*.log

# TypeScript
*.tsbuildinfo

# Misc generated files
*.tgz

# Local static-server artifacts
.vercel/
.netlify/

# Optional local screenshots / visual regression output
screenshots/
visual-results/

# Temporary downloaded/extracted content
downloads/
scratch/

# Never commit secrets or private keys
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer

# Local GitHub Pages/Jekyll artifacts if created during debugging
_site/
.sass-cache/
.jekyll-cache/
.jekyll-metadata
