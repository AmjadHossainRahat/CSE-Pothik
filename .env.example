# Optional public GA4 measurement ID (for example G-XXXXXXXXXX).
# Leave unset to disable analytics locally and in tests.
PUBLIC_GA_MEASUREMENT_ID=

# Optional production-origin override for canonical URLs and sitemap generation.
SITE_URL=https://cse-pothik.com

# Production uses the custom-domain root. Use /repository-name only for
# explicit GitHub project-path compatibility testing.
BASE_PATH=/
